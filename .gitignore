# Runtime textures stay local except for explicitly committed source assets.
assets/textures/*
!assets/textures/citrus_orchard_puresky_4k.hdr
!assets/textures/citrus_orchard_puresky_4k.hdr.license.md
!assets/textures/bistro_indoor_probe_*.png
!assets/textures/UbuntuMono21px_0.png
!assets/textures/UbuntuMono21px_0.png.vkt
!assets/textures/editor-light-labels.png
!assets/textures/editor-light-labels.png.vkt
assets/models/*
!assets/models/*.vkr.json
assets/meters
assets/fonts/*.vkfa
!assets/fonts/UbuntuMono-cooked.vkfa
!assets/fonts/UbuntuMono-Bold-cooked.vkfa
assets/materials
assets/scenes/*
!assets/scenes/bistro.scene.json
!assets/scenes/fixtures/
!assets/scenes/fixtures/*.scene.json

*.o
*.out
*.a
*.so
*.dylib
*.lib
*.exp
.vs
assets/*.spv
.cursor

# Claude keeps only the shared skill links under version control. Other local
# Claude state remains machine-specific.
/.claude/*
!/.claude/skills/
!/.claude/skills/*

# Skills are committed shared context: Claude reads the links under
# .claude/skills/ and Codex reads the same sources here. Everything else under
# .codex/ stays local except committed project agent context.
/.codex/*
!/.codex/config.toml
!/.codex/agents/
!/.codex/agents/**
!/.codex/skills/
!/.codex/skills/**
.codex/skills/*/ledger.tsv

# Task notes are local working state, not shared context. Durable findings
# belong in docs/.
/.scratch/

# Per-project editor workspace layout.
.vkr-editor-layout.json

# Local player graphics preferences and Python bytecode.
.vkr-graphics-settings.json
.vkr-graphics-settings.json.*.tmp
__pycache__/
*.pyc
