# Claude keeps only the shared skill links under version control. Other local
# Claude state remains machine-specific.
/.claude/*
!/.claude/skills/
!/.claude/skills/*

# Skills are committed shared context: Claude reads the links under
# .claude/skills/ and Codex reads the same sources here. Everything else under
# .codex/ stays local.
/.codex/*
!/.codex/skills/
!/.codex/skills/**
.codex/skills/*/ledger.tsv
