VkrVulkanVertexOutput packet_vertex_impl(uint vertex_id, uint instance_id,
                                            float4x4 view_projection)
{
    VkrVulkanPacketDrawRoot* draw = g_push.root;
    VkrVulkanPacketFrameRoot* frame = draw.frame;
    VkrGpuVisibleDrawRow visible = draw.visible_rows[draw.visible_row_index];
    VkrGpuGeometryRow geometry = draw.geometry_rows[visible.geometry_index];
    VkrPackedStaticVertex* vertices =
        (VkrPackedStaticVertex*)geometry.vertex_address;
    VkrGpuGeometryDecodeRecord* decode =
        (VkrGpuGeometryDecodeRecord*)geometry.decode_address;
    VkrGpuDecodedVertex vertex = vkr_decode_packed_vertex(
        vertices[geometry.first_vertex + vertex_id], decode[0]);
    VkrVulkanInstance instance =
        frame.instances[visible.instance_index + instance_id];
    float4 world = mul(instance.model, float4(vertex.position, 1.0f));
    VkrVulkanVertexOutput output;
    output.position = mul(view_projection, world);
    output.uv = vertex.texcoord;
    output.color = vertex.color;
    output.world_position = world.xyz;
    output.world_normal = normalize(mul(instance.model,
                                        float4(vertex.normal, 0.0f)).xyz);
    output.world_tangent = float4(
        normalize(mul(instance.model, float4(vertex.tangent.xyz, 0.0f)).xyz),
        vertex.tangent.w);
    output.object_id = instance.object_id;
    return output;
}
