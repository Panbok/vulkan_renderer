struct VkrVulkanVertex
{
    float3 position;
    float3 normal;
    float2 texcoord;
    float4 color;
    float4 tangent;
};

struct VkrVulkanInstance
{
  float4x4 model;
  uint object_id;
    uint temporal_index;
    uint temporal_generation;
    uint temporal_flags;
};

struct VkrTemporalTransform
{
  float4x4 model;
  uint generation;
  uint frame_index;
  uint valid;
  uint reserved;
};

static const uint VKR_INSTANCE_TEMPORAL_OWNER = 1u;
static const uint VKR_TEMPORAL_TRANSFORM_CAPACITY = 32768u;

struct VkrVulkanMaterial
{
    float4 tint;
    uint base_color_texture;
    uint normal_texture;
    uint orm_texture;
    uint emissive_texture;
    uint base_color_sampler;
    uint normal_sampler;
    uint orm_sampler;
    uint emissive_sampler;
    uint material_id;
    uint flags;
    uint alpha_mode;
    float temporal_reactivity;
    float4 material_emissive;
    float4 material_dielectric_specular;
    float4 material_surface;
    float4 material_alpha;
    float4 material_attenuation_color;
};

struct VkrVulkanShadowCascade
{
    float4x4 light_view_projection;
    float4 split_near_far_texel_depth;
    float4 origin_inv_size_pad;
};

struct VkrVulkanIblProbe
{
    uint irradiance_texture;
    uint irradiance_sampler;
    uint prefilter_texture;
    uint prefilter_sampler;
    float4 center_blend;
    float4 extents_weight;
    float4 intensity_box;
};
struct VkrVulkanPacketTemporalDrawState
{
    VkrTemporalTransform* previous_transforms;
    uint2 previous_transform_address_padding;
    float4x4 current_view_projection;
    float4x4 previous_view_projection;
    uint history_valid;
    uint previous_frame_index;
    uint2 reserved;
};


struct VkrVulkanPacketFrameRoot
{
    VkrVulkanInstance* instances;
    uint2 instance_address_padding;
    float4x4 view_projection;
    VkrVulkanMaterial* materials;
    uint irradiance_texture;
    uint irradiance_sampler;
    uint prefilter_texture;
    uint prefilter_sampler;
    // Retired; the environment BRDF is analytic. Explicit padding.
    uint reserved_brdf_texture;
    uint reserved_brdf_sampler;
    uint shadow_texture;
    uint shadow_sampler;
    uint transmission_texture;
    uint transmission_sampler;
    float4 view_position;
    uint prefilter_mip_count;
    uint flags;
    uint2 reserved_0;
    float4 ibl_controls;
    float4 directional_direction_enabled;
    float4 directional_color_intensity;
    float4 ambient_color;
    uint render_mode;
    uint shadow_debug_mode;
    uint2 reserved_1;
    float4* point_light_data;
    uint4* point_light_masks;
    float4 point_light_grid_origin_cell_size;
    uint4 point_light_grid_dimensions_count;
    uint4 point_light_global_mask;
    uint point_light_count;
    uint3 point_light_reserved;
    VkrVulkanShadowCascade* shadow_cascades;
    uint2 shadow_address_padding;
    float4x4 view;
    uint shadow_cascade_count;
    // Receiver quality. Scalar to match the host layout; a float4 here would be
    // 16-byte aligned and move every following field.
    uint shadow_pcf_sample_count;
    float shadow_receiver_bias_texels;
    float shadow_slope_bias_texels;
    float shadow_normal_offset_texels;
    float shadow_pcf_radius_texels;
    float shadow_cascade_blend_fraction;
    float shadow_fade_start;
    float shadow_fade_end;
    uint shadow_comparison_sampler;
    uint shadow_pcf_uniform_early_out;
    VkrVulkanIblProbe* ibl_probes;
    uint ibl_probe_count;
    uint ibl_probe_reserved;
    VkrVulkanPacketTemporalDrawState* temporal_draw_state;
};

#include "../../../shared/gpu_draw.slangh"

struct VkrVulkanPacketDrawRoot
{
    VkrGpuGeometryRow* geometry_rows;
    VkrGpuVisibleDrawRow* visible_rows;
    VkrPackedStaticVertex* vertices;
    VkrVulkanPacketFrameRoot* frame;
    uint visible_row_index;
    uint flags;
    uint2 reserved;
};

struct VkrVulkanPacketUtilityRoot
{
    VkrVulkanVertex* vertices;
    VkrVulkanInstance* instances;
    float4x4 view_projection;
    VkrVulkanMaterial* materials;
    uint irradiance_texture;
    uint irradiance_sampler;
    uint prefilter_texture;
    uint prefilter_sampler;
    uint reserved_brdf_texture;
    uint reserved_brdf_sampler;
    uint shadow_texture;
    uint shadow_sampler;
    uint transmission_texture;
    uint transmission_sampler;
    float4 view_position;
    uint material_index;
    uint first_instance;
    uint prefilter_mip_count;
    uint flags;
    float4 material_emissive;
    float4 material_dielectric_specular;
    float4 material_surface;
    float4 material_alpha;
    float4 material_attenuation_color;
    float4 ibl_controls;
    float4 directional_direction_enabled;
    float4 directional_color_intensity;
    float4 ambient_color;
    uint render_mode;
    uint alpha_mode;
    uint material_flags;
    uint reserved_0;
    float4* point_light_data;
    uint4* point_light_masks;
    float4 point_light_grid_origin_cell_size;
    uint4 point_light_grid_dimensions_count;
    uint4 point_light_global_mask;
    uint point_light_count;
    uint3 point_light_reserved;
    VkrVulkanShadowCascade* shadow_cascades;
    uint2 shadow_address_padding;
    float4x4 view;
    uint shadow_cascade_count;
    // Receiver quality. Scalar to match the host layout; a float4 here would be
    // 16-byte aligned and move every following field.
    uint shadow_pcf_sample_count;
    float shadow_receiver_bias_texels;
    float shadow_slope_bias_texels;
    float shadow_normal_offset_texels;
    float shadow_pcf_radius_texels;
    float shadow_cascade_blend_fraction;
    float shadow_fade_start;
    float shadow_fade_end;
    uint shadow_comparison_sampler;
    VkrVulkanIblProbe* ibl_probes;
    uint ibl_probe_count;
    uint ibl_probe_reserved;
    // Always valid. Manual frames bind a frame-upload fallback record and
    // automatic frames bind the graph resolve output.
    VkrExposureState* exposure_state;
};

struct VkrVulkanPushConstants
{
    VkrVulkanPacketDrawRoot* root;
    uint material_index;
    uint flags;
};

struct VkrVulkanIblRoot
{
    uint source_texture;
    uint source_sampler;
    uint target_texture;
    uint target_size;
    uint sample_count;
    uint source_face_size;
    uint source_mip_count;
    float roughness;
};

struct VkrVulkanVertexOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
    float3 world_position : TEXCOORD1;
    float3 world_normal : TEXCOORD2;
    nointerpolation uint object_id : TEXCOORD3;
    float4 world_tangent : TEXCOORD4;
};

struct VkrVulkanTemporalVertexOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
    float3 world_position : TEXCOORD1;
    float3 world_normal : TEXCOORD2;
    nointerpolation uint object_id : TEXCOORD3;
    float4 world_tangent : TEXCOORD4;
    float3 object_position : TEXCOORD5;
    nointerpolation uint temporal_index : TEXCOORD6;
    nointerpolation uint temporal_generation : TEXCOORD7;
    nointerpolation uint temporal_flags : TEXCOORD8;
};

struct VkrVulkanTextVertex
{
    float2 position;
    float2 texcoord;
    float4 color;
};

struct VkrVulkanTextOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
    nointerpolation uint object_id : TEXCOORD1;
};

[[vk::binding(0, 0)]] Texture2D<float4> g_textures[];
[[vk::binding(0, 0)]] Texture2D<float> g_depth_textures[];
[[vk::binding(0, 0)]] Texture2D<uint2> g_uint2_textures[];
[[vk::binding(0, 0)]] TextureCube<float4> g_cube_textures[];
[[vk::binding(0, 0)]] Texture2DArray<float4> g_array_textures[];
// Scalar-typed alias of the same sampled-image heap. SampleCmpLevelZero is only
// defined on a single-channel texture, and the shadow array is D32.
[[vk::binding(0, 0)]] Texture2DArray<float> g_depth_array_textures[];
[[vk::binding(0, 1)]] SamplerState g_samplers[];
// Aliases the same sampler heap by type, exactly as the texture arrays alias
// binding (0, 0). A comparison sampler is still a VkSampler descriptor; only
// the shader-side interpretation differs.
[[vk::binding(0, 1)]] SamplerComparisonState g_comparison_samplers[];
[[vk::binding(1, 0)]] RWTexture2D<float4> g_storage_2d[];
[[vk::binding(1, 0)]] RWTexture2D<float2> g_storage_float2_2d[];
[[vk::binding(1, 0)]] RWTexture2D<uint> g_storage_uint_2d[];
[[vk::binding(1, 0)]] RWTexture2D<uint2> g_storage_uint2_2d[];
[[vk::binding(1, 0)]] RWTexture2DArray<float4> g_storage_images[];
[[vk::binding(1, 0)]] RWTexture2DArray<uint2> g_storage_uint2_images[];
[[vk::push_constant]] ConstantBuffer<VkrVulkanPushConstants> g_push;

static const float vkr_pi = 3.14159265359f;
