#include <metal_stdlib>
using namespace metal;

struct VkrMetalPacketVertex {
  float position_x;
  float position_y;
  float position_z;
  float normal_x;
  float normal_y;
  float normal_z;
  float2 texcoord;
  float4 color;
  float4 tangent;
};

struct VkrMetalPacketInstance {
  float4x4 model;
  uint object_id;
  uint temporal_index;
  uint temporal_generation;
  uint temporal_flags;
};

struct VkrTemporalTransform {
  float4x4 model;
  uint generation;
  uint frame_index;
  uint valid;
  uint reserved;
};

constant uint VKR_INSTANCE_TEMPORAL_OWNER = 1u;
constant uint VKR_TEMPORAL_TRANSFORM_CAPACITY = 32768u;

struct VkrMetalPacketMaterial {
  float4 tint;
  texture2d<float, access::sample> base_color_texture;
  texture2d<float, access::sample> normal_texture;
  texture2d<float, access::sample> orm_texture;
  texture2d<float, access::sample> emissive_texture;
  sampler base_color_sampler;
  sampler normal_sampler;
  sampler orm_sampler;
  sampler emissive_sampler;
  uint material_id;
  uint flags;
  uint alpha_mode;
  uint reserved;
  float4 material_emissive;
  float4 material_dielectric_specular;
  float4 material_surface;
  float4 material_alpha;
  float4 material_attenuation_color;
};

struct VkrMetalPacketIblProbe {
  texturecube<float, access::sample> irradiance;
  texturecube<float, access::sample> prefilter;
  float4 center_blend;
  float4 extents_weight;
  float4 intensity_box;
};

struct VkrMetalPacketFrameRoot {
  device VkrMetalPacketInstance *instances;
  uint2 instance_address_padding;
  float4x4 view_projection;
  device VkrMetalPacketMaterial *materials;
  texturecube<float, access::sample> irradiance;
  texturecube<float, access::sample> prefilter;
  // Retired: the environment BRDF is analytic on both backends. Kept as
  // explicit padding so every downstream offset is unchanged.
  ulong reserved_brdf_lut;
  float4 view_position;
  uint prefilter_mip_count;
  uint flags;
  uint reserved_0;
  uint reserved_1;
  float4 ibl_controls;
  float4 directional_direction_enabled;
  float4 directional_color_intensity;
  float4 ambient_color;
  uint render_mode;
  uint shadow_debug_mode;
  uint reserved_2;
  uint reserved_3;
  device float4 *point_light_data;
  device uint4 *point_light_masks;
  float4 point_light_grid_origin_cell_size;
  uint4 point_light_grid_dimensions_count;
  uint4 point_light_global_mask;
  uint point_light_count;
  uint point_light_reserved_0;
  uint point_light_reserved_1;
  uint point_light_reserved_2;
  // depth2d_array, not texture2d_array: sample_compare is only available on a
  // depth texture, and the underlying MTLTexture is already D32Float.
  depth2d_array<float, access::sample> shadow_map;
  device struct VkrMetalPacketShadowCascade *shadow_cascades;
  float4x4 view;
  uint shadow_cascade_count;
  // Receiver quality. See VkrShadowReceiverPacketData for units; every bias is
  // in shadow-map texels and is converted through the owning cascade's own
  // texel size and depth span.
  uint shadow_pcf_sample_count;
  float shadow_receiver_bias_texels;
  float shadow_slope_bias_texels;
  float shadow_normal_offset_texels;
  float shadow_pcf_radius_texels;
  float shadow_cascade_blend_fraction;
  float shadow_fade_start;
  float shadow_fade_end;
  uint shadow_pcf_uniform_early_out;
  texture2d<float, access::sample> transmission_source;
  device VkrMetalPacketIblProbe *ibl_probes;
  uint ibl_probe_count;
  uint ibl_probe_reserved;
};

struct VkrGpuGeometryRow {
  ulong vertex_address;
  ulong index_address;
  uint first_vertex;
  uint first_index;
  uint vertex_stride;
  uint vertex_layout;
  uint publication_generation;
  uint flags;
  ulong decode_address;
};

struct VkrPackedStaticVertex {
  uint words[8];
};

struct VkrGpuGeometryDecodeRecord {
  packed_float3 position_bias;
  uint flags;
  packed_float3 position_scale;
  uint reserved;
};

struct VkrGpuDecodedVertex {
  float3 position;
  float3 normal;
  float2 texcoord;
  float4 color;
  float4 tangent;
};

inline float vkr_packed_snorm16(uint value) {
  return clamp(float(as_type<short>(ushort(value))) / 32767.0f, -1.0f, 1.0f);
}

inline float3 vkr_packed_oct_decode(uint value) {
  float2 oct(vkr_packed_snorm16(value), vkr_packed_snorm16(value >> 16u));
  float3 result(oct, 1.0f - abs(oct.x) - abs(oct.y));
  float fold = clamp(-result.z, 0.0f, 1.0f);
  result.x += select(fold, -fold, result.x >= 0.0f);
  result.y += select(fold, -fold, result.y >= 0.0f);
  return normalize(result);
}

inline VkrGpuDecodedVertex vkr_decode_packed_vertex(
    VkrPackedStaticVertex packed,
    device const VkrGpuGeometryDecodeRecord &decode) {
  float3 position_unorm(float(packed.words[0] & 0xffffu) / 65535.0f,
                        float(packed.words[0] >> 16u) / 65535.0f,
                        float(packed.words[1] & 0xffffu) / 65535.0f);
  uint tangent_flags = packed.words[1] >> 16u;
  uint color = packed.words[6];
  VkrGpuDecodedVertex result;
  result.position = float3(decode.position_bias) +
                    position_unorm * float3(decode.position_scale);
  result.normal = vkr_packed_oct_decode(packed.words[2]);
  result.tangent =
      float4(vkr_packed_oct_decode(packed.words[3]),
             (tangent_flags & 1u) != 0u ? -1.0f : 1.0f);
  result.texcoord =
      float2(as_type<float>(packed.words[4]),
             as_type<float>(packed.words[5]));
  result.color = float4(float(color & 0xffu), float((color >> 8u) & 0xffu),
                        float((color >> 16u) & 0xffu), float(color >> 24u)) /
                 255.0f;
  return result;
}

struct VkrGpuCandidateDrawRow {
  uint geometry_index;
  uint material_index;
  uint instance_index;
  uint first_index;
  uint index_count;
  int vertex_offset;
  uint state_bucket;
  uint flags;
  float4 local_bounding_sphere;
};

struct VkrGpuVisibleDrawRow {
  uint geometry_index;
  uint material_index;
  uint instance_index;
  uint first_index;
  uint index_count;
  int vertex_offset;
  uint state_bucket;
  uint flags;
};

struct VkrMetalPacketDrawRoot {
  device VkrGpuGeometryRow *geometry_rows;
  device VkrGpuVisibleDrawRow *visible_rows;
  device VkrPackedStaticVertex *vertices;
  constant VkrMetalPacketFrameRoot *frame;
  uint visible_row_index;
  uint flags;
  uint reserved_0;
  uint reserved_1;
};

struct VkrMetalPacketShadowCascade {
  float4x4 light_view_projection;
  float4 split_near_far_texel_depth;
  float4 origin_inv_size_pad;
};

struct VkrMetalPacketVertexOutput {
  float4 position [[position]];
  float2 texcoord [[user(TEXCOORD)]];
  float4 color [[user(COLOR)]];
  uint object_id [[user(TEXCOORD_1), flat]];
  float3 world_position [[user(TEXCOORD_2)]];
  float3 world_normal [[user(TEXCOORD_3)]];
  float4 world_tangent [[user(TEXCOORD_4)]];
  uint visible_row_index [[user(TEXCOORD_5), flat]];
};

static_assert(sizeof(VkrMetalPacketVertex) == 64,
              "VkrVertex3d Metal ABI must remain 64 bytes");
static_assert(sizeof(VkrPackedStaticVertex) == 32,
              "Packed static vertex ABI must remain 32 bytes");
static_assert(sizeof(VkrGpuGeometryDecodeRecord) == 32,
              "Geometry decode record ABI must remain 32 bytes");
static_assert(sizeof(VkrMetalPacketInstance) == 80,
              "VkrInstanceDataGPU Metal ABI must remain 80 bytes");
static_assert(sizeof(VkrMetalPacketMaterial) == 176,
              "Metal material row ABI must remain 176 bytes");
static_assert(sizeof(VkrMetalPacketFrameRoot) == 448,
              "Metal packet frame root ABI must remain 448 bytes");
static_assert(sizeof(VkrMetalPacketDrawRoot) == 48,
              "Metal packet draw root ABI must remain 48 bytes");
static_assert(sizeof(VkrMetalPacketIblProbe) == 64,
              "Metal packet IBL probe ABI must remain 64 bytes");
static_assert(sizeof(VkrMetalPacketShadowCascade) == 96,
              "Metal packet shadow cascade ABI must remain 96 bytes");
