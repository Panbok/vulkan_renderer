constant float vkr_metal_packet_pi = 3.14159265359;

float vkr_metal_packet_radical_inverse(uint bits) {
  bits = (bits << 16u) | (bits >> 16u);
  bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
  bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
  bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
  bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
  return float(bits) * 2.3283064365386963e-10;
}

float2 vkr_metal_packet_hammersley(uint index, uint count) {
  return float2(float(index) / float(count),
                vkr_metal_packet_radical_inverse(index));
}

float3 vkr_metal_packet_cube_direction(uint face, float2 uv) {
  float2 st = uv * 2.0 - 1.0;
  switch (face) {
  case 0:
    return float3(1.0, -st.y, -st.x);
  case 1:
    return float3(-1.0, -st.y, st.x);
  case 2:
    return float3(st.x, 1.0, st.y);
  case 3:
    return float3(st.x, -1.0, -st.y);
  case 4:
    return float3(st.x, -st.y, 1.0);
  default:
    return float3(-st.x, -st.y, -1.0);
  }
}


float3 vkr_metal_packet_tangent_sample(float3 normal, float3 sample_value) {
  float3 up =
      abs(normal.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
  float3 tangent = normalize(cross(up, normal));
  return normalize(tangent * sample_value.x +
                   cross(normal, tangent) * sample_value.y +
                   normal * sample_value.z);
}

float3 vkr_metal_packet_importance_ggx(float2 xi, float3 normal,
                                       float roughness) {
  float alpha = roughness * roughness;
  float phi = 2.0 * vkr_metal_packet_pi * xi.x;
  float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
  float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
  return vkr_metal_packet_tangent_sample(
      normal, float3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta));
}
