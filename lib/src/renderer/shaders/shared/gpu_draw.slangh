struct VkrGpuGeometryRow
{
    uint64_t vertex_address;
    uint64_t index_address;
    uint first_vertex;
    uint first_index;
    uint vertex_stride;
    uint vertex_layout;
    uint publication_generation;
    uint flags;
    uint2 reserved;
};

struct VkrGpuCandidateDrawRow
{
    uint geometry_index;
    uint material_index;
    uint instance_index;
    uint first_index;
    uint index_count;
    int vertex_offset;
    uint state_bucket;
    uint flags;
    float4 local_bounding_sphere;
};

struct VkrGpuVisibleDrawRow
{
    uint geometry_index;
    uint material_index;
    uint instance_index;
    uint first_index;
    uint index_count;
    int vertex_offset;
    uint state_bucket;
    uint flags;
};
