struct VkrMetalPacketVertex
{
    float position_x;
    float position_y;
    float position_z;
    float normal_x;
    float normal_y;
    float normal_z;
    float2 texcoord;
    float4 color;
    float4 tangent;
};

struct VkrMetalPacketInstance
{
    column_major float4x4 model;
    uint object_id;
    uint reserved_0;
    uint reserved_1;
    uint reserved_2;
};

struct VkrMetalPacketShadowCascade
{
    column_major float4x4 light_view_projection;
    float4 split_depth;
};

struct VkrMetalPacketIblProbe
{
    TextureCube<float4> irradiance;
    TextureCube<float4> prefilter;
    float4 center_blend;
    float4 extents_weight;
    float4 intensity_box;
};

struct VkrMetalPacketFrameRoot
{
    StructuredBuffer<VkrMetalPacketInstance> instances;
    uint2 instance_address_padding;
    column_major float4x4 view_projection;
    uint64_t materials;
    TextureCube<float4> irradiance;
    TextureCube<float4> prefilter;
    // Retired; see draw.metalh. Explicit padding, not a resource.
    uint64_t reserved_brdf_lut;
    float4 view_position;
    uint prefilter_mip_count;
    uint flags;
    uint2 reserved_0;
    float4 ibl_controls;
    float4 directional_direction_enabled;
    float4 directional_color_intensity;
    float4 ambient_color;
    uint render_mode;
    // Scalar padding matches the host/native-MSL arrays. Metal aligns uint3 to
    // 16 bytes and would move every following field.
    uint shadow_debug_mode;
    uint reserved_1_0;
    uint reserved_1_1;
    StructuredBuffer<float4> point_light_data;
    StructuredBuffer<uint4> point_light_masks;
    float4 point_light_grid_origin_cell_size;
    uint4 point_light_grid_dimensions_count;
    uint4 point_light_global_mask;
    uint point_light_count;
    uint point_light_reserved_0;
    uint point_light_reserved_1;
    uint point_light_reserved_2;
    Texture2DArray<float4> shadow_map;
    StructuredBuffer<VkrMetalPacketShadowCascade> shadow_cascades;
    column_major float4x4 view;
    uint shadow_cascade_count;
    float shadow_bias;
    uint2 shadow_reserved;
    Texture2D<float4> transmission_source;
    StructuredBuffer<VkrMetalPacketIblProbe> ibl_probes;
    uint ibl_probe_count;
    uint ibl_probe_reserved;
};

struct VkrGpuGeometryRow
{
    uint64_t vertex_address;
    uint64_t index_address;
    uint first_vertex;
    uint first_index;
    uint vertex_stride;
    uint vertex_layout;
    uint publication_generation;
    uint flags;
    uint2 reserved;
};

struct VkrGpuCandidateDrawRow
{
    uint geometry_index;
    uint material_index;
    uint instance_index;
    uint first_index;
    uint index_count;
    int vertex_offset;
    uint state_bucket;
    uint flags;
    float4 local_bounding_sphere;
};

struct VkrGpuVisibleDrawRow
{
    uint geometry_index;
    uint material_index;
    uint instance_index;
    uint first_index;
    uint index_count;
    int vertex_offset;
    uint state_bucket;
    uint flags;
};

struct VkrMetalPacketDrawRoot
{
    StructuredBuffer<VkrGpuGeometryRow> geometry_rows;
    StructuredBuffer<VkrGpuVisibleDrawRow> visible_rows;
    StructuredBuffer<VkrMetalPacketVertex> vertices;
    ParameterBlock<VkrMetalPacketFrameRoot> frame;
    uint visible_row_index;
    uint flags;
    uint2 reserved;
};

struct VkrMetalPacketVertexOutput
{
    float4 position : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color : COLOR0;
    nointerpolation uint object_id : TEXCOORD1;
    float3 world_position : TEXCOORD2;
    float3 world_normal : TEXCOORD3;
    float4 world_tangent : TEXCOORD4;
    nointerpolation uint visible_row_index : TEXCOORD5;
};
