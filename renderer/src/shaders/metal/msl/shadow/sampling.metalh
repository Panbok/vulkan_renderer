struct VkrMetalPacketShadowSample {
  float factor;
  float map_depth;
  uint cascade;
  bool valid;
};

// Each tap already costs a hardware bilinear 2x2 comparison, so a distant
// cascade degrades into softness rather than into crawling staircase noise.
constexpr sampler vkr_metal_shadow_compare_sampler(coord::normalized,
                                                   address::clamp_to_edge,
                                                   filter::linear,
                                                   compare_func::less_equal);
// Debug readout only; the filter path never uses it. Nearest keeps the reported
// value a real stored texel rather than an interpolation of four.
constexpr sampler vkr_metal_shadow_raw_sampler(coord::normalized,
                                               address::clamp_to_edge,
                                               filter::nearest);

// Far-cascade EVSM moments are prefiltered, so receivers fetch them bilinearly.
constexpr sampler vkr_metal_shadow_moments_sampler(coord::normalized,
                                                   address::clamp_to_edge,
                                                   filter::linear);

// Far-cascade EVSM moments for the receivers that sample them; a null pointer
// keeps PCF for every cascade.
struct VkrMetalShadowMoments {
  texture2d_array<float, access::sample> map;
};

constexpr sampler vkr_metal_packet_cloud_shadow_sampler(coord::normalized,
                                                        address::clamp_to_edge,
                                                        filter::linear,
                                                        mip_filter::none);

// Sun transmittance through the cloud layer above a world position (ADR-074).
// One outside the sun-projected map or when the layer does not render.
float vkr_metal_packet_cloud_shadow(constant VkrMetalPacketFrameRoot *frame,
                                    float3 world_position) {
  constant VkrMetalPacketSky *sky = frame->sky;
  if (sky == nullptr || sky->params.clouds.noise.w <= 0.0f)
    return 1.0f;
  float2 uv = vkr_cloud_shadow_uv(sky->params, world_position);
  if (any(uv < 0.0f) || any(uv > 1.0f))
    return 1.0f;
  return sky->cloud_shadow.sample(vkr_metal_packet_cloud_shadow_sampler, uv).r;
}

/**
 * Stable rotation for the Poisson kernel.
 *
 * The cell index is built in the cascade's light-space texel grid, not in
 * screen space, so it does not swim when the camera moves: the fit snaps in
 * whole texels and `light_space_origin` cancels the remaining translation. A
 * screen-space or world-position hash would reintroduce the crawling the
 * rotation exists to hide.
 */
static float2 vkr_metal_shadow_kernel_rotation(float2 uv, float2 origin_texels,
                                               float map_size) {
  // `origin - uv * map_size`, not the sum. The fit anchor appears in both terms
  // with the same sign, so subtracting cancels it and leaves the world point's
  // own light-basis projection in texels. Adding would double it, and the cell
  // would jump every time the cascade re-anchors -- the exact swimming this
  // rotation exists to prevent.
  int2 cell = int2(floor(origin_texels - uv * map_size));
  uint hash = (uint(cell.x) * 73856093u) ^ (uint(cell.y) * 19349663u);
  float angle = float(hash & 1023u) * (6.28318530718 / 1024.0);
  return float2(cos(angle), sin(angle));
}

/**
 * Accumulates `count` rotated taps and returns the mean visibility.
 *
 * Taps read a prefix of the shared progressive table, so the caller's tap count
 * is the only thing that changes between kernel sizes.
 */
static float
vkr_metal_shadow_kernel(depth2d_array<float, access::sample> shadow_map,
                        uint cascade, float2 uv, float reference,
                        float2 rotation, float2 tap_scale, uint first,
                        uint count) {
  float sum = 0.0;
  for (uint i = first; i < count; ++i) {
    float2 tap = vkr_shadow_poisson[i];
    float2 rotated = float2(tap.x * rotation.x - tap.y * rotation.y,
                            tap.x * rotation.y + tap.y * rotation.x);
    sum +=
        shadow_map.sample_compare(vkr_metal_shadow_compare_sampler,
                                  uv + rotated * tap_scale, cascade, reference);
  }
  return sum;
}

struct VkrMetalPcssBlockers {
  float average_depth;
  uint count;
};

static VkrMetalPcssBlockers vkr_metal_shadow_pcss_blockers(
    depth2d_array<float, access::sample> shadow_map, uint cascade, float2 uv,
    float reference, float2 rotation, float2 search_tap_scale) {
  VkrMetalPcssBlockers result = {0.0, 0u};
  for (uint i = 0u; i < VKR_SHADOW_PCSS_BLOCKER_COUNT; ++i) {
    float2 tap = vkr_shadow_poisson[i];
    float2 rotated = float2(tap.x * rotation.x - tap.y * rotation.y,
                            tap.x * rotation.y + tap.y * rotation.x);
    float blocker_depth = shadow_map.sample(vkr_metal_shadow_raw_sampler,
                                            uv + rotated * search_tap_scale,
                                            cascade);
    if (blocker_depth < reference) {
      result.average_depth += blocker_depth;
      ++result.count;
    }
  }
  if (result.count != 0u)
    result.average_depth /= float(result.count);
  return result;
}

/** One cascade's visibility. `valid` is false when the receiver misses it. */
static VkrMetalPacketShadowSample vkr_metal_packet_shadow_cascade_sample(
    constant VkrMetalPacketFrameRoot *root, uint cascade, float3 world_position,
    float3 normal, float n_dot_l,
    const thread VkrMetalShadowMoments *moments = nullptr) {
  device const VkrMetalPacketShadowCascade &data =
      root->shadow_cascades[cascade];
  float texel = data.split_near_far_texel_depth.z;
  float depth_span = data.split_near_far_texel_depth.w;

  // Normal offset is a world-space push along the surface normal applied before
  // projection, so it moves the sample off the surface instead of biasing the
  // comparison. It costs nothing at grazing angles where depth bias is weakest.
  float3 offset_position =
      world_position + normal * (root->shadow_normal_offset_texels * texel);
  float4 clip = data.light_view_projection * float4(offset_position, 1.0);
  if (abs(clip.w) <= 1e-6)
    return {1.0, 1.0, cascade, false};
  float3 projected = clip.xyz / clip.w;
  float2 uv = projected.xy * 0.5 + 0.5;
  if (any(uv < 0.0) || any(uv > 1.0) || projected.z < 0.0 || projected.z > 1.0)
    return {1.0, 1.0, cascade, false};

  // Both biases are configured in texels and converted through *this* cascade's
  // own footprint and fitted depth span. That is what makes one configured
  // value mean the same world distance in cascade 0 and cascade 3, whose depth
  // ranges differ by orders of magnitude.
  float slope = saturate(1.0 - n_dot_l);
  float bias_texels = root->shadow_receiver_bias_texels +
                      root->shadow_slope_bias_texels * slope;
  float reference = projected.z - bias_texels * texel / depth_span;

  // Filtered far cascades take one bilinear moments fetch instead of PCF.
  if (moments && cascade >= VKR_SHADOW_EVSM_FIRST_CASCADE) {
    float4 filtered = moments->map.sample(
        vkr_metal_shadow_moments_sampler, uv,
        cascade - VKR_SHADOW_EVSM_FIRST_CASCADE);
    return {vkr_shadow_evsm_visibility(filtered, reference), 1.0, cascade,
            true};
  }

  float inv_size = data.origin_inv_size_sun.z;
  float map_size = 1.0 / inv_size;
  float2 rotation = vkr_metal_shadow_kernel_rotation(
      uv, data.origin_inv_size_sun.xy / texel, map_size);
  float2 tap_scale = root->shadow_pcf_radius_texels * inv_size;
  uint count = root->shadow_pcf_sample_count;

  float sun_tan_half_angle = data.origin_inv_size_sun.w;
  if (vkr_shadow_pcss_enabled(cascade, sun_tan_half_angle) != 0u) {
    // The near PCSS budget includes its no-blocker fallback. Preserve the PCF
    // radius and prefix order there, while bounding a configured 32-tap PCF.
    count = min(count, VKR_SHADOW_PCSS_FILTER_MAX_COUNT);
    float search_radius = vkr_shadow_pcss_search_radius_texels(
        reference, depth_span, sun_tan_half_angle, texel,
        root->shadow_pcf_radius_texels);
    VkrMetalPcssBlockers blockers = vkr_metal_shadow_pcss_blockers(
        root->shadow_map, cascade, uv, reference, rotation,
        search_radius * inv_size);
    // Sparse blockers do not prove an unoccluded receiver. With none, retain
    // the configured PCF radius; otherwise widen the bounded PCSS filter.
    if (blockers.count != 0u) {
      float filter_radius = vkr_shadow_pcss_filter_radius_texels(
          reference, blockers.average_depth, depth_span, sun_tan_half_angle,
          texel, root->shadow_pcf_radius_texels);
      tap_scale = filter_radius * inv_size;
    }
  }

  float factor;
  if (count >= 16u && root->shadow_pcf_uniform_early_out != 0u) {
    // Fully lit and fully shadowed regions are the common case and resolve in
    // nine taps. Only the penumbra pays for the full kernel.
    float probe = vkr_metal_shadow_kernel(
        root->shadow_map, cascade, uv, reference, rotation, tap_scale, 0u, 9u);
    if (probe <= 0.0 || probe >= 9.0) {
      factor = probe * (1.0 / 9.0);
    } else {
      factor = (probe + vkr_metal_shadow_kernel(root->shadow_map, cascade, uv,
                                                reference, rotation, tap_scale,
                                                9u, count)) /
               float(count);
    }
  } else {
    factor = vkr_metal_shadow_kernel(root->shadow_map, cascade, uv, reference,
                                     rotation, tap_scale, 0u, count) /
             float(count);
  }

  // Only the raw-map debug view consumes stored depth. This uniform branch
  // avoids an otherwise unused texture read in normal shading and in the other
  // debug modes.
  float map_depth =
      root->shadow_debug_mode == 3u
          ? root->shadow_map.sample(vkr_metal_shadow_raw_sampler, uv, cascade)
          : 1.0;
  return {factor, map_depth, cascade, true};
}

VkrMetalPacketShadowSample vkr_metal_packet_directional_shadow_sample(
    constant VkrMetalPacketFrameRoot *root, float3 world_position,
    float3 normal, const thread VkrMetalShadowMoments *moments = nullptr) {
  if (root->shadow_cascade_count == 0u || root->shadow_cascades == nullptr)
    return {1.0, 1.0, 0u, false};
  float view_depth = abs((root->view * float4(world_position, 1.0)).z);

  // Fade to unshadowed before the last split so the shadowed range ends in a
  // gradient rather than on a hard terminating edge.
  float fade_span = root->shadow_fade_end - root->shadow_fade_start;
  float fade = fade_span > 0.0
                   ? saturate((root->shadow_fade_end - view_depth) / fade_span)
                   : 1.0;
  if (fade <= 0.0)
    return {1.0, 1.0, root->shadow_cascade_count - 1u, false};

  uint cascade = 0u;
  for (uint i = 0u; i + 1u < root->shadow_cascade_count; ++i) {
    if (view_depth > root->shadow_cascades[i].split_near_far_texel_depth.y)
      cascade = i + 1u;
  }

  float3 light = normalize(-root->directional_direction_enabled.xyz);
  float n_dot_l = dot(normal, light);
  VkrMetalPacketShadowSample sample = vkr_metal_packet_shadow_cascade_sample(
      root, cascade, world_position, normal, n_dot_l, moments);

  // Cross-fade over the last `blend_fraction` of this cascade's span. Outside
  // the band exactly one cascade is sampled, so the seam cost is confined to
  // the band instead of being paid everywhere.
  if (cascade + 1u < root->shadow_cascade_count) {
    float4 slice = root->shadow_cascades[cascade].split_near_far_texel_depth;
    float band = (slice.y - slice.x) * root->shadow_cascade_blend_fraction;
    if (band > 0.0 && view_depth > slice.y - band) {
      float t = saturate((view_depth - (slice.y - band)) / band);
      VkrMetalPacketShadowSample next = vkr_metal_packet_shadow_cascade_sample(
          root, cascade + 1u, world_position, normal, n_dot_l, moments);
      sample.factor = mix(sample.factor, next.factor, t);
    }
  }

  sample.factor = mix(1.0, sample.factor, fade);
  return sample;
}

// Depth and cumulative color are read from the same discrete texel. Filtering
// happens only after the receiver has selected its crossing prefix. `layer`
// is the face's transmission layer plus one; zero leaves refractive casters
// unshadowed for the face.
static float3 vkr_metal_local_shadow_transmission_tap(
    constant VkrMetalPacketLocalShadowTransmission *maps, uint layer,
    float2 uv, float receiver_depth) {
  if (!maps || layer == 0u)
    return float3(1.0f);
  uint face = layer - 1u;
  uint2 extent(maps->depth0.get_width(), maps->depth0.get_height());
  uint2 pixel = min(uint2(saturate(uv) * float2(extent)), extent - 1u);
  // Crossings are peeled in order from the light, so a receiver in front of
  // the first one has no transmission prefix.
  float depth0 = maps->depth0.read(pixel, face);
  if (receiver_depth <= depth0)
    return float3(1.0f);
  float2 depths(depth0, maps->depth1.read(pixel, face));
  uint prefix = vkr_local_shadow_transmission_prefix_index(
      receiver_depth, depths, maps->overflow.read(pixel, face));
  if (prefix == 0u)
    return float3(1.0f);
  if (prefix == 1u)
    return maps->color0.read(pixel, face).rgb;
  if (prefix == 2u)
    return maps->color1.read(pixel, face).rgb;
  return float3(0.0f);
}

// Average forward distance of the blockers a contact-hardening search finds
// around `uv`, or zero when the sparse search finds none. Point-light taps
// compare against the receiver's radial distance like the filter taps.
static float vkr_metal_local_shadow_blocker_forward(
    constant VkrMetalPacketFrameRoot *root, const device VkrLocalShadowView &view,
    bool point, float2 uv, float center_reference, float4 face_clip_terms,
    float radial_distance, float2 tap_rotation, float search_texels,
    uint blocker_count) {
  float depth_sum = 0.0;
  uint found = 0u;
  for (uint i = 0u; i < blocker_count; ++i) {
    float2 tap_uv = saturate(
        uv + vkr_local_shadow_rotate_tap(vkr_shadow_poisson[i], tap_rotation) *
                 (search_texels * view.projection_params.y));
    float reference = point ? vkr_local_shadow_in_face_depth(
                                  face_clip_terms, radial_distance, tap_uv)
                            : center_reference;
    float2 texel = vkr_local_shadow_atlas_texel(
        view.atlas_rect, view.projection_params.y, tap_uv);
    float depth =
        root->local_shadow_map.read(uint2(texel), uint(view.atlas_rect.w));
    if (depth < reference) {
      depth_sum += depth;
      ++found;
    }
  }
  if (found == 0u)
    return 0.0;
  return max(vkr_local_shadow_forward_distance(face_clip_terms,
                                               depth_sum / float(found)),
             view.light_position_near.w);
}

// The point kernel reprojects each displaced ray into its owning cube face.
// Its comparison depth follows the biased receiver's radial distance. Fully
// filtered lights take `tap_count` Poisson taps rotated by `tap_rotation`. A
// nonzero `blocker_count` widens their disk by the light's source radius from
// that many blocker-search taps (contact-hardening); an empty search keeps the
// fixed radius, since sparse taps do not prove the receiver is lit. Without
// SoftFilter every light takes the one hardware-filtered tap. Without
// Transmission the refractive layers are not read. The tiled pipeline takes
// neither: its glass casts no local shadow, and the registers of the Poisson
// filter and those reads cost its opaque pass (ADR-087).
template <bool Transmission = true, bool SoftFilter = true>
float3 vkr_metal_packet_local_shadow_sample(
    constant VkrMetalPacketFrameRoot *root, uint first_view_encoded, uint kind,
    float3 world_position, float3 normal,
    float2 tap_rotation = float2(1.0, 0.0),
    uint tap_count = VKR_LOCAL_SHADOW_FILTER_TAP_COUNT,
    uint blocker_count = 0u) {
  if (first_view_encoded == 0u)
    return float3(1.0);
  uint first_view = first_view_encoded - 1u;
  float strength = root->local_shadow_views[first_view].shadow_params.x;
  if (strength <= 0.0)
    return float3(1.0);
  bool point = kind != 2u;
  float3 light_position =
      root->local_shadow_views[first_view].light_position_near.xyz;
  float3 from_light = world_position - light_position;
  uint face = point ? vkr_local_shadow_face(from_light) : 0u;
  const device VkrLocalShadowView &source =
      root->local_shadow_views[first_view + face];
  float forward_depth = dot(from_light, source.light_direction_far.xyz);
  if (forward_depth <= source.light_position_near.w ||
      forward_depth >= source.light_direction_far.w)
    return float3(1.0);
  float footprint = 2.0 * forward_depth * source.projection_params.x *
                    source.projection_params.y;
  float3 receiver =
      world_position + normal * (source.projection_params.w * footprint) -
      normalize(from_light) * (source.projection_params.z * footprint);
  from_light = receiver - light_position;
  face = point ? vkr_local_shadow_face(from_light) : 0u;
  const device VkrLocalShadowView &view =
      root->local_shadow_views[first_view + face];
  float4 clip = view.light_view_projection * float4(receiver, 1.0);
  if (clip.w <= 0.0 || clip.z < 0.0 || clip.z > clip.w)
    return float3(1.0);
  float3 projected = clip.xyz / clip.w;
  float2 uv = projected.xy * 0.5 + 0.5;
  if (!point && (any(uv < 0.0) || any(uv > 1.0)))
    return float3(1.0);
  if (!SoftFilter ||
      root->local_shadow_views[first_view].shadow_params.z > 0.5) {
    // Lights past the most important few take one hardware-filtered tap.
    float opaque = root->local_shadow_map.sample_compare(
        vkr_metal_shadow_compare_sampler,
        vkr_local_shadow_atlas_uv(view.atlas_rect, view.projection_params.y,
                                  uv),
        uint(view.atlas_rect.w), projected.z);
    float3 transmission =
        Transmission && opaque > 0.0
            ? vkr_metal_local_shadow_transmission_tap(
                  root->local_shadow_transmission,
                  uint(view.shadow_params.y), uv, projected.z)
            : float3(1.0f);
    return vkr_local_shadow_apply_strength(opaque * transmission, strength);
  }
  float radial_distance = length(from_light);
  float4 origin_clip = view.light_view_projection * float4(light_position, 1.0);
  float4 axis_clip =
      view.light_view_projection * float4(view.light_direction_far.xyz, 0.0);
  float4 face_clip_terms =
      float4(origin_clip.z, axis_clip.z, origin_clip.w, axis_clip.w);
  float filter_radius_texels = VKR_LOCAL_SHADOW_FILTER_RADIUS_TEXELS;
  float source_radius_uv = view.shadow_params.w;
  if (blocker_count != 0u && source_radius_uv > 0.0) {
    float receiver_forward = dot(from_light, view.light_direction_far.xyz);
    float search_texels = vkr_local_shadow_pcss_search_radius_texels(
        source_radius_uv, view.light_position_near.w, receiver_forward,
        view.projection_params.y);
    float blocker_forward = vkr_metal_local_shadow_blocker_forward(
        root, view, point, uv, projected.z, face_clip_terms, radial_distance,
        tap_rotation, search_texels, blocker_count);
    if (blocker_forward > 0.0)
      filter_radius_texels = vkr_local_shadow_pcss_filter_radius_texels(
          source_radius_uv, blocker_forward, receiver_forward,
          view.projection_params.y);
  }
  float3 sum = 0.0;
  for (uint i = 0u; i < tap_count; ++i) {
    float2 tap_uv =
        uv + vkr_local_shadow_rotate_tap(vkr_shadow_poisson[i], tap_rotation) *
                 (filter_radius_texels * view.projection_params.y);
    uint tap_face = face;
    float reference = projected.z;
    if (point && all(tap_uv >= 0.0) && all(tap_uv <= 1.0)) {
      // Most taps stay in the centre face; only their depth changes.
      reference = vkr_local_shadow_in_face_depth(face_clip_terms,
                                                 radial_distance, tap_uv);
    } else if (point) {
      float3 ray = vkr_local_shadow_direction(face, tap_uv);
      tap_face = vkr_local_shadow_face(ray);
      float3 tap_position = light_position + normalize(ray) * radial_distance;
      float4 tap_clip = root->local_shadow_views[first_view + tap_face]
                            .light_view_projection *
                        float4(tap_position, 1.0);
      tap_uv = tap_clip.xy / tap_clip.w * 0.5 + 0.5;
      reference = tap_clip.z / tap_clip.w;
      if (reference < 0.0 || reference > 1.0) {
        sum += 1.0;
        continue;
      }
    } else if (any(tap_uv < 0.0) || any(tap_uv > 1.0)) {
      sum += 1.0;
      continue;
    }
    const device VkrLocalShadowView &tap_view =
        root->local_shadow_views[first_view + tap_face];
    float opaque = root->local_shadow_map.sample_compare(
        vkr_metal_shadow_compare_sampler,
        vkr_local_shadow_atlas_uv(tap_view.atlas_rect,
                                  tap_view.projection_params.y, tap_uv),
        uint(tap_view.atlas_rect.w), reference);
    // An opaque-occluded tap contributes zero whatever its transmission.
    float3 transmission =
        Transmission && opaque > 0.0
            ? vkr_metal_local_shadow_transmission_tap(
                  root->local_shadow_transmission,
                  uint(tap_view.shadow_params.y), tap_uv, reference)
            : float3(1.0f);
    sum += opaque * transmission;
  }
  return vkr_local_shadow_apply_strength(sum / float(tap_count), strength);
}
