#include "../../../shared/local_shadow.slangh"
#include "../../../shared/normal_map_kernel.slangh"
#include "../../../shared/point_light.slangh"
#include "../../../shared/fog_kernel.slangh"
#include "../../../shared/froxel_fog_kernel.slangh"

struct VkrMetalPacketVertex
{
    float position_x;
    float position_y;
    float position_z;
    float normal_x;
    float normal_y;
    float normal_z;
    float2 texcoord;
    float4 color;
    float4 tangent;
};

struct VkrMetalPacketInstance
{
  column_major float4x4 model;
  uint object_id;
    uint temporal_index;
    uint temporal_generation;
    uint temporal_flags;
    float4 normal_column0;
    float4 normal_column1; // w: conservative affine sphere stretch.
    float4 normal_column2;
    uint64_t deformation_address;
    uint64_t previous_deformation_address;
};

struct VkrMetalPacketShadowCascade
{
    column_major float4x4 light_view_projection;
    float4 split_near_far_texel_depth;
    float4 origin_inv_size_sun;
};

struct VkrMetalPacketIblProbe
{
    // ADR-038 final layout: offsets 0 and 4 carry the coefficient slot; every
    // field from offset 8 onward keeps its previous offset.
    uint sh_slot;
    uint sh_reserved;
    TextureCube<float4> prefilter;
    float4 center_blend;
    float4 extents_weight;
    float4 intensity_box;
};

struct VkrTemporalTransform
{
    column_major float4x4 model;
    uint generation;
    uint frame_index;
    uint valid;
    uint reserved;
};

struct VkrMetalPacketTemporalDrawState
{
    VkrTemporalTransform* previous_transforms;
    uint2 previous_transform_address_padding;
    column_major float4x4 current_view_projection;
    column_major float4x4 previous_view_projection;
    uint history_valid;
    uint previous_frame_index;
    uint2 reserved;
};

struct VkrMetalPacketDiffuseVolume {
    uint64_t indirection;
    uint64_t probes;
    uint64_t moments;
    uint64_t sh;
    float4 origin;
    float4 params;
    uint4 dimensions;
};

// Mirrors VkrLightmapRect: x and y in `origin`, width and height in
// `extent`, low 16 bits first.
struct VkrLightmapRect {
    uint page;
    uint origin;
    uint extent;
    uint reserved;
};

// Mirrors VkrMetalPacketLightmap in vkr_metal_packet_abi.h (ADR-088). Only
// MSL samples the page array, so the texture stays a resource id here.
struct VkrMetalPacketLightmap {
    uint64_t texture;
    VkrLightmapRect* rects;
    uint rect_count;
    uint layer_count;
    float inverse_page_size;
    uint active_layer_count;
    uint4 active_layers[2];
    float4 active_weights[2];
    uint64_t lamp_direct;
    VkrLightmapRect* direct_rects;
    uint4 active_direct[2];
    uint direct_layer_count;
    uint baked_lamp_count;
    uint reserved0;
    uint reserved1;
    // Two VkrMetalPacketBakedLamp rows, which only MSL reads.
    float4 baked_lamps[10];
};

// Mirrors VkrMetalPacketDecals in vkr_metal_packet_abi.h (ADR-092). Only MSL
// reads the decal rows, so they stay an address here.
struct VkrMetalPacketDecals {
    uint64_t rows;
    uint64_t masks;
    float4 grid_origin_cell_size;
    uint4 grid_dimensions_count;
};

struct VkrMetalPacketSheen {
    uint64_t directional_albedo_texture;
    uint64_t ltc_matrix_texture;
    uint64_t ltc_amplitude_texture;
    uint64_t ltc_matrix_texture_b;
    uint64_t ltc_amplitude_texture_b;
    uint2 reserved;
};

struct VkrGpuRectangleLightRow {
    float4 center_half_width;
    float4 right_half_height;
    float4 up_radiance;
    float4 color;
};

struct VkrMetalPacketLtc {
    VkrGpuRectangleLightRow* lights;
    uint64_t matrix_texture;
    uint64_t amplitude_texture;
    uint light_count;
    uint reserved;
};

struct VkrMetalPacketAnisotropy {
    uint64_t table0;
    uint64_t table1;
    uint64_t table2;
    uint2 reserved;
};

struct VkrMetalPacketLocalShadowTransmission {
    uint64_t depth0;
    uint64_t color0;
    uint64_t depth1;
    uint64_t color1;
    uint64_t overflow;
    uint64_t reserved;
};

// Mirrors VkrMetalPacketSky in draw.metalh; this library does not read it.
struct VkrMetalPacketSky {
    VkrSkyParams params;
    uint64_t aerial_perspective;
    uint64_t transmittance;
    uint64_t multiple_scattering;
    uint64_t cloud_radiance;
    uint64_t cloud_shadow;
    uint64_t cloud_base_noise;
    uint64_t cloud_detail_noise;
    uint64_t cloud_weather;
    uint clear_sh_slot;
    uint cloud_sky_light_face_size;
    uint64_t cloud_sky_light;
};

struct VkrMetalPacketLocalShadowTransmissionDraw {
    uint64_t transmission_materials;
    uint face;
    uint reserved;
    float4 light_position;
};

struct VkrMetalPacketFrameRoot
{
    StructuredBuffer<VkrMetalPacketInstance> instances;
    uint2 instance_address_padding;
    column_major float4x4 view_projection;
    uint64_t materials;
    // ADR-038 final layout; see draw.metalh.
    uint64_t sh_coefficients;
    TextureCube<float4> prefilter;
    uint sh_global_slot;
    float pre_exposure;
    float4 view_position;
    uint prefilter_mip_count;
    uint flags;
    VkrFroxelFogParams* froxel_fog;
    float4 ibl_controls;
    float4 directional_direction_enabled;
    float4 directional_color_intensity;
    float4 ambient_color;
    uint render_mode;
    // Scalar padding matches the host/native-MSL arrays. Metal aligns uint3 to
    // 16 bytes and would move every following field.
    uint shadow_debug_mode;
    Texture3D<float4> froxel_integrated;
    StructuredBuffer<VkrGpuPointLightRow> point_light_data;
    StructuredBuffer<uint4> point_light_masks;
    float4 point_light_grid_origin_cell_size;
    uint4 point_light_grid_dimensions_count;
    uint4 point_light_global_mask;
    uint point_light_count;
    float custom_time;
    uint point_light_reserved_1;
    uint point_light_reserved_2;
    Texture2DArray<float> shadow_map;
    StructuredBuffer<VkrMetalPacketShadowCascade> shadow_cascades;
    column_major float4x4 view;
    uint shadow_cascade_count;
    // Scalar, not float4: matching the host and native-MSL layout. Metal aligns
    // a float4 to 16 bytes and would move every following field.
    uint shadow_pcf_sample_count;
    float shadow_receiver_bias_texels;
    float shadow_slope_bias_texels;
    float shadow_normal_offset_texels;
    float shadow_pcf_radius_texels;
    float shadow_cascade_blend_fraction;
    float shadow_fade_start;
    float shadow_fade_end;
    uint shadow_pcf_uniform_early_out;
    Texture2D<float4> transmission_source;
    StructuredBuffer<VkrMetalPacketIblProbe> ibl_probes;
    uint ibl_probe_count;
    uint ibl_probe_reserved;
    VkrMetalPacketTemporalDrawState* temporal_draw_state;
    Texture2DArray<float> local_shadow_map;
    StructuredBuffer<VkrLocalShadowView> local_shadow_views;
    Texture2D<float4> dfg_lut;
    uint64_t diffuse_volume_reserved;
    VkrMetalPacketDiffuseVolume* diffuse_volume_params;
    VkrMetalPacketLtc* ltc;
    VkrFogParams* fog;
    VkrMetalPacketSheen* sheen;
    VkrMetalPacketAnisotropy* anisotropy;
    VkrMetalPacketLocalShadowTransmission* local_shadow_transmission;
    VkrMetalPacketSky* sky;
    VkrMetalPacketLightmap* lightmap;
    uint64_t terrain_materials;
    uint64_t transmission_materials;
    VkrMetalPacketDecals* decals;
    uint64_t custom_materials;
};

#include "../../../shared/gpu_draw.slangh"

struct VkrMetalPacketDrawRoot
{
    StructuredBuffer<VkrGpuGeometryRow> geometry_rows;
    StructuredBuffer<VkrGpuVisibleDrawRow> visible_rows;
    StructuredBuffer<VkrPackedStaticVertex> vertices;
    ParameterBlock<VkrMetalPacketFrameRoot> frame;
    uint visible_row_index;
    uint flags;
    VkrMetalPacketLocalShadowTransmissionDraw* local_shadow_transmission;
};

struct VkrMetalPacketVertexOutput
{
    float4 position : SV_Position;
    float2 texcoord : TEXCOORD0;
    float4 color : COLOR0;
    nointerpolation uint object_id : TEXCOORD1;
    float3 world_position : TEXCOORD2;
    float3 world_normal : TEXCOORD3;
    float4 world_tangent : TEXCOORD4;
    nointerpolation uint visible_row_index : TEXCOORD5;
    nointerpolation uint instance_index : TEXCOORD10;
};
