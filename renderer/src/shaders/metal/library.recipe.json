  "order_notes": [
    {
      "before": "../shared/shadow_kernel.slangh",
      "note": "The shared receiver kernel must precede shadow/sampling.metalh: the MSL library is concatenated, not include-resolved, so order is the only declaration order there is."
    },
    {
      "before": "../shared/bloom_kernel.slangh",
      "note": "The bloom kernel reuses the exposure kernel's Rec. 709 luminance, so it must follow it here for the same reason as below."
    },
    {
      "before": "../shared/sh_l2_kernel.slangh",
      "note": "VkrShL2Packed and its evaluation are referenced by forward lighting and by the IBL projection kernel, so the shared header precedes both."
    },
    {
      "before": "msl/world/lighting.metalh",
      "note": "Lighting follows shadow sampling: its punctual traversal applies the local-shadow receiver to every lobe."
    }
