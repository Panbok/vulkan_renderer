//
// This file contains no resources, sampling calls, address spaces, or entry
// points. Vulkan includes it as Slang and Metal concatenates it ahead of its
// native kernels. `vkr_gtao.c` mirrors depth conversion and mip filtering.

#ifndef VKR_SHADER_GTAO_KERNEL_SLANGH
#define VKR_SHADER_GTAO_KERNEL_SLANGH

#define VKR_GTAO_PI 3.14159265358979323846f
#define VKR_GTAO_HALF_PI 1.57079632679489661923f
#define VKR_GTAO_HILBERT_WIDTH 64u
#define VKR_GTAO_VIEW_DEPTH_MAX 65504.0f

struct VkrGtaoParams
{
    float4x4 view;

    uint viewport_width;
    uint viewport_height;
    uint depth_mip_count;
    uint reserved_u32_0;

    float viewport_pixel_size_x;
    float viewport_pixel_size_y;
    float projection_m22;
    float projection_m23;

    float projection_m32;
    float projection_m33;
    float projection_m00;
    float projection_m11;

    float projection_m02;
    float projection_m12;
    float projection_m03;
    float projection_m13;

    float effect_radius;
    float radius_multiplier;
    float falloff_range;
    float falloff_mul;

    float falloff_add;
    float depth_mip_falloff_mul;
    float sample_distribution_power;
    float final_value_power;

    float depth_mip_sampling_offset;
    float denoise_blur_beta;
    float reserved_float0;
    float reserved_float1;

    uint slice_count;
    uint steps_per_slice;
    uint noise_index;
    uint reserved0;
};

float vkr_gtao_linearize_depth(VkrGtaoParams params, float device_depth)
{
    float numerator =
        device_depth * params.projection_m33 - params.projection_m23;
    float denominator =
        device_depth * params.projection_m32 - params.projection_m22;
    return min(numerator / denominator, VKR_GTAO_VIEW_DEPTH_MAX);
}

// Returns canonical renderer view space: top-left screen Y is reconstructed
// through the Y-inverted projection and camera forward remains -Z.
float3 vkr_gtao_view_position(VkrGtaoParams params, float2 screen_position,
                              float view_depth)
{
    float view_z = -view_depth;
    float clip_w =
        params.projection_m32 * view_z + params.projection_m33;
    float2 ndc = screen_position * 2.0f - 1.0f;
    float view_x =
        (ndc.x * clip_w - params.projection_m02 * view_z -
         params.projection_m03) /
        params.projection_m00;
    float view_y =
        (ndc.y * clip_w - params.projection_m12 * view_z -
         params.projection_m13) /
        params.projection_m11;
    return float3(view_x, view_y, view_z);
}

float vkr_gtao_pixel_view_size(VkrGtaoParams params, float2 screen_position,
                               float view_depth)
{
    float3 center =
        vkr_gtao_view_position(params, screen_position, view_depth);
    float3 next_y = vkr_gtao_view_position(
        params,
        screen_position + float2(0.0f, params.viewport_pixel_size_y),
        view_depth);
    return max(length(next_y - center), 1e-6f);
}

// Common clip W and the NDC factor cancel when normalizing a slice direction.
// Keep projection signs: increasing screen Y moves toward negative view Y.
float2 vkr_gtao_view_pixel_scale(VkrGtaoParams params)
{
    return float2(params.viewport_pixel_size_x / params.projection_m00,
                  params.viewport_pixel_size_y / params.projection_m11);
}

float vkr_gtao_depth_mip_filter(VkrGtaoParams params, float d0, float d1,
                                float d2, float d3)
{
    float farthest = max(max(d0, d1), max(d2, d3));
    float4 weights = clamp(
        (farthest - float4(d0, d1, d2, d3)) *
                params.depth_mip_falloff_mul +
            params.falloff_add,
        0.0f, 1.0f);
    return dot(weights, float4(d0, d1, d2, d3)) /
           dot(weights, float4(1.0f));
}

float4 vkr_gtao_calculate_edges(float center_depth, float left_depth,
                                float right_depth, float top_depth,
                                float bottom_depth)
{
    float4 edges = float4(left_depth, right_depth, top_depth, bottom_depth) -
                   center_depth;
    float slope_lr = (edges.y - edges.x) * 0.5f;
    float slope_tb = (edges.w - edges.z) * 0.5f;
    float4 adjusted =
        edges + float4(slope_lr, -slope_lr, slope_tb, -slope_tb);
    edges = min(abs(edges), abs(adjusted));
    return clamp(1.25f - edges / (center_depth * 0.011f), 0.0f, 1.0f);
}

float vkr_gtao_pack_edges(float4 edges)
{
    float4 quantized = round(clamp(edges, 0.0f, 1.0f) * 2.9f);
    return dot(quantized,
               float4(64.0f / 255.0f, 16.0f / 255.0f,
                      4.0f / 255.0f, 1.0f / 255.0f));
}

float4 vkr_gtao_unpack_edges(float packed_edges)
{
    uint packed = uint(packed_edges * 255.0f + 0.5f);
    return float4(float((packed >> 6u) & 3u),
                  float((packed >> 4u) & 3u),
                  float((packed >> 2u) & 3u), float(packed & 3u)) /
           3.0f;
}

uint vkr_gtao_hilbert_index(uint2 position)
{
    uint index = 0u;
    for (uint level = VKR_GTAO_HILBERT_WIDTH / 2u; level > 0u;
         level /= 2u)
    {
        uint region_x = (position.x & level) != 0u ? 1u : 0u;
        uint region_y = (position.y & level) != 0u ? 1u : 0u;
        index += level * level * ((3u * region_x) ^ region_y);
        if (region_y == 0u)
        {
            if (region_x != 0u)
            {
                position.x = VKR_GTAO_HILBERT_WIDTH - 1u - position.x;
                position.y = VKR_GTAO_HILBERT_WIDTH - 1u - position.y;
            }
            uint temporary = position.x;
            position.x = position.y;
            position.y = temporary;
        }
    }
    return index;
}

float2 vkr_gtao_spatiotemporal_noise(uint2 pixel, uint noise_index)
{
    uint index = vkr_gtao_hilbert_index(
        uint2(pixel.x % VKR_GTAO_HILBERT_WIDTH,
              pixel.y % VKR_GTAO_HILBERT_WIDTH));
    index += 288u * (noise_index % 64u);
    float2 sequence =
        0.5f + float(index) *
                   float2(0.75487766624669276005f, 0.56984029099805326591f);
    return sequence - floor(sequence);
}

float vkr_gtao_sample_distance(VkrGtaoParams params, float step,
                               float step_noise)
{
    float normalized =
        (step + step_noise) / float(params.steps_per_slice);
    return pow(normalized, params.sample_distribution_power);
}

float vkr_gtao_falloff_weight(VkrGtaoParams params, float view_distance)
{
    return clamp(view_distance * params.falloff_mul + params.falloff_add,
                 0.0f, 1.0f);
}

float vkr_gtao_integrate_slice(float projected_normal_length, float cos_normal,
                               float normal_angle, float horizon_cos0,
                               float horizon_cos1)
{
    // Horizon 0 bounds the positive slice direction; horizon 1 the negative.
    float h0 = -acos(clamp(horizon_cos1, -1.0f, 1.0f));
    float h1 = acos(clamp(horizon_cos0, -1.0f, 1.0f));
    float arc0 = (cos_normal + 2.0f * h0 * sin(normal_angle) -
                  cos(2.0f * h0 - normal_angle)) *
                 0.25f;
    float arc1 = (cos_normal + 2.0f * h1 * sin(normal_angle) -
                  cos(2.0f * h1 - normal_angle)) *
                 0.25f;
    return projected_normal_length * (arc0 + arc1);
}

float vkr_gtao_finalize_visibility(VkrGtaoParams params, float visibility)
{
    visibility = clamp(visibility / float(params.slice_count), 0.0f, 1.0f);
    return max(0.03f, pow(visibility, params.final_value_power));
}

// Algorithm 2 from Jimenez et al. (2016), as implemented in XeGTAO 1.30.
// The current renderer's slice direction already contains the signed
// projection scale.  Projecting it into the view-direction plane keeps the
// directional moment aligned with the scalar horizon integration.
float3 vkr_gtao_integrate_bent_slice(
    float projected_normal_length, float normal_angle, float horizon_cos0,
    float horizon_cos1, float3 view_direction, float3 view_slice_direction)
{
    float h0 = -acos(clamp(horizon_cos1, -1.0f, 1.0f));
    float h1 = acos(clamp(horizon_cos0, -1.0f, 1.0f));
    float t0 =
        (6.0f * sin(h0 - normal_angle) - sin(3.0f * h0 - normal_angle) +
         6.0f * sin(h1 - normal_angle) - sin(3.0f * h1 - normal_angle) +
         16.0f * sin(normal_angle) -
         3.0f * (sin(h0 + normal_angle) + sin(h1 + normal_angle))) /
        12.0f;
    float t1 =
        (-cos(3.0f * h0 - normal_angle) -
         cos(3.0f * h1 - normal_angle) + 8.0f * cos(normal_angle) -
         3.0f * (cos(h0 + normal_angle) + cos(h1 + normal_angle))) /
        12.0f;
    float3 plane_direction =
        view_slice_direction - view_direction *
                                   dot(view_slice_direction, view_direction);
    float plane_length_squared = dot(plane_direction, plane_direction);
    if (plane_length_squared <= 1e-12f)
        return float3(0.0f);

    plane_direction *= rsqrt(plane_length_squared);
    return projected_normal_length *
           (plane_direction * t0 + view_direction * t1);
}

float4 vkr_gtao_matrix_vector(float4x4 matrix, float4 vector)
{
#if defined(__METAL_VERSION__)
    return matrix * vector;
#else
    return mul(matrix, vector);
#endif
}

// `view` is world-to-view.  It contains a rigid camera rotation, so its
// transpose is the inverse direction transform and requires no per-pixel
// inverse.
float3 vkr_gtao_view_to_world_direction(VkrGtaoParams params,
                                        float3 view_direction)
{
    return vkr_gtao_matrix_vector(transpose(params.view),
                                  float4(view_direction, 0.0f))
        .xyz;
}

float3 vkr_gtao_normalize_or(float3 value, float3 fallback)
{
    float value_length_squared = dot(value, value);
    if (value_length_squared > 1e-12f)
        return value * rsqrt(value_length_squared);

    float fallback_length_squared = dot(fallback, fallback);
    if (fallback_length_squared > 1e-12f)
        return fallback * rsqrt(fallback_length_squared);
    return float3(0.0f, 0.0f, 1.0f);
}

float4 vkr_gtao_encode_directional(float3 world_bent_normal,
                                   float visibility)
{
    return float4(clamp(world_bent_normal * 0.5f + 0.5f, 0.0f, 1.0f),
                  clamp(visibility, 0.0f, 1.0f));
}

// This raw decode is for the 3x3 denoiser.  It intentionally does not blend
// visibility: filtering applies that blend once, after it has normalized the
// weighted directional sum.
float3 vkr_gtao_decode_bent_direction(float4 packed,
                                      float3 fallback_world_normal)
{
    return vkr_gtao_normalize_or(packed.xyz * 2.0f - 1.0f,
                                 fallback_world_normal);
}

float vkr_gtao_decode_visibility(float4 packed)
{
    return clamp(packed.w, 0.0f, 1.0f);
}

// At full visibility no screen-space occluder changes diffuse direction.  The
// visibility blend also makes an RGBA(1) disabled target exactly neutral.
float3 vkr_gtao_decode_bent_normal(float4 packed,
                                   float3 fallback_world_normal)
{
    float visibility = vkr_gtao_decode_visibility(packed);
    float3 bent = vkr_gtao_decode_bent_direction(packed,
                                                  fallback_world_normal);
    return vkr_gtao_normalize_or(
        bent * (1.0f - visibility) + fallback_world_normal * visibility,
        fallback_world_normal);
}

float4 vkr_gtao_finalize_directional(VkrGtaoParams params,
                                     float visibility_sum,
                                     float3 bent_moment_view,
                                     float3 fallback_world_normal)
{
    float3 bent_world =
        vkr_gtao_view_to_world_direction(params, bent_moment_view);
    bent_world = vkr_gtao_normalize_or(bent_world, fallback_world_normal);
    return vkr_gtao_encode_directional(
        bent_world, vkr_gtao_finalize_visibility(params, visibility_sum));
}

// Jimenez et al. (2016) multi-bounce fit.  This belongs to global/probe
// diffuse irradiance only; baked-volume irradiance retains scalar visibility.
float3 vkr_gtao_multibounce(float visibility, float3 albedo)
{
    float x = clamp(visibility, 0.0f, 1.0f);
    if (x <= 0.0f)
        return float3(0.0f);
    if (x >= 1.0f)
        return float3(1.0f);
    float3 clamped_albedo = clamp(albedo, 0.0f, 1.0f);
    float3 a = 2.0404f * clamped_albedo - 0.3324f;
    float3 b = -4.7951f * clamped_albedo + 0.6417f;
    float3 c = 2.7552f * clamped_albedo + 0.6903f;
    return clamp(max(float3(x), ((x * a + b) * x + c) * x), 0.0f, 1.0f);
}

// Oat and Sander's spherical-cap overlap approximation used by Jimenez et
// al. for GTSO.  The result is a solid angle divided by 2*pi.
float vkr_gtao_spherical_caps_intersection(float cos_cap0, float cos_cap1,
                                           float cos_distance)
{
    cos_cap0 = clamp(cos_cap0, -1.0f, 1.0f);
    cos_cap1 = clamp(cos_cap1, -1.0f, 1.0f);
    float radius0 = acos(cos_cap0);
    float radius1 = acos(cos_cap1);
    float distance = acos(clamp(cos_distance, -1.0f, 1.0f));
    if (min(radius0, radius1) <= max(radius0, radius1) - distance)
        return max(0.0f, 1.0f - max(cos_cap0, cos_cap1));
    if (radius0 + radius1 <= distance)
        return 0.0f;

    float delta = abs(radius0 - radius1);
    float x = 1.0f - clamp(
                         (distance - delta) /
                             max(radius0 + radius1 - delta, 1e-4f),
                         0.0f, 1.0f);
    return x * x * (3.0f - 2.0f * x) *
           max(0.0f, 1.0f - max(cos_cap0, cos_cap1));
}

// GTSO: normalize the overlap of the visibility and GGX specular cones by
// the specular cone's area.  The [0.01, 0.09] roughness fade is the bounded
// practical approximation adopted by Filament for near-mirror lobes.
float vkr_gtao_cone_specular(float visibility, float3 world_bent_normal,
                             float3 world_reflection_direction,
                             float roughness)
{
    float visibility_clamped = clamp(visibility, 0.0f, 1.0f);
    if (visibility_clamped >= 1.0f)
        return 1.0f;

    float roughness_clamped = clamp(roughness, 0.0f, 1.0f);
    float cos_visibility_cap = sqrt(max(0.0f, 1.0f -
                                                   visibility_clamped));
    float cos_specular_cap = exp2(-3.32192809488736234787f *
                                  roughness_clamped * roughness_clamped);
    float overlap = vkr_gtao_spherical_caps_intersection(
        cos_visibility_cap, cos_specular_cap,
        dot(vkr_gtao_normalize_or(world_bent_normal, float3(0.0f, 0.0f, 1.0f)),
            vkr_gtao_normalize_or(world_reflection_direction,
                                  float3(0.0f, 0.0f, 1.0f))));
    float cone_visibility = clamp(
        overlap / max(1.0f - cos_specular_cap, 1e-6f), 0.0f, 1.0f);
    float fade = smoothstep(0.01f, 0.09f, roughness_clamped);
    return 1.0f + (cone_visibility - 1.0f) * fade;
}

float vkr_gtao_diagonal_edge_weight(float center_edge0,
                                    float neighbor_edge0,
                                    float center_edge1,
                                    float neighbor_edge1)
{
    return 0.425f *
           (center_edge0 * neighbor_edge0 + center_edge1 * neighbor_edge1);
}

#endif
