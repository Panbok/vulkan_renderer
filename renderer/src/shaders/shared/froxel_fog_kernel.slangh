// Camera-aligned froxel fog: portable parameter layout and arithmetic only.
// Native roots own 3D texture syntax, comparison sampling, history selection,
// and dispatch. The 3D history stores local source/extinction; current-camera
// integration is transient and never crosses a camera transform.
#ifndef VKR_SHADER_FROXEL_FOG_KERNEL_SLANGH
#define VKR_SHADER_FROXEL_FOG_KERNEL_SLANGH

#define VKR_FROXEL_DEPTH_COUNT 64u
#define VKR_FROXEL_MAX_BOXES 16u
#define VKR_FROXEL_MAX_OPTICAL_DEPTH 80.0f
#define VKR_FROXEL_MAX_EXTINCTION 60000.0f
#define VKR_FROXEL_MAX_RADIANCE 5000.0f
#define VKR_FROXEL_EPSILON 1e-6f

#if defined(__METAL_VERSION__)
#define VKR_FROXEL_MUL(a, b) ((a) * (b))
#define VKR_FROXEL_LERP(a, b, t) mix((a), (b), (t))
#else
#define VKR_FROXEL_MUL(a, b) mul((a), (b))
#define VKR_FROXEL_LERP(a, b, t) lerp((a), (b), (t))
#endif

struct VkrFroxelDensityBox
{
    // xyz are ordered world bounds; w is a finite nonnegative multiplier.
    float4 min_density;
    float4 max_reserved;
};

// Matches the 928-byte VkrFroxelFogGpuParams C record exactly. The two
// appended matrices separate unjittered volume coordinates from the raster
// convention used to reconstruct opaque depth.
struct VkrFroxelFogParams
{
#if defined(__METAL_VERSION__)
    float4x4 inverse_view_projection;
    float4x4 previous_view_projection;
    float4x4 previous_view;
#else
    column_major float4x4 inverse_view_projection;
    column_major float4x4 previous_view_projection;
    column_major float4x4 previous_view;
#endif
    float4 color_density;
    float4 height_distance_phase;
    float4 depth_mapping;
    float4 temporal_clamp;
    uint4 grid_dimensions_cell_pixels;
    // x/y are current point-light source indices, z is selected count, w is
    // active box count. Unused light indices are UINT_MAX.
    uint4 selected_local_indices_count;
    VkrFroxelDensityBox boxes[VKR_FROXEL_MAX_BOXES];
#if defined(__METAL_VERSION__)
    float4x4 current_view_projection;
    float4x4 inverse_raster_view_projection;
#else
    column_major float4x4 current_view_projection;
    column_major float4x4 inverse_raster_view_projection;
#endif
};

struct VkrFroxelSample
{
    float3 inscatter;
    float transmittance;
};

struct VkrFroxelSliceInterval
{
    float near_distance;
    float far_distance;
};

struct VkrFroxelHistoryCoordinate
{
    float3 uvw;
    uint valid;
};

struct VkrFroxelIntegratedCoordinate
{
    float z;
    float near_blend;
    uint near_identity;
};

// The prepared boundary proves the remaining dimensions when x is nonzero.
// This one-word gate lets every native path avoid touching its optional 3D
// resources before fog work is selected.
bool vkr_froxel_enabled(VkrFroxelFogParams params)
{
    return params.grid_dimensions_cell_pixels.x != 0u;
}

float3 vkr_froxel_safe_normalize(float3 value, float3 fallback)
{
    float length_squared = dot(value, value);
    return length_squared > 1e-12f ? value * rsqrt(length_squared) : fallback;
}

float3 vkr_froxel_cap_radiance(float3 value)
{
    float3 nonnegative = max(value, float3(0.0f));
    float peak = max(nonnegative.x, max(nonnegative.y, nonnegative.z));
    return peak > VKR_FROXEL_MAX_RADIANCE
               ? nonnegative * (VKR_FROXEL_MAX_RADIANCE / peak)
               : nonnegative;
}

float vkr_froxel_boundary_distance(VkrFroxelFogParams params, float boundary)
{
    uint count = max(params.grid_dimensions_cell_pixels.z, 1u);
    float fraction = clamp(boundary / float(count), 0.0f, 1.0f);
    return params.depth_mapping.x * exp(fraction * params.depth_mapping.y);
}

VkrFroxelSliceInterval vkr_froxel_slice_interval(VkrFroxelFogParams params,
                                                  uint slice)
{
    VkrFroxelSliceInterval result;
    result.near_distance = vkr_froxel_boundary_distance(params, float(slice));
    result.far_distance = vkr_froxel_boundary_distance(params, float(slice + 1u));
    return result;
}

float vkr_froxel_slice_center_distance(VkrFroxelFogParams params, uint slice)
{
    return vkr_froxel_boundary_distance(params, float(slice) + 0.5f);
}

float vkr_froxel_depth_fraction(VkrFroxelFogParams params, float positive_depth)
{
    float depth = clamp(positive_depth, params.depth_mapping.x,
                        params.height_distance_phase.z);
    return clamp(log(max(depth, params.depth_mapping.x) /
                     max(params.depth_mapping.x, VKR_FROXEL_EPSILON)) *
                         params.depth_mapping.z,
                 0.0f, 1.0f);
}

// Current/history scattering is stored at cell centres, so ordinary normalized
// hardware 3D sampling uses this z coordinate directly.
float vkr_froxel_scattering_sample_z(VkrFroxelFogParams params,
                                     float positive_depth)
{
    return vkr_froxel_depth_fraction(params, positive_depth);
}

// Integrated values are stored at the far boundary of each slice. At the first
// interval, callers blend the identity (S=0,T=1) to slice zero; later intervals
// shift f by half a texel so linear filtering interpolates neighbouring far
// boundaries rather than treating centre samples as mid-slice values.
VkrFroxelIntegratedCoordinate
vkr_froxel_integrated_sample_coordinate(VkrFroxelFogParams params,
                                        float positive_depth)
{
    uint count = max(params.grid_dimensions_cell_pixels.z, 1u);
    float fraction = vkr_froxel_depth_fraction(params, positive_depth);
    float first_boundary = 1.0f / float(count);
    VkrFroxelIntegratedCoordinate result;
    result.near_identity = fraction < first_boundary ? 1u : 0u;
    result.near_blend = result.near_identity != 0u
                            ? fraction * float(count)
                            : 1.0f;
    result.z = result.near_identity != 0u
                   ? 0.5f / float(count)
                   : clamp(fraction - 0.5f / float(count),
                           0.5f / float(count),
                           1.0f - 0.5f / float(count));
    return result;
}

float3 vkr_froxel_homogeneous(float4 value)
{
    float reciprocal = abs(value.w) > VKR_FROXEL_EPSILON
                           ? 1.0f / value.w
                           : 0.0f;
    return value.xyz * reciprocal;
}

// Two finite points establish the ray even for an infinite raster far plane.
// Extrapolation keeps injection and sky sampling at the authored fog distance,
// matching the CPU local-light selection bounds.
float3 vkr_froxel_world_at_view_depth(VkrFroxelFogParams params,
                                      float4x4 current_view, float2 ndc,
                                      float positive_depth)
{
    float3 near_world = vkr_froxel_homogeneous(
        VKR_FROXEL_MUL(params.inverse_view_projection, float4(ndc, 0.0f, 1.0f)));
    float3 ray_world = vkr_froxel_homogeneous(
        VKR_FROXEL_MUL(params.inverse_view_projection, float4(ndc, 0.5f, 1.0f)));
    float near_depth = -VKR_FROXEL_MUL(current_view, float4(near_world, 1.0f)).z;
    float ray_depth = -VKR_FROXEL_MUL(current_view, float4(ray_world, 1.0f)).z;
    float denominator = ray_depth - near_depth;
    float t = abs(denominator) > VKR_FROXEL_EPSILON
                  ? (positive_depth - near_depth) / denominator
                  : 0.0f;
    return near_world + (ray_world - near_world) * t;
}

float3 vkr_froxel_world_center(VkrFroxelFogParams params, float4x4 current_view,
                               uint3 cell)
{
    uint2 extent = params.grid_dimensions_cell_pixels.xy;
    float2 uv = (float2(cell.xy) + 0.5f) / float2(max(extent, uint2(1u)));
    float2 ndc = uv * 2.0f - 1.0f;
    return vkr_froxel_world_at_view_depth(
        params, current_view, ndc, vkr_froxel_slice_center_distance(params, cell.z));
}

float vkr_froxel_ray_length_scale(float4x4 current_view,
                                  float3 near_world, float3 far_world)
{
    float3 world_line = far_world - near_world;
    float view_delta = abs(VKR_FROXEL_MUL(current_view,
                                          float4(world_line, 0.0f)).z);
    return view_delta > VKR_FROXEL_EPSILON
               ? length(world_line) / view_delta
               : 1.0f;
}

float vkr_froxel_height_density(VkrFroxelFogParams params, float3 world_position)
{
    float base_density = max(params.color_density.w, 0.0f);
    // The boundary permits zero density with arbitrary finite box multipliers.
    // Return before the box path so zero times an extreme multiplier is never
    // evaluated as an indeterminate float operation.
    if (base_density <= 0.0f)
        return 0.0f;

    float exponent = clamp(-params.height_distance_phase.y *
                               (world_position.y - params.height_distance_phase.x),
                           -80.0f, 80.0f);
    float height_factor = exp(exponent);
    // Clamp before multiplication: finite authoring density can otherwise
    // overflow against the allowed exp(80) height factor.
    base_density = min(base_density,
                       VKR_FROXEL_MAX_EXTINCTION / height_factor) * height_factor;
    float density = base_density;
    uint box_count = params.selected_local_indices_count.w;
    for (uint index = 0u; index < box_count; ++index)
    {
        VkrFroxelDensityBox box = params.boxes[index];
        bool inside = all(world_position >= box.min_density.xyz) &&
                      all(world_position <= box.max_reserved.xyz);
        if (inside)
        {
            // Add each relative box contribution only up to the optical-domain
            // cap. Dividing before multiplying keeps every finite valid box
            // multiplier finite even when it approaches FLT_MAX.
            float remaining_multiplier =
                max((VKR_FROXEL_MAX_EXTINCTION - density) / base_density, 0.0f);
            density += base_density * min(max(box.min_density.w, 0.0f),
                                           remaining_multiplier);
        }
    }
    return min(density, VKR_FROXEL_MAX_EXTINCTION);
}

float vkr_froxel_phase_isotropic()
{
    return 0.07957747154594767f; // 1 / (4*pi)
}

float3 vkr_froxel_local_source(float extinction, float3 incident_radiance,
                                VkrFroxelFogParams params)
{
    float3 incident = max(incident_radiance, float3(0.0f));
    float incident_peak = max(incident.x, max(incident.y, incident.z));
    if (incident_peak <= 0.0f)
        return float3(0.0f);

    // Form a unit-peak source before restoring incident amplitude. That keeps
    // the final hue-preserving 5,000 bound finite for valid finite lights,
    // instead of overflowing an intermediate RGB product first.
    float3 unit_source = max(extinction, 0.0f) *
                         max(params.color_density.rgb, float3(0.0f)) *
                         (incident / incident_peak) * vkr_froxel_phase_isotropic();
    float unit_peak = max(unit_source.x, max(unit_source.y, unit_source.z));
    if (unit_peak <= 0.0f)
        return float3(0.0f);
    float amplitude = min(incident_peak, VKR_FROXEL_MAX_RADIANCE / unit_peak);
    return unit_source * amplitude;
}

VkrFroxelHistoryCoordinate
vkr_froxel_volume_coordinate(VkrFroxelFogParams params, float4x4 view,
                             float3 world_position)
{
    VkrFroxelHistoryCoordinate result;
    float4 clip = VKR_FROXEL_MUL(params.current_view_projection,
                                  float4(world_position, 1.0f));
    if (clip.w <= VKR_FROXEL_EPSILON)
    {
        result.uvw = 0.0f;
        result.valid = 0u;
        return result;
    }
    float2 uv = clip.xy / clip.w * 0.5f + 0.5f;
    float positive_depth = -VKR_FROXEL_MUL(view, float4(world_position, 1.0f)).z;
    float z = vkr_froxel_scattering_sample_z(params, positive_depth);
    result.uvw = float3(uv, z);
    result.valid = positive_depth >= params.depth_mapping.x &&
                   positive_depth <= params.height_distance_phase.z &&
                   all(uv >= 0.0f) && all(uv <= 1.0f) ? 1u : 0u;
    return result;
}

// Current-camera integrated sampling needs only front-facing screen coverage.
// It intentionally clamps depth to the last far-boundary texel: geometry and
// sky beyond the fog range retain the terminal integrated transmittance.
VkrFroxelHistoryCoordinate
vkr_froxel_integrated_coordinate(VkrFroxelFogParams params,
                                 float3 world_position)
{
    VkrFroxelHistoryCoordinate result;
    float4 clip = VKR_FROXEL_MUL(params.current_view_projection,
                                  float4(world_position, 1.0f));
    if (clip.w <= VKR_FROXEL_EPSILON)
    {
        result.uvw = 0.0f;
        result.valid = 0u;
        return result;
    }
    float2 uv = clip.xy / clip.w * 0.5f + 0.5f;
    result.uvw = float3(uv, 0.0f);
    result.valid = all(uv >= 0.0f) && all(uv <= 1.0f) ? 1u : 0u;
    return result;
}

VkrFroxelHistoryCoordinate
vkr_froxel_history_coordinate(VkrFroxelFogParams params, float3 world_position)
{
    VkrFroxelHistoryCoordinate result;
    float4 clip = VKR_FROXEL_MUL(params.previous_view_projection,
                                  float4(world_position, 1.0f));
    if (clip.w <= VKR_FROXEL_EPSILON)
    {
        result.uvw = 0.0f;
        result.valid = 0u;
        return result;
    }
    float2 uv = clip.xy / clip.w * 0.5f + 0.5f;
    float previous_depth = -VKR_FROXEL_MUL(params.previous_view,
                                            float4(world_position, 1.0f)).z;
    float z = vkr_froxel_scattering_sample_z(params, previous_depth);
    float3 half_texel = 0.5f /
        float3(max(params.grid_dimensions_cell_pixels.xyz, uint3(1u)));
    result.uvw = float3(uv, z);
    result.valid = previous_depth >= params.depth_mapping.x &&
                   previous_depth <= params.height_distance_phase.z &&
                   all(result.uvw >= half_texel) &&
                   all(result.uvw <= 1.0f - half_texel) ? 1u : 0u;
    return result;
}

float4 vkr_froxel_temporal_filter(VkrFroxelFogParams params, float4 current,
                                  float4 history, uint history_valid)
{
    if (history_valid == 0u)
        return current;
    float lower = params.temporal_clamp.y;
    float upper = params.temporal_clamp.z;
    float epsilon = max(params.temporal_clamp.w, VKR_FROXEL_EPSILON);
    float4 bounded_history = clamp(history, current * lower,
                                   max(current * upper, float4(epsilon)));
    float weight = saturate(params.temporal_clamp.x);
    float4 result = VKR_FROXEL_LERP(current, bounded_history, weight);
    result.rgb = vkr_froxel_cap_radiance(result.rgb);
    result.w = min(max(result.w, 0.0f), VKR_FROXEL_MAX_EXTINCTION);
    return result;
}

VkrFroxelSample vkr_froxel_integrate_step(VkrFroxelSample previous,
                                          float3 source, float extinction,
                                          float segment_length)
{
    float optical_depth = min(max(extinction * max(segment_length, 0.0f), 0.0f),
                              VKR_FROXEL_MAX_OPTICAL_DEPTH);
    float segment_transmittance = exp(-optical_depth);
    float source_scale = extinction > VKR_FROXEL_EPSILON
                             ? (1.0f - segment_transmittance) / extinction
                             : max(segment_length, 0.0f);
    VkrFroxelSample result;
    result.inscatter = vkr_froxel_cap_radiance(
        previous.inscatter + previous.transmittance *
                                  max(source, float3(0.0f)) * source_scale);
    result.transmittance = saturate(previous.transmittance * segment_transmittance);
    return result;
}

VkrFroxelSample vkr_froxel_apply_integrated(float3 radiance,
                                             VkrFroxelSample sample)
{
    VkrFroxelSample result;
    // The working cap belongs to fog-generated radiance, never the HDR scene.
    result.inscatter = radiance * sample.transmittance + sample.inscatter;
    result.transmittance = sample.transmittance;
    return result;
}

float3 vkr_froxel_apply_local_over_feedback(float3 local_radiance,
                                             float3 feedback_weight,
                                             VkrFroxelSample sample)
{
    return local_radiance * sample.transmittance +
           sample.inscatter * (1.0f - saturate(feedback_weight));
}

#undef VKR_FROXEL_MUL
#undef VKR_FROXEL_LERP
#endif
