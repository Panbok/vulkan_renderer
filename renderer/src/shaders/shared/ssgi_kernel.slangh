// Shared screen-space diffuse-GI arithmetic. Native paths own texture access,
// root bindings and workgroups. This header intentionally reuses the proven SSR
// positive-depth hierarchy traversal rather than defining a second traversal
// representation. It must follow ssr_kernel.slangh, and exposure_kernel.slangh
// for its Rec. 709 luminance, in each shader library.
#ifndef VKR_SHADER_SSGI_KERNEL_SLANGH
#define VKR_SHADER_SSGI_KERNEL_SLANGH

#ifndef VKR_SSGI_CONTRACT
#include "ssgi_contract.slangh"
#endif

#ifndef VKR_SHADER_SSR_KERNEL_SLANGH
#error "ssgi_kernel.slangh requires ssr_kernel.slangh first"
#endif

#ifndef VKR_EXPOSURE_HISTOGRAM_BINS
#error "ssgi_kernel.slangh requires exposure_kernel.slangh first"
#endif

#define VKR_SSGI_MAX_STEPS 24u
#define VKR_SSGI_EPSILON 1e-6f
#define VKR_SSGI_NEAR_EPSILON 1e-4f
#define VKR_SSGI_TWO_PI 6.28318530717958647692f
// Largest finite RGBA16F value; raw and history images store half floats.
#define VKR_SSGI_HALF_MAX 65504.0f
// Hit slab and receiver-plane tolerance in source-pixel footprints at the
// surface depth. The configured thickness remains the near-field minimum.
#define VKR_SSGI_THICKNESS_FOOTPRINTS 4.0f
// A neighbour further off the centre receiver's tangent plane than this
// fraction of the separation that plane predicts at the neighbour's pixel is
// another surface. It admits about 14 degrees of normal-map or curvature tilt
// between the two samples.
#define VKR_SSGI_PLANE_SLOPE 0.25f
// One raw sample keeps at most this multiple of its reference luminance (the
// larger of the other samples' weighted mean and the receiver's accepted
// history) unless its share of the filtered estimate stays under the display
// share below.
#define VKR_SSGI_FIREFLY_MEAN_SCALE 4.0f
// Displayed luminance (pre-exposed luminance times the display exposure
// scale) that one raw sample may add to its receiver's 3x3 estimate however
// far it lies above its reference. A lone hit on a small emitter, which one
// ray in thousands sees, would otherwise add its whole radiance to every
// receiver that averages it; a receiver whose neighbours lie on other
// surfaces averages nothing. Dim bounce stays under this share at any hit
// rate, and bright bounce that persists raises the history reference.
#define VKR_SSGI_FIREFLY_DISPLAY_SHARE 0.25f
// History retention factor in an all-miss neighbourhood whose history the
// receiver's motion left with no accepted support. Fully supported history,
// as under a camera pan over static geometry, keeps full retention, so sparse
// hits stay unbiased in motion as when converged.
#define VKR_SSGI_EMPTY_RETENTION_MOVING 0.6f
// History kept per frame by a receiver whose 3x3 neighbourhood holds no
// answered ray (every ray exhausted, or the receivers have no material AO):
// no new sample exists, but the old one cannot stay forever.
#define VKR_SSGI_UNANSWERED_RETENTION 0.95f

// Mirrors VkrSsgiGpuParams exactly. It intentionally occupies the same 288 B
// physical layout as VkrSsrParams, while sample_phase, normal_bias and
// pixel_footprint have diffuse-GI meanings.
struct VkrSsgiParams
{
    float4x4 projection;
    float4x4 inverse_projection;
    float4x4 view;

    uint source_width;
    uint source_height;
    uint trace_width;
    uint trace_height;

    uint depth_mip_count;
    uint max_steps;
    uint history_valid;
    uint sample_phase;

    float thickness;
    float max_distance;
    float normal_bias;
    float edge_fade_pixels;

    float temporal_weight;
    float temporal_depth_relative;
    float temporal_depth_absolute;
    // View-space size of one source pixel at unit positive depth.
    float pixel_footprint;

    float previous_projection_m22;
    float previous_projection_m23;
    float previous_projection_m32;
    float previous_projection_m33;

    float trace_texel_size_x;
    float trace_texel_size_y;
    float history_jitter_uv_x;
    float history_jitter_uv_y;
};

struct VkrSsgiReceiver
{
    uint2 pixel;
    float positive_depth;
    uint valid;
};

// The SSR representation is an internal screen-hierarchy view only. Its
// reflection-only roughness field is never read by SSGI; keeping traversal and
// temporal acceptance in one implementation prevents odd-tail and perspective
// depth policies from drifting between the two screen-space features.
VkrSsrParams vkr_ssgi_screen_trace_params(VkrSsgiParams params)
{
    VkrSsrParams result;
    result.projection = params.projection;
    result.inverse_projection = params.inverse_projection;
    result.view = params.view;
    result.source_width = params.source_width;
    result.source_height = params.source_height;
    result.trace_width = params.trace_width;
    result.trace_height = params.trace_height;
    result.depth_mip_count = params.depth_mip_count;
    result.max_steps = params.max_steps;
    result.history_valid = params.history_valid;
    result.reserved_u32_0 = 0u;
    result.thickness = params.thickness;
    result.max_distance = params.max_distance;
    result.roughness_cutoff = 0.0f;
    result.edge_fade_pixels = params.edge_fade_pixels;
    result.temporal_weight = params.temporal_weight;
    result.temporal_depth_relative = params.temporal_depth_relative;
    result.temporal_depth_absolute = params.temporal_depth_absolute;
    result.reserved_float_0 = 0.0f;
    result.previous_projection_m22 = params.previous_projection_m22;
    result.previous_projection_m23 = params.previous_projection_m23;
    result.previous_projection_m32 = params.previous_projection_m32;
    result.previous_projection_m33 = params.previous_projection_m33;
    result.trace_texel_size_x = params.trace_texel_size_x;
    result.trace_texel_size_y = params.trace_texel_size_y;
    result.history_jitter_uv_x = params.history_jitter_uv_x;
    result.history_jitter_uv_y = params.history_jitter_uv_y;
    return result;
}

bool vkr_ssgi_finite(float3 value)
{
    return vkr_ssr_finite(value.x) && vkr_ssr_finite(value.y) &&
           vkr_ssr_finite(value.z);
}

// Radiance a half-float image can hold: non-finite becomes zero so one bad
// texel cannot spread through bilinear history, and finite values saturate at
// the format maximum instead of rounding to infinity on store.
float3 vkr_ssgi_storable(float3 radiance)
{
    return vkr_ssgi_finite(radiance)
        ? clamp(radiance, float3(0.0f), float3(VKR_SSGI_HALF_MAX))
        : float3(0.0f);
}

// Hit slab half-width at a positive depth. Far away one source pixel spans
// more depth than the configured near-field thickness, so the slab widens with
// the pixel footprint instead of rejecting most distant and grazing hits.
float vkr_ssgi_thickness(VkrSsgiParams params, float positive_depth)
{
    return max(params.thickness, VKR_SSGI_THICKNESS_FOOTPRINTS *
                                     params.pixel_footprint * positive_depth);
}

// SSGI retains its half-resolution leaf and existing relative crossing math.
VkrSsrCellExit vkr_ssgi_trace_cell_exit(VkrSsrTrace trace, uint2 mip_extent,
                                        VkrSsrParams screen)
{
    if (trace.active == 0u || any(mip_extent == 0u) ||
        !vkr_ssr_trace_in_bounds(trace))
        return vkr_ssr_cell_exit_in_place(trace);
    float2 uv = vkr_ssr_trace_uv(trace);
    float2 direction = trace.end_uv - trace.start_uv;
    uint source_shift = trace.mip + 1u;
    uint2 cell = vkr_ssr_level_cell(uv, mip_extent, source_shift, screen);
    float2 boundary = vkr_ssr_cell_exit_boundary(trace, cell, mip_extent,
                                                 source_shift, screen);
    float tx = abs(direction.x) > VKR_SSR_EPSILON
                   ? (boundary.x - uv.x) / direction.x
                   : 3.402823466e+38f;
    float ty = abs(direction.y) > VKR_SSR_EPSILON
                   ? (boundary.y - uv.y) / direction.y
                   : 3.402823466e+38f;
    VkrSsrCellExit result;
    result.t = min(trace.t + max(min(tx, ty), 0.0f), 1.0f);
    result.restart_t = vkr_ssr_trace_restart(trace, result.t, cell,
                                             mip_extent, source_shift, screen);
    return result;
}

// SSGI's symmetric sample slab, independent of SSR's surface-intersection
// policy. Both reuse the same interval traversal. `thickness` is the slab
// half-width at the hierarchy depth (vkr_ssgi_thickness).
VkrSsrTraceResolve vkr_ssgi_trace_resolve(VkrSsrTrace trace,
                                          float hierarchy_depth,
                                          float cell_exit_t,
                                          float thickness)
{
    return vkr_ssr_trace_resolve_interval(trace, hierarchy_depth,
                                          hierarchy_depth - thickness,
                                          hierarchy_depth + thickness,
                                          hierarchy_depth, cell_exit_t);
}

// Every hierarchy cell that contains the ray origin also contains the
// receiver's own leaf, so a trace started at the top level spends one decision
// per level descending to that leaf. Start there instead; each advance still
// ascends one level up to the top of the hierarchy.
VkrSsrTrace vkr_ssgi_trace_begin(VkrSsrParams screen, float3 origin_view,
                                 float3 direction_view)
{
    VkrSsrTrace trace = vkr_ssr_trace_begin(
        screen, origin_view, direction_view,
        max(screen.depth_mip_count, 1u) - 1u);
    trace.mip = 0u;
    return trace;
}

VkrSsgiReceiver vkr_ssgi_empty_receiver()
{
    VkrSsgiReceiver result;
    result.pixel = uint2(0u);
    result.positive_depth = 0.0f;
    result.valid = 0u;
    return result;
}

// Native base/trace/temporal/composite loops visit children in top-left order.
// Strict comparison retains that first child when depths tie.
// One current-frame selection per reduction cell. The final odd footprint is
// at most 3x3; the local offset and depth are bit-preserved in an RG32UI image.
float2 vkr_ssgi_pack_receiver(VkrSsgiReceiver receiver, uint2 trace_pixel)
{
    uint2 offset = receiver.pixel - trace_pixel * 2u;
    return receiver.valid != 0u
        ? float2(receiver.positive_depth, float(offset.y * 3u + offset.x))
        : float2(0.0f);
}

VkrSsgiReceiver vkr_ssgi_unpack_receiver(float2 metadata, uint2 trace_pixel)
{
    VkrSsgiReceiver receiver = vkr_ssgi_empty_receiver();
    if (vkr_ssr_valid_depth(metadata.x))
    {
        uint offset = uint(metadata.y);
        receiver.pixel = trace_pixel * 2u + uint2(offset % 3u, offset / 3u);
        receiver.positive_depth = metadata.x;
        receiver.valid = 1u;
    }
    return receiver;
}

VkrSsgiReceiver vkr_ssgi_consider_receiver(VkrSsgiReceiver result,
                                           uint2 pixel, float positive_depth,
                                           uint covered)
{
    if (covered != 0u && vkr_ssr_valid_depth(positive_depth) &&
        (result.valid == 0u || positive_depth < result.positive_depth))
    {
        result.pixel = pixel;
        result.positive_depth = positive_depth;
        result.valid = 1u;
    }
    return result;
}

// A view-space point on the camera ray through `uv`. The unprojected device
// depth 0.5 lies on the near side of reversed depth, where float32 keeps the
// ray direction exact.
float3 vkr_ssgi_camera_ray(VkrSsrParams screen, float2 uv)
{
    return vkr_ssr_reconstruct_view_position(screen, uv, 0.5f);
}

// The scale that moves `on_ray` (vkr_ssgi_camera_ray) to a positive view depth.
float vkr_ssgi_ray_depth_scale(float3 on_ray, float positive_depth)
{
    return positive_depth / max(-on_ray.z, VKR_SSGI_EPSILON);
}

// View position on the camera ray through `uv` at a positive view depth.
float3 vkr_ssgi_view_at_depth(VkrSsrParams screen, float2 uv,
                              float positive_depth)
{
    float3 on_ray = vkr_ssgi_camera_ray(screen, uv);
    return on_ray * vkr_ssgi_ray_depth_scale(on_ray, positive_depth);
}

float3 vkr_ssgi_faceforward_view_normal(float3 view_normal, float3 origin_view)
{
    return dot(view_normal, -origin_view) < 0.0f ? -view_normal : view_normal;
}

float vkr_ssgi_radical_inverse(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xaaaaaaaau) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xccccccccu) >> 2u);
    bits = ((bits & 0x0f0f0f0fu) << 4u) | ((bits & 0xf0f0f0f0u) >> 4u);
    bits = ((bits & 0x00ff00ffu) << 8u) | ((bits & 0xff00ff00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10f;
}

// Base-three radical inverse of a sequence index. Six digits cover every index
// below 729, which includes the whole 256-phase sequence.
float vkr_ssgi_radical_inverse_3(uint index)
{
    float result = 0.0f;
    float scale = 1.0f / 3.0f;
    [unroll]
    for (uint digit = 0u; digit < 6u; ++digit)
    {
        result += float(index % 3u) * scale;
        index /= 3u;
        scale *= 1.0f / 3.0f;
    }
    return result;
}

uint vkr_ssgi_hash(uint2 pixel)
{
    uint value = pixel.x * 0x8da6b343u ^ pixel.y * 0xd8163841u;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

// Halton(2, 3) over the 256-phase period. Any 2^a * 3^b consecutive phases put
// exactly one point in each 2^-a by 3^-b cell, so the short window the temporal
// average keeps covers elevation and azimuth evenly. Only a window that
// crosses the period's end loses the base-three strata.
float2 vkr_ssgi_sequence_2d(uint sample_phase)
{
    uint sequence_index = sample_phase & (VKR_SSGI_SEQUENCE_LENGTH - 1u);
    return float2(vkr_ssgi_radical_inverse(sequence_index),
                  vkr_ssgi_radical_inverse_3(sequence_index));
}

// A per-pixel Cranley-Patterson rotation decorrelates neighbouring receivers
// and keeps each pixel's own sequence stratified.
float2 vkr_ssgi_sample_2d(uint2 pixel, uint sample_phase)
{
    uint hash = vkr_ssgi_hash(pixel);
    float2 rotation = float2(vkr_ssgi_radical_inverse(hash),
                             vkr_ssgi_radical_inverse(hash * 0x9e3779b9u));
    float2 result = vkr_ssgi_sequence_2d(sample_phase) + rotation;
    return result - floor(result);
}

float3 vkr_ssgi_normalize_or(float3 value, float3 fallback)
{
    float length_squared = dot(value, value);
    return length_squared > 1e-12f ? value * rsqrt(length_squared) : fallback;
}

float3 vkr_ssgi_cosine_direction(float2 sample, float3 normal_view)
{
    float3 normal = vkr_ssgi_normalize_or(normal_view, float3(0.0f, 0.0f, 1.0f));
    float3 axis = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f)
                                           : float3(0.0f, 1.0f, 0.0f);
    float3 tangent = vkr_ssgi_normalize_or(cross(axis, normal), float3(1.0f, 0.0f, 0.0f));
    float3 bitangent = cross(normal, tangent);
    float radius = sqrt(saturate(sample.x));
    float angle = VKR_SSGI_TWO_PI * sample.y;
    float2 disk = radius * float2(cos(angle), sin(angle));
    return tangent * disk.x + bitangent * disk.y +
           normal * sqrt(max(1.0f - sample.x, 0.0f));
}

bool vkr_ssgi_hit_valid(uint covered, float hierarchy_depth,
                         float ray_depth, float3 hit_view_normal,
                         float3 ray_direction_view, float thickness)
{
    return covered != 0u && vkr_ssr_valid_depth(hierarchy_depth) &&
           vkr_ssr_valid_depth(ray_depth) &&
           abs(hierarchy_depth - ray_depth) <= thickness &&
           dot(hit_view_normal, -ray_direction_view) > VKR_SSGI_NEAR_EPSILON;
}

// For p(w)=cos(theta)/pi, Li * cos(theta)/pi / p(w) is Li. The composite owns
// the receiver's diffuse BRDF, so raw SSGI stores this bare E/pi estimator. A
// non-finite source texel, such as an emissive past the half-float range,
// contributes nothing rather than an undefined max().
float3 vkr_ssgi_bare_diffuse_estimate(float3 direct_source_radiance)
{
    return vkr_ssgi_finite(direct_source_radiance)
        ? max(direct_source_radiance, float3(0.0f))
        : float3(0.0f);
}

float vkr_ssgi_trace_confidence(float2 hit_uv, VkrSsrParams screen)
{
    return vkr_ssr_edge_confidence(hit_uv, screen);
}

// Bilateral weight of a neighbouring receiver for the temporal 3x3 filter and
// the composite upsample; positions and normals share one space. A neighbour
// on the centre receiver's tangent plane keeps its weight at any depth
// difference, so grazing floors and far terrain still filter. One further off
// that plane than the tolerance, or facing more than 60 degrees away, is
// another surface. The slope tolerance scales the separation the centre's
// plane predicts at the neighbour's pixel (vkr_ssr_plane_separation), so a
// floor seen past a counter's edge cannot widen its own tolerance. The compact
// spatial term is 1 / (1 + squared distance).
float vkr_ssgi_plane_weight(float2 offset, float3 center_position,
                            float3 center_normal, float3 neighbor_position,
                            float3 neighbor_normal, float minimum_tolerance)
{
    float3 separation = neighbor_position - center_position;
    float plane_distance = abs(dot(center_normal, separation));
    float tolerance = max(minimum_tolerance,
                          VKR_SSGI_PLANE_SLOPE *
                              vkr_ssr_plane_separation(center_position,
                                                       center_normal,
                                                       neighbor_position));
    float plane_weight = saturate(1.0f - plane_distance / tolerance);
    float normal_weight =
        saturate((dot(center_normal, neighbor_normal) - 0.5f) * 2.0f);
    float spatial_weight = 1.0f / (1.0f + dot(offset, offset));
    float weight = plane_weight * normal_weight * spatial_weight;
    return vkr_ssr_finite(weight) ? weight : 0.0f;
}

// Positive depth at which the camera ray through `uv` meets the plane through
// `position` with `normal`, all in view space; zero when the ray runs parallel
// to the plane or meets it behind the camera.
float vkr_ssgi_plane_depth(VkrSsrParams screen, float3 position,
                           float3 normal, float2 uv)
{
    float3 ray = vkr_ssgi_view_at_depth(screen, uv, 1.0f);
    float denominator = dot(normal, ray);
    if (abs(denominator) <= VKR_SSGI_EPSILON)
        return 0.0f;
    float depth = dot(normal, position) / denominator;
    return vkr_ssr_valid_depth(depth) ? depth : 0.0f;
}

// Previous positive depth that the receiver's tangent plane predicts at a
// history tap. `tap_uv` is the tap centre moved back by the receiver's motion
// into the current raster. The plane's relative depth change from the receiver
// to that point scales the receiver's own previous depth, so taps on a grazing
// surface compare against their own depth rather than the receiver's.
float vkr_ssgi_history_tap_depth(VkrSsrParams screen, float3 position,
                                 float3 normal, float previous_depth,
                                 float2 tap_uv)
{
    float current_depth = -position.z;
    float plane_depth = vkr_ssgi_plane_depth(screen, position, normal, tap_uv);
    if (!vkr_ssr_valid_depth(current_depth) ||
        !vkr_ssr_valid_depth(previous_depth) || plane_depth <= 0.0f)
        return 0.0f;
    return previous_depth * (plane_depth / current_depth);
}

// Largest depth change of the receiver's tangent plane from the receiver at
// `uv` to its four axis neighbours one trace texel away: the placement range
// of a stored receiver, which lies anywhere in its 2x2 cell. Both sides are
// probed because the plane recedes faster on one of them. A probe past the
// plane's horizon, where the plane has no depth, takes the cap: the
// receiver's own depth, which also bounds a plane almost parallel to the ray.
float vkr_ssgi_texel_depth_change(VkrSsrParams screen, float3 position,
                                  float3 normal, float2 uv, float2 texel,
                                  float positive_depth)
{
    float change = 0.0f;
    [unroll]
    for (uint probe = 0u; probe < 4u; ++probe)
    {
        float side = (probe & 1u) == 0u ? 1.0f : -1.0f;
        float2 offset = probe < 2u ? float2(side * texel.x, 0.0f)
                                   : float2(0.0f, side * texel.y);
        float depth = vkr_ssgi_plane_depth(screen, position, normal, uv + offset);
        change = max(change, depth > 0.0f ? abs(depth - positive_depth)
                                          : positive_depth);
    }
    return min(change, positive_depth);
}

// Each bilinear history tap proves its own stable identity and its depth
// against the plane prediction. `placement_tolerance` covers the stored
// receiver's unknown offset inside its 2x2 trace cell.
bool vkr_ssgi_history_tap_accepted(VkrSsrParams screen, uint2 current_identity,
                                   uint2 history_identity, float history_depth,
                                   float expected_depth,
                                   float placement_tolerance, bool in_bounds,
                                   float motion_validity)
{
    float allowed_depth_error =
        max(screen.temporal_depth_absolute,
            screen.temporal_depth_relative * expected_depth) +
        placement_tolerance;
    return screen.history_valid != 0u && current_identity.x != 0u &&
           all(current_identity == history_identity) && in_bounds &&
           motion_validity > 0.5f && vkr_ssr_valid_depth(history_depth) &&
           vkr_ssr_valid_depth(expected_depth) &&
           abs(history_depth - expected_depth) <= allowed_depth_error;
}

// Weighted mean luminance of a 3x3 neighbourhood without one of its samples:
// `luminance_sum` and `weight_sum` cover all samples, `luminance` and
// `weight` the excluded one. Zero when no other sample has weight.
float vkr_ssgi_other_mean_luminance(float luminance_sum, float weight_sum,
                                    float luminance, float weight)
{
    float other_weight = weight_sum - weight;
    return other_weight > 0.0f
        ? max(luminance_sum - weight * luminance, 0.0f) / other_weight
        : 0.0f;
}

// Scales one raw sample down to its firefly bound, keeping its hue: the larger
// of VKR_SSGI_FIREFLY_MEAN_SCALE times `reference_luminance` and the
// luminance at which the sample's `share` of the filtered estimate (its weight
// over the neighbourhood's, in (0, 1]) adds VKR_SSGI_FIREFLY_DISPLAY_SHARE of
// displayed luminance (`display_exposure_scale` maps pre-exposed to displayed
// radiance). The reference excludes the sample itself, so a lone hit far
// above its neighbours and its receiver's history adds at most the display
// share whatever its radiance; dense bright bounce raises the other samples'
// mean, and bright bounce that persists raises the history, so both pass.
float3 vkr_ssgi_firefly_clamp(float3 radiance, float reference_luminance,
                              float share, float display_exposure_scale)
{
    float bound = max(VKR_SSGI_FIREFLY_MEAN_SCALE * reference_luminance,
                      VKR_SSGI_FIREFLY_DISPLAY_SHARE /
                          (share * display_exposure_scale));
    float luminance = vkr_exposure_luminance(radiance);
    return luminance > bound ? radiance * (bound / luminance) : radiance;
}

// History retention factor for an all-miss neighbourhood, from the accepted
// share of its bilinear history footprint. History that every tap still
// supports keeps the retention: one all-miss phase of a sparse hit field is a
// valid zero-valued Monte-Carlo sample, also while the camera pans, and
// dropping history there would darken it. Where the receiver's motion
// disoccluded part of the footprint, the rest decays faster, toward
// VKR_SSGI_EMPTY_RETENTION_MOVING without support.
float vkr_ssgi_empty_retention(float history_support)
{
    return vkr_ssr_lerp(VKR_SSGI_EMPTY_RETENTION_MOVING, 1.0f,
                        saturate(history_support));
}

// `current.w` is zero when no valid ray sample reached this receiver's
// neighbourhood: every ray exhausted its decisions, or no receiver there has
// material AO to trace. Accepted history then carries over, fading by
// VKR_SSGI_UNANSWERED_RETENTION per frame. `weight` already includes the
// history's bilinear support. Where the neighbourhood holds energy, a
// two-sigma box bounds stale history without a second-moments image.
float4 vkr_ssgi_temporal_filter(float4 current, float3 history,
                                float3 neighborhood_mean,
                                float3 neighborhood_variance, float weight,
                                float empty_retention)
{
    if (current.w <= 0.0f)
        return float4(history * VKR_SSGI_UNANSWERED_RETENTION, 1.0f);
    float3 sigma = sqrt(max(neighborhood_variance, float3(0.0f)));
    float peak = max(neighborhood_mean.x,
                     max(neighborhood_mean.y, neighborhood_mean.z));
    float3 retained = peak > VKR_SSGI_EPSILON
        ? clamp(history, max(neighborhood_mean - 2.0f * sigma, float3(0.0f)),
                neighborhood_mean + 2.0f * sigma)
        : history * empty_retention;
    return float4(vkr_ssr_lerp(current.rgb, retained, weight), 1.0f);
}

// Composite adds a diffuse residual. It does not receive GTAO, IBL controls,
// SSR receiver weighting, or any baked-volume response; those terms either
// belong to independent transport or would apply visibility twice.
float3 vkr_ssgi_add_diffuse(float3 opaque_hdr, float3 bare_radiance,
                            float3 diffuse_weight, float3 diffuse_albedo,
                            float material_ao, float confidence)
{
    return opaque_hdr + bare_radiance * diffuse_weight * diffuse_albedo *
                            saturate(material_ao) * saturate(confidence);
}

#endif
