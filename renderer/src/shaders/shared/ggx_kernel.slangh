// Zero means no direct contribution. Keep subnormal lengths out of rsqrt so
// denormal flushing cannot turn an almost opposite pair into a NaN. Preserve
// the existing shading-normal policy for finite directions with N.V <= 0.
float vkr_direct_half_vector_inverse_length(float no_l, float3 half_vector)
{
    if (no_l <= 0.0f)
        return 0.0f;
    float length_squared = dot(half_vector, half_vector);
    if (length_squared < 1.175494351e-38f)
        return 0.0f;
    return rsqrt(length_squared);
}

// Materials store perceptual roughness r; GGX width is alpha = r^2.
// Normal variance broadens alpha^2, then converts back to perceptual roughness.
float vkr_ggx_filter_roughness(float roughness, float normal_variance)
{
    float alpha = roughness * roughness;
    return sqrt(sqrt(saturate(alpha * alpha + min(normal_variance, 0.25f))));
}


// Shared GGX normal distribution for direct lighting and the IBL sampling PDF.
float vkr_ggx_distribution(float no_h, float roughness)
{
    // Zero-roughness IBL samples mip zero; retain a finite distribution
    // for that dispatch. Shaded materials already have a 0.04 roughness floor.
    float alpha = max(roughness * roughness, 1e-6f);
    float cosine = clamp(no_h, 0.0f, 1.0f);
    // Factoring 1-cosine^2 preserves the alpha^2 term near the lobe's peak.
    // alpha > 0 proves the denominator positive without clipping the lobe.
    float denominator = (1.0f - cosine) * (1.0f + cosine) +
                        alpha * alpha * cosine * cosine;
    float ratio = alpha / denominator;
    return ratio * ratio * (1.0f / 3.14159265358979323846f);
}
