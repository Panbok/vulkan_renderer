// Analytic scene-linear height fog. Native passes own reconstruction, storage
// and dispatch; this header owns only finite radiance and optical-depth math.

#ifndef VKR_SHADER_FOG_KERNEL_SLANGH
#define VKR_SHADER_FOG_KERNEL_SLANGH

#define VKR_FOG_MAX_OPTICAL_DEPTH 80.0f
#define VKR_FOG_LOG_LIMIT 1e20f

struct VkrFogParams
{
    // rgb: scene-linear equilibrium radiance, w: base-height extinction.
    float4 color_density;
    // x: base height, y: nonnegative height falloff, z: surface cap,
    // w: finite sky distance. All distances are world units.
    float4 height_distance;
    // x: gray single-scattering albedo of a medium lit by the atmosphere, zero
    // for the constant colour; y: sun-lobe Henyey-Greenstein anisotropy.
    float4 sky_lighting;
};

// Light a sky-lit medium scatters: the attenuated sun toward `sun_direction`
// and the sky light's average radiance.
struct VkrFogLighting
{
    float3 sun_direction;
    float3 sun_irradiance;
    float3 sky_ambient;
};

struct VkrFogSample
{
    float transmittance;
    float inscatter_weight;
};

float vkr_fog_optical_depth(VkrFogParams params, float camera_height,
                            float ray_height_direction, float distance)
{
    float density = params.color_density.w;
    float travelled = distance;
    if (density <= 0.0f || travelled <= 0.0f)
        return 0.0f;

    float falloff = params.height_distance.y;
    float base_relative_height = camera_height - params.height_distance.x;
    // Integrate rho(s)=rho0*exp(-falloff*(height+s*ray_y)) in log space.
    // This preserves a far denser endpoint on descending rays and never forms
    // density*exp(large), which can otherwise become inf/inf before clamping.
    float log_start_density = log(density) +
        clamp(-falloff * base_relative_height, -VKR_FOG_LOG_LIMIT,
              VKR_FOG_LOG_LIMIT);
    float exponent = clamp(falloff * ray_height_direction * travelled,
                           -VKR_FOG_LOG_LIMIT, VKR_FOG_LOG_LIMIT);
    float log_ratio;
    // log((1-exp(-x))/x), with a series near the horizontal limit.
    if (abs(exponent) <= 1e-3f)
        log_ratio = log(max(1.0f - 0.5f * exponent, 1e-20f));
    else if (exponent > 0.0f)
        log_ratio = log(max(1.0f - exp(-exponent), 1e-20f)) - log(exponent);
    else
    {
        float downward = -exponent;
        // expm1(downward) is evaluated as exp(downward)-1 only where finite.
        log_ratio = downward < 50.0f
                        ? log(exp(downward) - 1.0f) - log(downward)
                        : downward +
                              log(max(1.0f - exp(-downward), 1e-20f)) -
                              log(downward);
    }
    float log_optical_depth = clamp(log_start_density + log(travelled) +
                                        log_ratio,
                                    -VKR_FOG_LOG_LIMIT, VKR_FOG_LOG_LIMIT);
    if (log_optical_depth >= log(VKR_FOG_MAX_OPTICAL_DEPTH))
        return VKR_FOG_MAX_OPTICAL_DEPTH;
    return max(exp(log_optical_depth), 0.0f);
}

// Henyey-Greenstein phase normalized over the sphere. `cosine` is
// dot(camera-to-sample, sample-to-light), so positive values scatter forward.
float vkr_fog_phase_hg(float g, float cosine)
{
    float g2 = g * g;
    float denominator = max(1.0f + g2 - 2.0f * g * cosine, 1e-6f);
    return (1.0f - g2) /
           (4.0f * 3.14159265358979323846f * denominator * sqrt(denominator));
}

// Equilibrium in-scatter radiance along a unit view ray: the authored
// constant colour, or the sun and sky light scattered by a gray medium.
float3 vkr_fog_inscatter(VkrFogParams params, VkrFogLighting lighting,
                         float3 ray_direction)
{
    float albedo = params.sky_lighting.x;
    if (albedo <= 0.0f)
        return params.color_density.rgb;
    float phase = vkr_fog_phase_hg(params.sky_lighting.y,
                                   dot(ray_direction, lighting.sun_direction));
    return albedo * (lighting.sky_ambient + lighting.sun_irradiance * phase);
}

VkrFogSample vkr_fog_sample(VkrFogParams params, float camera_height,
                             float ray_height_direction, float distance)
{
    float optical_depth = vkr_fog_optical_depth(
        params, camera_height, ray_height_direction, distance);
    VkrFogSample result;
    result.transmittance = exp(-optical_depth);
    result.inscatter_weight = 1.0f - result.transmittance;
    return result;
}

float3 vkr_fog_apply_sample(float3 radiance, float3 inscatter,
                            VkrFogSample sample)
{
    return radiance * sample.transmittance +
           inscatter * sample.inscatter_weight;
}

// `feedback_weight` is the per-channel coefficient of an already-fogged
// ordered background. Its complement alone receives this layer's in-scatter.
float3 vkr_fog_apply_local_over_feedback(float3 local_radiance,
                                          float3 feedback_weight,
                                          float3 inscatter,
                                          VkrFogSample sample)
{
    return local_radiance * sample.transmittance +
           inscatter * sample.inscatter_weight * (1.0f - feedback_weight);
}

float3 vkr_fog_direction(float3 ray)
{
    return ray * rsqrt(max(dot(ray, ray), 1e-12f));
}

VkrFogSample vkr_fog_surface_sample(VkrFogParams params,
                                    float3 camera_position,
                                    float3 world_position)
{
    float3 camera_to_surface = world_position - camera_position;
    float distance_squared = dot(camera_to_surface, camera_to_surface);
    if (distance_squared <= 1e-12f)
        return vkr_fog_sample(params, camera_position.y, 0.0f, 0.0f);
    float world_distance = sqrt(distance_squared);
    float distance = min(world_distance, params.height_distance.z);
    if (distance <= 0.0f)
        return vkr_fog_sample(params, camera_position.y, 0.0f, 0.0f);
    float3 direction = camera_to_surface / world_distance;
    return vkr_fog_sample(params, camera_position.y, direction.y, distance);
}

float3 vkr_fog_apply_surface(float3 radiance, VkrFogParams params,
                             VkrFogLighting lighting, float3 camera_position,
                             float3 world_position)
{
    float3 inscatter = vkr_fog_inscatter(
        params, lighting, vkr_fog_direction(world_position - camera_position));
    return vkr_fog_apply_sample(
        radiance, inscatter,
        vkr_fog_surface_sample(params, camera_position, world_position));
}

VkrFogSample vkr_fog_sky_sample(VkrFogParams params, float3 camera_position,
                                float3 ray_direction)
{
    float direction_length_squared = dot(ray_direction, ray_direction);
    if (direction_length_squared <= 1e-12f)
        return vkr_fog_sample(params, camera_position.y, 0.0f, 0.0f);
    float3 direction = ray_direction * rsqrt(direction_length_squared);
    float distance = params.height_distance.w;
    return vkr_fog_sample(params, camera_position.y, direction.y, distance);
}

float3 vkr_fog_apply_sky(float3 radiance, VkrFogParams params,
                         VkrFogLighting lighting, float3 camera_position,
                         float3 ray_direction)
{
    float3 inscatter = vkr_fog_inscatter(params, lighting,
                                         vkr_fog_direction(ray_direction));
    return vkr_fog_apply_sample(
        radiance, inscatter,
        vkr_fog_sky_sample(params, camera_position, ray_direction));
}

#endif
