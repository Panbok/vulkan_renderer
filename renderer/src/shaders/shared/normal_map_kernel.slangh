// Shared tangent-space normal decode for all production material paths.
// NORMAL_RG textures may transcode to BC5 or EAC RG11, whose sampled blue
// channel is zero. Reconstructing the positive hemisphere from XY keeps those
// formats equivalent to widened RGBA targets on both backends.
float3 vkr_instance_transform_normal(float3 column0, float3 column1,
                                      float3 column2, float3 normal)
{
    return column0 * normal.x + column1 * normal.y + column2 * normal.z;
}

float3 vkr_normal_map_decode(float3 encoded, float strength)
{
    float2 xy = encoded.xy * 2.0f - 1.0f;
    float z = sqrt(saturate(1.0f - dot(xy, xy)));
    xy *= strength;
    xy.y = -xy.y;
    float3 normal = float3(xy, z);
    float length_squared = dot(normal, normal);
    return length_squared > 1e-12f
        ? normal * rsqrt(length_squared)
        : float3(0.0f, 0.0f, 1.0f);
}
