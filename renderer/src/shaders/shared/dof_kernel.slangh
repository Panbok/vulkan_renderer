// Thin-lens optics and circular gather weights shared by native production
// paths.
#ifndef VKR_DOF_KERNEL_SLANGH
#define VKR_DOF_KERNEL_SLANGH
struct VkrDofGpuParams {
  float4
      lens; // Output-pixel radius scale, focus metres, near metres, far metres.
  float4 depth_uv;  // Canonical output UV to current opaque-depth UV.
  uint4 dimensions; // Full width/height, half width/height.
};
float vkr_dof_radius(VkrDofGpuParams params, float depth, bool sky) {
  return clamp(sky ? params.lens.x
                   : params.lens.x * (1.0f - params.lens.y / depth),
               -16.0f, 16.0f);
}
// Equal-area disk positions include the center for isolated HDR texels.
#if defined(__METAL_VERSION__)
constant float2 vkr_dof_disk_positions[32] = {
