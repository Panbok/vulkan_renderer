float2 vkr_dof_disk(uint index) { return vkr_dof_disk_positions[index]; }
float vkr_dof_coverage(float radius) {
  return clamp(abs(radius) - 0.5f, 0.0f, 1.0f);
}
float vkr_dof_disk_weight(float radius, float distance) {
  return clamp(radius - distance + 0.5f, 0.0f, 1.0f);
}
