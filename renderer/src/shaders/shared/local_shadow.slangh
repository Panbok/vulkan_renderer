#ifndef VKR_LOCAL_SHADOW_SHARED
#define VKR_LOCAL_SHADOW_SHARED

struct VkrLocalShadowView {
#if defined(__METAL_VERSION__)
    float4x4 light_view_projection;
#else
    column_major float4x4 light_view_projection;
#endif
    float4 light_position_near;
    float4 light_direction_far;
    float4 projection_params;
    // x: shadow strength in [0, 1], shared by every face of the light.
    // y: the face's transmission layer plus one, or zero.
    // z: one when the light takes a single filtered tap and no contact
    // shadows.
    // w: the light's source radius over 2 tan(half FOV), in face UV per unit
    // of forward distance; zero keeps the fixed filter radius.
    float4 shadow_params;
    // The face's atlas square: xy corner and z side in atlas UV, w the layer.
    float4 atlas_rect;
};

// Atlas coordinates of a face UV. Clamping half a face texel inside the
// square keeps bilinear comparison taps off neighbouring faces.
float2 vkr_local_shadow_atlas_uv(float4 atlas_rect, float face_texel, float2 uv)
{
    float2 inset = clamp(uv, 0.5f * face_texel, 1.0f - 0.5f * face_texel);
    return atlas_rect.xy + inset * atlas_rect.z;
}

// Blends one light's shadow visibility toward unshadowed as its strength falls,
// so a light entering or leaving the shadowed set changes continuously.
float3 vkr_local_shadow_apply_strength(float3 visibility, float strength) {
    return 1.0f - strength * (1.0f - visibility);
}

// Whether a light can reach a surface's base lobes. Diffuse, specular, sheen
// and a coat sharing the base normal all vanish unless the light lies in front
// of the shadow normal, which back-lit diffuse transmission flips toward the
// light. Receivers neither filter nor give a mask slot to a light that fails.
bool vkr_local_shadow_light_faces(float3 shadow_normal, float3 light_direction)
{
    return dot(shadow_normal, light_direction) > 0.0f;
}

uint vkr_local_shadow_face(float3 direction) {
    float3 a = abs(direction);
    if (a.x >= a.y && a.x >= a.z) return direction.x >= 0.0f ? 0u : 1u;
    if (a.y >= a.z) return direction.y >= 0.0f ? 2u : 3u;
    return direction.z >= 0.0f ? 4u : 5u;
}

float3 vkr_local_shadow_forward(uint face) {
    switch (face) {
    case 0u: return float3(1, 0, 0);
    case 1u: return float3(-1, 0, 0);
    case 2u: return float3(0, 1, 0);
    case 3u: return float3(0, -1, 0);
    case 4u: return float3(0, 0, 1);
    default: return float3(0, 0, -1);
    }
}

float3 vkr_local_shadow_up(uint face) {
    return (face == 2u || face == 3u) ? float3(0, 0, 1) : float3(0, 1, 0);
}

// Comparison depth of a tap that stays inside its cube face, at the receiver's
// radial distance from the light. Its face ray f + r * p.x - u * p.y has unit
// forward component, so the forward distance is radial / |ray|; depth follows
// from the face clip terms (origin z, axis z, origin w, axis w), which the
// caller projects once per lookup. Equivalent to projecting the tap's point.
float vkr_local_shadow_in_face_depth(float4 clip_terms, float radial_distance,
                                     float2 uv) {
    float2 p = uv * 2.0f - 1.0f;
    float forward = radial_distance * rsqrt(1.0f + dot(p, p));
    return (clip_terms.x + forward * clip_terms.y) /
           (clip_terms.z + forward * clip_terms.w);
}

// UV follows canonical projection's negative Y scale. UV may lie outside the
// face: reconstructing its ray allows the caller to sample the adjacent face.
float3 vkr_local_shadow_direction(uint face, float2 uv) {
    float3 f = vkr_local_shadow_forward(face);
    float3 u = vkr_local_shadow_up(face);
    float3 r = cross(f, u);
    float2 p = uv * 2.0f - 1.0f;
    return f + r * p.x - u * p.y;
}

// Shadow.LocalMask stores the k-th shadowed, in-range light of a pixel, in
// light traversal order, in layer k, so the layer count bounds the shadowed
// lights overlapping one pixel rather than the shadowed lights in the frame.
// Matches VKR_LOCAL_SHADOW_MASK_LAYER_COUNT and the graph's mask layers.
#define VKR_LOCAL_SHADOW_MASK_SLOT_COUNT 8u

// Alpha tags each stored slot with its light, index plus one over 255, which
// RGBA8 unorm stores exactly for the 128-light table. A receiver whose slot
// tag names another light, because the slot overflowed or a range or cone
// test differed at a boundary, filters that light inline instead.
float vkr_local_shadow_mask_tag(uint light_index)
{
    return float(light_index + 1u) / 255.0f;
}

bool vkr_local_shadow_mask_tag_matches(float tag, uint light_index)
{
    return uint(tag * 255.0f + 0.5f) == light_index + 1u;
}

// Fully filtered lights take the first VKR_LOCAL_SHADOW_FILTER_TAP_COUNT
// entries of the progressive Poisson table, unrotated. Under temporal
// reconstruction Shadow.LocalMask takes the first
// VKR_LOCAL_SHADOW_TEMPORAL_TAP_COUNT instead, rotated per pixel and frame, and
// TAA integrates the rotations into a disk.
#define VKR_LOCAL_SHADOW_FILTER_TAP_COUNT 9u
#define VKR_LOCAL_SHADOW_TEMPORAL_TAP_COUNT 4u

// Forward and transmission shading filter full-filter lights inline with the
// first four progressive taps, unrotated: they shade few pixels, and in the
// Bistro views nine taps changed at most 0.04% of pixels by more than 2 of
// 255 while costing 0.4 ms more transmission shading.
#define VKR_LOCAL_SHADOW_INLINE_TAP_COUNT 4u

// Tap rotation (cosine, sine) from interleaved gradient noise over the pixel,
// shifted each frame by the temporal noise index.
float2 vkr_local_shadow_tap_rotation(uint2 pixel, uint noise_index)
{
    float2 position = float2(pixel) + 5.588238f * float(noise_index);
    float gradient = dot(position, float2(0.06711056f, 0.00583715f));
    gradient -= floor(gradient);
    float value = 52.9829189f * gradient;
    value -= floor(value);
    float angle = value * 6.28318530718f;
    return float2(cos(angle), sin(angle));
}

// Rotates one Poisson tap by a (cosine, sine) pair.
float2 vkr_local_shadow_rotate_tap(float2 tap, float2 rotation)
{
    return float2(tap.x * rotation.x - tap.y * rotation.y,
                  tap.x * rotation.y + tap.y * rotation.x);
}

// Radius of the full filter's Poisson disk in face texels without
// contact-hardening.
#define VKR_LOCAL_SHADOW_FILTER_RADIUS_TEXELS 1.5f

// Contact-hardening for the full-filter lights in Shadow.LocalMask, when the
// light authors a source radius (shadow_params.w, the radius over twice the
// face's tan(half FOV)). The blocker search reads raw depths at the first
// progressive Poisson taps: all of them unrotated without temporal
// reconstruction, the first four rotated with it.
#define VKR_LOCAL_SHADOW_PCSS_BLOCKER_COUNT 8u
#define VKR_LOCAL_SHADOW_PCSS_TEMPORAL_BLOCKER_COUNT 4u
// Caps the search and filter radii in face texels. A blocker's projected
// offset from the receiver equals the filter radius it produces, so a search
// capped at the filter cap still finds every blocker that can widen it.
#define VKR_LOCAL_SHADOW_PCSS_MAX_RADIUS_TEXELS 8.0f

// Forward distance along the face axis of a stored face depth; inverts the
// clip terms vkr_local_shadow_in_face_depth projects with.
float vkr_local_shadow_forward_distance(float4 clip_terms, float depth)
{
    return (clip_terms.x - depth * clip_terms.z) /
           (depth * clip_terms.w - clip_terms.y);
}

// By similar triangles from a light disk of radius r, a receiver at forward
// distance d_r sees blockers no farther from its projection than
// r (d_r - n) / (2 t n d_r) face UV, where n is the near distance and t the
// face's tan(half FOV). `source_radius_uv` is r / (2 t).
float vkr_local_shadow_pcss_search_radius_texels(float source_radius_uv,
                                                 float near_distance,
                                                 float receiver_forward,
                                                 float face_texel)
{
    float radius_uv = source_radius_uv *
        max(receiver_forward - near_distance, 0.0f) /
        (near_distance * receiver_forward);
    return clamp(radius_uv / face_texel, VKR_LOCAL_SHADOW_FILTER_RADIUS_TEXELS,
                 VKR_LOCAL_SHADOW_PCSS_MAX_RADIUS_TEXELS);
}

// Penumbra radius at the receiver, r (d_r - d_b) / (2 t d_b d_r) face UV for
// an average blocker at forward distance d_b, never narrower than the fixed
// filter.
float vkr_local_shadow_pcss_filter_radius_texels(float source_radius_uv,
                                                 float blocker_forward,
                                                 float receiver_forward,
                                                 float face_texel)
{
    float radius_uv = source_radius_uv *
        max(receiver_forward - blocker_forward, 0.0f) /
        (blocker_forward * receiver_forward);
    return clamp(radius_uv / face_texel, VKR_LOCAL_SHADOW_FILTER_RADIUS_TEXELS,
                 VKR_LOCAL_SHADOW_PCSS_MAX_RADIUS_TEXELS);
}

// Atlas texel of a face UV for raw depth reads, clamped inside the face's
// square. The square's corner texel is atlas_rect.xy over one atlas texel,
// which is atlas_rect.z times the face texel.
float2 vkr_local_shadow_atlas_texel(float4 atlas_rect, float face_texel,
                                    float2 uv)
{
    float face_size = 1.0f / face_texel;
    float2 face_pixel = clamp(floor(uv * face_size), 0.0f, face_size - 1.0f);
    float2 corner = floor(atlas_rect.xy / (atlas_rect.z * face_texel) + 0.5f);
    return corner + face_pixel;
}

// Fixed-point units per fully lit pixel in the per-light contribution
// counters; matches the host's VKR_LOCAL_LIGHT_CONTRIBUTION_SCALE.
#define VKR_LOCAL_LIGHT_CONTRIBUTION_SCALE 256u

// One pixel's visible contribution of a light, unshadowed: its luminance at
// the surface after pre-exposure, x, compressed to x / (1 + x) so a few bright
// pixels cannot outweigh a lit area.
float vkr_local_light_contribution(float3 color, float intensity,
                                   float attenuation, float n_dot_l,
                                   float pre_exposure)
{
    float lit = dot(color, float3(0.2126f, 0.7152f, 0.0722f)) * intensity *
                attenuation * saturate(n_dot_l) * pre_exposure;
    return lit / (1.0f + lit);
}

// A light whose vkr_local_light_contribution at a pixel, taken with the
// shadow normal, falls below this takes no Shadow.LocalMask slot and no
// deferred shading. Both kernels apply the same test with the same inputs, so
// their slots stay in step; forward and transmission shading keep every light.
// In the Bistro views at most 41 lit pixels changed by more than 2 of 255.
#define VKR_LOCAL_LIGHT_CONTRIBUTION_CUTOFF 0.001f

// Contact shadows march VKR_LOCAL_SHADOW_CONTACT_STEPS depth-buffer samples
// along at most VKR_LOCAL_SHADOW_CONTACT_LENGTH metres toward a shadowed light.
// They recover occlusion near contacts that the shadow map's filter radius,
// normal offset and bias remove.
#define VKR_LOCAL_SHADOW_CONTACT_STEPS 8u
#define VKR_LOCAL_SHADOW_CONTACT_LENGTH 0.25f

// March start offset in [0, 1): an R2 sequence over the pixel, advanced by the
// temporal noise index so TAA integrates the step pattern.
float vkr_local_shadow_contact_noise(uint2 pixel, uint noise_index)
{
    float value = 0.5f + float(pixel.x) * 0.7548776662f +
                  float(pixel.y) * 0.5698402910f +
                  float(noise_index) * 0.6180339887f;
    return value - floor(value);
}

// Distance from the receiver along its shadow normal at which the march
// starts, so the receiver's own depth does not occlude it.
float vkr_local_shadow_contact_start_offset(float camera_distance)
{
    return 0.01f + 0.004f * camera_distance;
}

// A march sample is occluded when the depth-buffer surface on its camera ray
// lies in front of it by more than depth precision but less than the assumed
// occluder thickness. Both scale with camera distance.
bool vkr_local_shadow_contact_occluded(float surface_in_front,
                                       float camera_distance)
{
    return surface_in_front > 0.004f * camera_distance &&
           surface_in_front < 0.03f + 0.005f * camera_distance;
}

// Visibility after the first occluded sample at march fraction t: occluders in
// the far half of the ray fade out so the ray's end leaves no hard line.
float vkr_local_shadow_contact_visibility(float t)
{
    return saturate(2.0f * t - 1.0f);
}

#endif
