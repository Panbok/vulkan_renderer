// Portable current-frame screen-space reflection math.
//
// Native roots own texture access, bindings, and dispatch. This header owns
// coordinate/depth conventions, hierarchy decisions, GGX lobe sampling, ray
// reuse, confidence, temporal acceptance and the algebra that replaces
// environment/probe specular.
// Canonical UV is top-left. The renderer is right handed with forward -Z, and
// every hierarchy/history depth is positive view depth (`-view.z`); zero marks
// no covered opaque surface. `params.view` transforms world-space G-buffer
// normals before reflection. The independent SSR pyramid is current-frame only.
//
// Each rough receiver traces one GGX visible-normal sample of its lobe; a
// mirror receiver traces its exact mirror ray. The temporal pass reuses the
// rays of neighbouring receivers with BRDF/pdf ratio weights, so its incoming
// radiance converges to the normalized lobe integral that the environment
// prefilter also represents, and the composite applies the same receiver
// response to both.

#ifndef VKR_SHADER_SSR_KERNEL_SLANGH
#define VKR_SHADER_SSR_KERNEL_SLANGH

#define VKR_SSR_MAX_STEPS 48u
#define VKR_SSR_EPSILON 1e-6f
#define VKR_SSR_NEAR_EPSILON 1e-4f
#define VKR_SSR_PI 3.14159265358979323846f
// View-space normal offset only for reconstructed-receiver self separation.
// It is deliberately independent of the depth-hit slab (`params.thickness`).
#define VKR_SSR_RAY_ORIGIN_BIAS 1e-3f
// RGBA16F stores authored 0.04 as this value. At or below it a receiver
// traces its exact mirror ray and reuses no neighbouring ray.
#define VKR_SSR_MIRROR_ROUGHNESS 0.040008544921875f
// Coverage fades to zero over this roughness span below the cutoff, so a
// valid hit on any rougher receiver fully replaces the environment term and
// the eligibility boundary itself is continuous.
#define VKR_SSR_ROUGHNESS_FADE_SPAN 0.15f
// Receiver-plane tolerance for ray reuse: the 2 cm floor, and a neighbour
// further off the centre's tangent plane than this fraction of the separation
// the plane predicts at its pixel, about 14 degrees of tilt, is another
// surface.
#define VKR_SSR_RECEIVER_DEPTH_ABSOLUTE 0.02f
#define VKR_SSR_PLANE_SLOPE 0.25f
// Neighbouring rays a rough receiver reuses besides its own, on a rotated
// Vogel spiral whose radius grows with roughness. The radius keeps the former
// rough filter's physical width; the per-pixel, per-frame rotation covers a
// contiguous footprint instead of fixed parity lattices.
#define VKR_SSR_REUSE_TAP_COUNT 8u
#define VKR_SSR_REUSE_RADIUS_MIN_PIXELS 1.0f
#define VKR_SSR_REUSE_RADIUS_MAX_PIXELS 3.0f
#define VKR_SSR_GOLDEN_ANGLE 2.39996322972865332f
// Bound on one reused ray's BRDF/pdf ratio. A ray of a neighbouring lobe's
// tail that lands in this lobe's peak would otherwise dominate the ratio
// estimator; the own sample's ratio G2/G1 never exceeds one.
#define VKR_SSR_REUSE_WEIGHT_MAX 4.0f
// Reflected-hit reprojection follows the virtual image below this roughness
// and blends to surface motion at the end of the span: a wide lobe blurs the
// image over more than its parallax.
#define VKR_SSR_PARALLAX_ROUGHNESS_BEGIN 0.15f
#define VKR_SSR_PARALLAX_ROUGHNESS_END 0.4f
// A frame whose reused rays found no hit briefly holds an image-like
// reflection whose absence those rays cannot prove: a mirror's ray that ran
// out of hierarchy decisions, and a glossy lobe (reflection parallax above
// zero) whose rays could still miss a real reflection. The held coverage
// halves on every such frame and returns to the environment term at or below
// the floor, so a run of these frames ends within four frames. A rough lobe's
// plausible all-miss frame is an ordinary sample of zero coverage instead,
// and known misses that refute part of its coverage also end at the floor.
#define VKR_SSR_HOLD_RETENTION 0.5f
#define VKR_SSR_HOLD_COVERAGE_MIN 0.0625f
// Known misses refute a rough receiver's history once its rays expected more
// than this many hits: n known rays at history coverage c expect n * c hits
// and all miss with Poisson probability exp(-n * c), here below 5 %.
#define VKR_SSR_DECISIVE_EXPECTED_HITS 3.0f
// Largest finite RGBA16F value; raw and history radiance are half floats.
#define VKR_SSR_HALF_MAX 65504.0f
// Device depths of the two points that span a camera ray. Both lie on the
// near side under forward and under reversed depth (ADR-109), so neither is
// the far plane, where float32 loses the ray's direction.
#define VKR_SSR_RAY_DEVICE_DEPTH_A 0.75f
#define VKR_SSR_RAY_DEVICE_DEPTH_B 0.5f

// Ray record states in the trace's RGBA32UI image (vkr_ssr_pack_hit,
// vkr_ssr_pack_ray). NONE: the receiver traced no lobe ray. MISS: the ray
// left the screen or its distance without a hit. UNKNOWN: the ray ran out of
// hierarchy decisions, so neither a hit nor a miss is known.
#define VKR_SSR_RAY_NONE 0u
#define VKR_SSR_RAY_MISS 1u
#define VKR_SSR_RAY_UNKNOWN 2u
#define VKR_SSR_RAY_HIT 3u

// What a history tap must match besides its transported receiver plane and
// normal: a moved receiver its receiver instance, a moved receiver or
// reflected instance the reflected instance, and the reflected-hit candidate
// its virtual depth.
#define VKR_SSR_MATCH_RECEIVER_IDENTITY 1u
#define VKR_SSR_MATCH_HIT_IDENTITY 2u
#define VKR_SSR_MATCH_VIRTUAL_DEPTH 4u
// Interpolated FP32 UV can land exactly on a stored cell boundary whose floor()
// selects the exited cell. An epsilon restart then moves UV by less than one
// ulp on short segments, and nearly axis-aligned rays stall for more than the
// step budget. Such a restart moves this many source pixels past the boundary
// instead, along the segment's major screen axis: enough to clear the rounding,
// and never enough to jump over a cell the ray still occupies on that axis.
#define VKR_SSR_RESTART_PIXELS 0.015625f

struct VkrSsrParams
{
    float4x4 projection;
    float4x4 inverse_projection;
    float4x4 view;

    uint source_width;
    uint source_height;
    uint trace_width;
    uint trace_height;

    uint depth_mip_count;
    uint max_steps;
    uint history_valid;
    uint reserved_u32_0;

    float thickness;
    float max_distance;
    float roughness_cutoff;
    float edge_fade_pixels;

    float temporal_weight;
    float temporal_depth_relative;
    float temporal_depth_absolute;
    float reserved_float_0;

    float previous_projection_m22;
    float previous_projection_m23;
    float previous_projection_m32;
    float previous_projection_m33;

    float trace_texel_size_x;
    float trace_texel_size_y;
    float history_jitter_uv_x;
    float history_jitter_uv_y;
};

// Only the temporal pass needs camera transport. Both matrices belong to the
// current frame and the exact selected history producer respectively.
struct VkrSsrReprojectionParams
{
    float4x4 inverse_view;
    float4x4 previous_view;
};

struct VkrSsrSurface
{
    float3 position;
    float3 normal;
    uint valid;
};

// Positive depth at which the camera rays of one projection meet a view-space
// plane. Perspective and orthographic projections never weigh x or y into the
// homogeneous w, so a ray's two points are affine in projection UV and one
// preparation serves every history tap. Each lane holds (value at the image
// centre, d/du, d/dv): expanding about the centre keeps the small lateral
// offsets of near-axis rays free of cancellation.
struct VkrSsrPlaneDepth
{
    float3 numerator;
    float3 denominator;
    float3 first_depth;
    float3 depth_span;
    float grazing;
    uint valid;
};

// Every candidate of one receiver shares its transported receiver plane
// (VkrSsrPlaneDepth), which the caller prepares once and passes to each
// history tap.
struct VkrSsrReflectedHit
{
    float2 previous_uv;
    float expected_receiver_depth;
    float expected_virtual_depth;
    float current_virtual_depth;
    uint valid;
};

// One trace ray as its RGBA32UI record stores it.
struct VkrSsrRay
{
    uint state;
    // Solid-angle pdf of the traced direction; zero for a mirror ray.
    float pdf;
    float2 hit_uv;
    float hit_depth;
    uint hit_visible;
    // View-space direction of a miss or unknown ray.
    float3 direction;
};

// A receiver's GGX reflection lobe in view space, prepared once per pixel.
struct VkrSsrLobe
{
    float3 normal;
    float3 tangent;
    float3 bitangent;
    float3 view;
    // GGX widths along tangent and bitangent (alpha = roughness^2).
    float2 alpha;
    float no_v;
    // sqrt(alpha_t^2 v_t^2 + alpha_b^2 v_b^2 + v_n^2): Smith's view term.
    float view_root;
    uint valid;
};

// Ratio-estimator sums over reused rays. `covered` and `radiance` weigh hit
// coverage; `known` adds misses; `total` adds rays of unknown outcome.
// `known_rays` counts the rays of known outcome.
struct VkrSsrResolve
{
    float3 radiance;
    float covered;
    float known;
    float total;
    uint known_rays;
};

struct VkrSsrTrace
{
    float2 start_uv;
    float2 end_uv;
    float start_depth;
    float end_depth;
    float start_clip_w;
    float end_clip_w;
    float t;
    uint mip;
    uint max_mip;
    uint active;
};

struct VkrSsrProjectedPoint
{
    float2 uv;
    float positive_depth;
    float clip_w;
    uint valid;
};

struct VkrSsrClipRange
{
    float begin;
    float end;
    uint valid;
    float reserved_float_0;
};

// Leaving the current hierarchy cell. `t` bounds the cell's depth interval;
// `restart_t` is the parameter the next traversal step evaluates.
struct VkrSsrCellExit
{
    float t;
    float restart_t;
};

struct VkrSsrTraceResolve
{
    uint hit;
    uint descend;
    uint advance;
    float depth_confidence;
    float hit_t;
};

struct VkrSsrHistoryDecision
{
    uint accepted;
    // Retention after motion, roughness and history support.
    float weight;
    float expected_previous_depth;
    // Accepted share of the history footprint, in [0, 1].
    float support;
    // Surface-motion fallback for a reflection that had a reflected-hit
    // candidate: clamp without the rough residual.
    uint tight;
};

VkrSsrTrace vkr_ssr_empty_trace()
{
    VkrSsrTrace result;
    result.start_uv = 0.0f;
    result.end_uv = 0.0f;
    result.start_depth = 0.0f;
    result.end_depth = 0.0f;
    result.start_clip_w = 0.0f;
    result.end_clip_w = 0.0f;
    result.t = 0.0f;
    result.mip = 0u;
    result.max_mip = 0u;
    result.active = 0u;
    return result;
}

float vkr_ssr_saturate(float value)
{
    return clamp(value, 0.0f, 1.0f);
}

// MSL uses matrix-vector operators and `mix`; Slang's Vulkan target uses HLSL
// `mul` and `lerp`. Keep that spelling difference local to this header.
float4 vkr_ssr_matrix_vector(float4x4 matrix, float4 value)
{
#if defined(__METAL_VERSION__)
    return matrix * value;
#else
    return mul(matrix, value);
#endif
}

float vkr_ssr_lerp(float a, float b, float t)
{
#if defined(__METAL_VERSION__)
    return mix(a, b, t);
#else
    return lerp(a, b, t);
#endif
}

float2 vkr_ssr_lerp(float2 a, float2 b, float t)
{
#if defined(__METAL_VERSION__)
    return mix(a, b, t);
#else
    return lerp(a, b, t);
#endif
}

float3 vkr_ssr_lerp(float3 a, float3 b, float t)
{
#if defined(__METAL_VERSION__)
    return mix(a, b, t);
#else
    return lerp(a, b, t);
#endif
}

float4 vkr_ssr_lerp(float4 a, float4 b, float t)
{
#if defined(__METAL_VERSION__)
    return mix(a, b, t);
#else
    return lerp(a, b, t);
#endif
}

bool vkr_ssr_finite(float value)
{
    return value == value && abs(value) < 3.402823466e+38f;
}

bool vkr_ssr_finite3(float3 value)
{
    return vkr_ssr_finite(value.x) && vkr_ssr_finite(value.y) &&
           vkr_ssr_finite(value.z);
}

// Radiance a half-float image can hold: a non-finite value, such as an
// emissive past the RGBA16F range, becomes zero so one texel cannot spread
// through the gather and history; finite values saturate at the format
// maximum instead of rounding to infinity on store.
float3 vkr_ssr_storable(float3 radiance)
{
    return vkr_ssr_finite3(radiance)
               ? clamp(radiance, float3(0.0f), float3(VKR_SSR_HALF_MAX))
               : float3(0.0f);
}

bool vkr_ssr_valid_depth(float positive_view_depth)
{
    return vkr_ssr_finite(positive_view_depth) && positive_view_depth > 0.0f;
}

bool vkr_ssr_depth_hit_matches(float ray_depth, float surface_depth,
                                 VkrSsrParams params)
{
    // Permit only floating-point reconstruction error ahead of the surface.
    float roundoff = VKR_SSR_EPSILON * max(surface_depth, 1.0f);
    return vkr_ssr_valid_depth(ray_depth) && vkr_ssr_valid_depth(surface_depth) &&
           ray_depth >= surface_depth - roundoff &&
           ray_depth <= surface_depth + params.thickness;
}

uint vkr_ssr_reduced_extent(uint extent)
{
    return extent > 1u ? extent / 2u : extent;
}

float2 vkr_ssr_uv_from_pixel(uint2 pixel, uint2 extent)
{
    return (float2(pixel) + 0.5f) / float2(extent);
}

float3 vkr_ssr_homogeneous_position(float4 value)
{
    float reciprocal_w = 1.0f / max(abs(value.w), VKR_SSR_EPSILON);
    return value.xyz * reciprocal_w * (value.w < 0.0f ? -1.0f : 1.0f);
}

float3 vkr_ssr_reconstruct_view_position(VkrSsrParams params, float2 uv,
                                          float device_depth)
{
    float2 ndc = uv * 2.0f - 1.0f;
    return vkr_ssr_homogeneous_position(
        vkr_ssr_matrix_vector(params.inverse_projection,
                              float4(ndc, device_depth, 1.0f)));
}

VkrSsrProjectedPoint vkr_ssr_project_view_position(VkrSsrParams params,
                                                    float3 view_position)
{
    VkrSsrProjectedPoint result;
    result.uv = 0.0f;
    result.positive_depth = 0.0f;
    result.clip_w = 0.0f;
    result.valid = 0u;
    float4 clip = vkr_ssr_matrix_vector(params.projection,
                                         float4(view_position, 1.0f));
    result.positive_depth = -view_position.z;
    if (!vkr_ssr_valid_depth(result.positive_depth) || !vkr_ssr_finite(clip.w) ||
        abs(clip.w) <= VKR_SSR_EPSILON)
        return result;
    result.uv = clip.xy / clip.w * 0.5f + 0.5f;
    result.clip_w = clip.w;
    result.valid = all(result.uv == result.uv) &&
                           all(abs(result.uv) < 3.402823466e+38f)
                       ? 1u
                       : 0u;
    return result;
}

// The base pass calls this over all valid children in a 2x2 footprint, except
// at the final floor-half cell where a dimension may contribute three children.
// Zero/invalid samples do not participate, so min positive depth is a
// conservative nearest surface for a forward -Z camera.
float vkr_ssr_depth_reduce(float d0, float d1, float d2, float d3,
                           float d4, float d5, float d6, float d7,
                           float d8, uint child_count)
{
    float result = 3.402823466e+38f;
    if (child_count > 0u && vkr_ssr_valid_depth(d0)) result = min(result, d0);
    if (child_count > 1u && vkr_ssr_valid_depth(d1)) result = min(result, d1);
    if (child_count > 2u && vkr_ssr_valid_depth(d2)) result = min(result, d2);
    if (child_count > 3u && vkr_ssr_valid_depth(d3)) result = min(result, d3);
    if (child_count > 4u && vkr_ssr_valid_depth(d4)) result = min(result, d4);
    if (child_count > 5u && vkr_ssr_valid_depth(d5)) result = min(result, d5);
    if (child_count > 6u && vkr_ssr_valid_depth(d6)) result = min(result, d6);
    if (child_count > 7u && vkr_ssr_valid_depth(d7)) result = min(result, d7);
    if (child_count > 8u && vkr_ssr_valid_depth(d8)) result = min(result, d8);
    return result == 3.402823466e+38f ? 0.0f : result;
}

uint vkr_ssr_reduction_child_begin(uint destination_cell)
{
    return destination_cell * 2u;
}

// Floor-half resources give the final destination cell the remaining child
// pixels. At a 5-wide parent, two children own [0,2) and [2,5), rather than
// dropping index four or pretending each child is uniformly 2-wide.
uint vkr_ssr_reduction_child_end(uint destination_cell,
                                 uint destination_extent,
                                 uint source_extent)
{
    uint begin = vkr_ssr_reduction_child_begin(destination_cell);
    return destination_cell + 1u == destination_extent
               ? source_extent
               : min(begin + 2u, source_extent);
}

// Bounds are expressed in full-resolution pixels. Source shift zero is a
// single pixel; the final cell at every reduced level owns the odd tail.
float4 vkr_ssr_cell_bounds(uint2 cell, uint source_shift, uint2 source_extent,
                            uint2 mip_extent)
{
    uint2 begin = cell << source_shift;
    uint2 end = (cell + 1u) << source_shift;
    end.x = cell.x + 1u == mip_extent.x ? source_extent.x
                                         : min(end.x, source_extent.x);
    end.y = cell.y + 1u == mip_extent.y ? source_extent.y
                                         : min(end.y, source_extent.y);
    return float4(float2(begin) / float2(source_extent),
                  float2(end) / float2(source_extent));
}

float vkr_ssr_linearize_previous_depth(VkrSsrParams params, float device_depth)
{
    float denominator = device_depth * params.previous_projection_m32 -
                        params.previous_projection_m22;
    if (!vkr_ssr_finite(device_depth) || abs(denominator) <= VKR_SSR_EPSILON)
        return 0.0f;
    float view_z = (params.previous_projection_m23 -
                    device_depth * params.previous_projection_m33) /
                   denominator;
    float positive_depth = -view_z;
    return vkr_ssr_valid_depth(positive_depth) ? positive_depth : 0.0f;
}

bool vkr_ssr_eligible(float roughness, bool covered, VkrSsrParams params)
{
    return covered && vkr_ssr_finite(roughness) && roughness >= 0.0f &&
           roughness <= params.roughness_cutoff;
}

float vkr_ssr_trace_depth_at(VkrSsrTrace trace, float t)
{
    float reciprocal_w = vkr_ssr_lerp(1.0f / trace.start_clip_w,
                               1.0f / trace.end_clip_w, t);
    if (abs(reciprocal_w) <= VKR_SSR_EPSILON)
        return 0.0f;
    float view_z_over_w = vkr_ssr_lerp(-trace.start_depth / trace.start_clip_w,
                                -trace.end_depth / trace.end_clip_w, t);
    float positive_depth = -view_z_over_w / reciprocal_w;
    return vkr_ssr_valid_depth(positive_depth) ? positive_depth : 0.0f;
}

VkrSsrClipRange vkr_ssr_clip_axis(VkrSsrClipRange range, float start,
                                   float direction)
{
    if (range.valid == 0u)
        return range;
    if (abs(direction) <= VKR_SSR_EPSILON)
    {
        range.valid = start >= 0.0f && start <= 1.0f ? 1u : 0u;
        return range;
    }
    float t0 = -start / direction;
    float t1 = (1.0f - start) / direction;
    range.begin = max(range.begin, min(t0, t1));
    range.end = min(range.end, max(t0, t1));
    range.valid = range.begin <= range.end ? 1u : 0u;
    return range;
}

VkrSsrClipRange vkr_ssr_clip_uv_segment(float2 start_uv, float2 end_uv)
{
    VkrSsrClipRange result;
    result.begin = 0.0f;
    result.end = 1.0f;
    result.valid = 1u;
    result.reserved_float_0 = 0.0f;
    float2 direction = end_uv - start_uv;
    result = vkr_ssr_clip_axis(result, start_uv.x, direction.x);
    return vkr_ssr_clip_axis(result, start_uv.y, direction.y);
}

VkrSsrTrace vkr_ssr_trace_slice(VkrSsrTrace trace, float begin, float end)
{
    float2 uv_begin = vkr_ssr_lerp(trace.start_uv, trace.end_uv, begin);
    float2 uv_end = vkr_ssr_lerp(trace.start_uv, trace.end_uv, end);
    float start_depth = vkr_ssr_trace_depth_at(trace, begin);
    float end_depth = vkr_ssr_trace_depth_at(trace, end);
    float start_reciprocal_w = vkr_ssr_lerp(1.0f / trace.start_clip_w,
                                     1.0f / trace.end_clip_w, begin);
    float end_reciprocal_w = vkr_ssr_lerp(1.0f / trace.start_clip_w,
                                   1.0f / trace.end_clip_w, end);
    if (!vkr_ssr_valid_depth(start_depth) || !vkr_ssr_valid_depth(end_depth) ||
        abs(start_reciprocal_w) <= VKR_SSR_EPSILON ||
        abs(end_reciprocal_w) <= VKR_SSR_EPSILON)
    {
        trace.active = 0u;
        return trace;
    }
    trace.start_uv = uv_begin;
    trace.end_uv = uv_end;
    trace.start_depth = start_depth;
    trace.end_depth = end_depth;
    trace.start_clip_w = 1.0f / start_reciprocal_w;
    trace.end_clip_w = 1.0f / end_reciprocal_w;
    trace.t = 0.0f;
    return trace;
}

VkrSsrTrace vkr_ssr_trace_begin(VkrSsrParams params, float3 origin_view,
                                float3 direction_view, uint max_mip)
{
    VkrSsrTrace trace = vkr_ssr_empty_trace();
    if (!all(direction_view == direction_view) ||
        dot(direction_view, direction_view) <= VKR_SSR_EPSILON)
        return trace;

    direction_view = normalize(direction_view);
    float maximum_distance = params.max_distance;
    if (direction_view.z > VKR_SSR_EPSILON)
        maximum_distance = min(maximum_distance,
                               (-VKR_SSR_NEAR_EPSILON - origin_view.z) /
                                   direction_view.z);
    if (!(maximum_distance > VKR_SSR_EPSILON))
        return trace;

    VkrSsrProjectedPoint start =
        vkr_ssr_project_view_position(params, origin_view);
    VkrSsrProjectedPoint end = vkr_ssr_project_view_position(
        params, origin_view + direction_view * maximum_distance);
    if (start.valid == 0u || end.valid == 0u)
        return trace;

    trace.start_uv = start.uv;
    trace.end_uv = end.uv;
    trace.start_depth = start.positive_depth;
    trace.end_depth = end.positive_depth;
    trace.start_clip_w = start.clip_w;
    trace.end_clip_w = end.clip_w;
    trace.t = 0.0f;
    // Native callers supply the highest logical level of their depth source.
    trace.mip = max_mip;
    trace.max_mip = trace.mip;
    trace.active = 1u;
    VkrSsrClipRange clip_range = vkr_ssr_clip_uv_segment(start.uv, end.uv);
    if (clip_range.valid != 0u && clip_range.end > clip_range.begin)
        return vkr_ssr_trace_slice(trace, clip_range.begin, clip_range.end);
    return vkr_ssr_empty_trace();
}

float2 vkr_ssr_trace_uv(VkrSsrTrace trace)
{
    return vkr_ssr_lerp(trace.start_uv, trace.end_uv, trace.t);
}

float vkr_ssr_trace_depth(VkrSsrTrace trace)
{
    return vkr_ssr_trace_depth_at(trace, trace.t);
}

bool vkr_ssr_trace_in_bounds(VkrSsrTrace trace)
{
    float2 uv = vkr_ssr_trace_uv(trace);
    return all(uv >= 0.0f) && all(uv < 1.0f);
}

// Level cell containing `uv`. Source pixels clamp to the image, and the final
// cell of a floor-sized level owns the odd tail.
uint2 vkr_ssr_level_cell(float2 uv, uint2 mip_extent, uint source_shift,
                         VkrSsrParams params)
{
    uint2 source_extent = uint2(params.source_width, params.source_height);
    uint2 source_pixel = min(uint2(floor(uv * float2(source_extent))),
                             source_extent - 1u);
    return min(source_pixel >> source_shift, mip_extent - 1u);
}

// Boundary of `cell` that the segment leaves through on each axis, in UV.
float2 vkr_ssr_cell_exit_boundary(VkrSsrTrace trace, uint2 cell,
                                  uint2 mip_extent, uint source_shift,
                                  VkrSsrParams params)
{
    float2 direction = trace.end_uv - trace.start_uv;
    uint2 source_extent = uint2(params.source_width, params.source_height);
    float4 bounds = vkr_ssr_cell_bounds(cell, source_shift, source_extent, mip_extent);
    return float2(direction.x > 0.0f ? bounds.z : bounds.x,
                  direction.y > 0.0f ? bounds.w : bounds.y);
}

// Parameter distance that moves the projected segment VKR_SSR_RESTART_PIXELS
// along its faster screen axis. A segment shorter than that distance ends.
float vkr_ssr_trace_restart_step(VkrSsrTrace trace, VkrSsrParams params)
{
    float2 segment_pixels = abs(trace.end_uv - trace.start_uv) *
                            float2(float(params.source_width),
                                   float(params.source_height));
    float major_pixels = max(segment_pixels.x, segment_pixels.y);
    return VKR_SSR_RESTART_PIXELS / max(major_pixels, VKR_SSR_RESTART_PIXELS);
}

// First parameter the traversal evaluates after leaving `cell` at `exit_t`.
// The epsilon restart normally lands in the next cell and keeps entry hits at
// the boundary. When FP32 UV rounds it back into `cell`, restart a fixed
// sub-pixel distance past the boundary instead of re-testing the exited cell.
float vkr_ssr_trace_restart(VkrSsrTrace trace, float exit_t, uint2 cell,
                            uint2 mip_extent, uint source_shift,
                            VkrSsrParams params)
{
    float restart_t = min(exit_t + VKR_SSR_EPSILON, 1.0f);
    float2 restart_uv = vkr_ssr_lerp(trace.start_uv, trace.end_uv, restart_t);
    if (restart_t < 1.0f && all(restart_uv >= 0.0f) &&
        all(restart_uv < 1.0f) &&
        all(vkr_ssr_level_cell(restart_uv, mip_extent, source_shift, params) ==
            cell))
    {
        float restart_step =
            max(vkr_ssr_trace_restart_step(trace, params), VKR_SSR_EPSILON);
        restart_t = min(exit_t + restart_step, 1.0f);
    }
    return restart_t;
}

// A trace that is inactive or off screen restarts one epsilon ahead, which the
// following advance turns into termination.
VkrSsrCellExit vkr_ssr_cell_exit_in_place(VkrSsrTrace trace)
{
    VkrSsrCellExit result;
    result.t = trace.t;
    result.restart_t = min(trace.t + VKR_SSR_EPSILON, 1.0f);
    return result;
}

// SSR's logical level zero reads full-resolution depth; level one reads the
// existing half-resolution pyramid base. Crossing times are absolute along
// the projected segment, so the same boundary has the same time regardless
// of the hierarchy path used to reach it.
VkrSsrCellExit vkr_ssr_trace_cell_exit(VkrSsrTrace trace, uint2 mip_extent,
                                       VkrSsrParams params)
{
    if (trace.active == 0u || any(mip_extent == 0u) ||
        !vkr_ssr_trace_in_bounds(trace))
        return vkr_ssr_cell_exit_in_place(trace);
    uint2 cell = vkr_ssr_level_cell(vkr_ssr_trace_uv(trace), mip_extent,
                                    trace.mip, params);
    float2 boundary =
        vkr_ssr_cell_exit_boundary(trace, cell, mip_extent, trace.mip, params);
    float2 direction = trace.end_uv - trace.start_uv;
    float tx = abs(direction.x) > VKR_SSR_EPSILON
                   ? (boundary.x - trace.start_uv.x) / direction.x
                   : 3.402823466e+38f;
    float ty = abs(direction.y) > VKR_SSR_EPSILON
                   ? (boundary.y - trace.start_uv.y) / direction.y
                   : 3.402823466e+38f;
    VkrSsrCellExit result;
    result.t = min(max(min(tx, ty), trace.t), 1.0f);
    result.restart_t = vkr_ssr_trace_restart(trace, result.t, cell,
                                             mip_extent, trace.mip, params);
    return result;
}

bool vkr_ssr_trace_hit_matches_pixel(VkrSsrTrace trace, float hit_t,
                                      uint2 source_pixel, VkrSsrParams params)
{
    float2 hit_uv = vkr_ssr_lerp(trace.start_uv, trace.end_uv, hit_t);
    return all(int2(floor(hit_uv * float2(params.source_width, params.source_height))) ==
               int2(source_pixel));
}

// Re-ascending one level retains the projected DDA's bounded 48-step work.
VkrSsrTrace vkr_ssr_trace_advance(VkrSsrTrace trace, float restart_t)
{
    trace.t = restart_t;
    trace.mip = min(trace.mip + 1u, trace.max_mip);
    if (!(trace.t < 1.0f) || !vkr_ssr_trace_in_bounds(trace))
        trace.active = 0u;
    return trace;
}

VkrSsrTraceResolve vkr_ssr_trace_resolve_interval(VkrSsrTrace trace,
                                                  float hierarchy_depth,
                                                  float front_depth,
                                                  float back_depth,
                                                  float target_depth,
                                                  float cell_exit_t)
{
    VkrSsrTraceResolve result;
    result.hit = 0u;
    result.descend = 0u;
    result.advance = 0u;
    result.depth_confidence = 0.0f;
    result.hit_t = 0.0f;
    if (trace.active == 0u || !vkr_ssr_valid_depth(hierarchy_depth))
    {
        result.advance = trace.active;
        return result;
    }

    if (!(cell_exit_t > trace.t))
    {
        result.advance = 1u;
        return result;
    }
    float entry_depth = vkr_ssr_trace_depth(trace);
    VkrSsrTrace exit_trace = trace;
    exit_trace.t = cell_exit_t;
    float exit_depth = vkr_ssr_trace_depth(exit_trace);
    float depth_min = min(entry_depth, exit_depth);
    float depth_max = max(entry_depth, exit_depth);
    if (depth_max < front_depth)
    {
        result.advance = 1u;
        return result;
    }
    if (trace.mip > 0u)
    {
        result.descend = 1u;
        return result;
    }
    if (depth_min <= back_depth)
    {
        result.hit = 1u;
        target_depth = clamp(target_depth, depth_min, depth_max);
        float low_t = trace.t;
        float high_t = cell_exit_t;
        // Positive depth is Q(t) / K(t), where both terms are affine over the
        // projected segment. Solve Q(t) = target_depth * K(t) directly: this
        // is exact for both perspective projection and the affine/orthographic
        // equal-W case. A constant-depth segment has no unique crossing, so
        // its verified cell entry is the stable representative.
        float q0 = trace.start_depth / trace.start_clip_w;
        float dq = trace.end_depth / trace.end_clip_w - q0;
        float k0 = 1.0f / trace.start_clip_w;
        float dk = 1.0f / trace.end_clip_w - k0;
        float denominator = dq - target_depth * dk;
        if (abs(denominator) <= VKR_SSR_EPSILON)
            result.hit_t = low_t;
        else
            result.hit_t = clamp((target_depth * k0 - q0) / denominator,
                                 low_t, high_t);
        // The hierarchy only proposes a leaf candidate. Its residual within
        // the accepted slab is DDA grid phase, not fractional coverage: the
        // native trace validates full-resolution depth and facing before it
        // publishes this result. Edge and roughness still attenuate a valid
        // reflection, but a valid planar hit must retain full confidence.
        result.depth_confidence = 1.0f;
        return result;
    }
    result.advance = 1u;
    return result;
}

VkrSsrTraceResolve vkr_ssr_trace_resolve(VkrSsrTrace trace,
                                         float hierarchy_depth,
                                         float cell_exit_t,
                                         VkrSsrParams params)
{
    // Thickness extends behind the surface. Expanding toward the camera
    // invents hits in empty space and repeatedly descends onto the receiver.
    float back_depth = hierarchy_depth + params.thickness;
    // Select the earliest point in the slab, including rays already inside
    // it and rays entering its rear boundary while traveling toward the eye.
    float target_depth = clamp(vkr_ssr_trace_depth(trace), hierarchy_depth, back_depth);
    return vkr_ssr_trace_resolve_interval(trace, hierarchy_depth, hierarchy_depth,
                                          back_depth, target_depth, cell_exit_t);
}

VkrSsrTrace vkr_ssr_trace_descend(VkrSsrTrace trace)
{
    if (trace.mip > 0u)
        --trace.mip;
    return trace;
}

float vkr_ssr_edge_confidence(float2 hit_uv, VkrSsrParams params)
{
    if (params.edge_fade_pixels <= 0.0f)
        return 1.0f;
    float2 source_extent = float2(params.source_width, params.source_height);
    float edge_pixels = min(min(hit_uv.x, 1.0f - hit_uv.x) * source_extent.x,
                            min(hit_uv.y, 1.0f - hit_uv.y) * source_extent.y);
    return vkr_ssr_saturate(edge_pixels / params.edge_fade_pixels);
}

// Receiver roughness across [mirror, cutoff], zero at or below the mirror.
float vkr_ssr_normalized_roughness(float roughness, VkrSsrParams params)
{
    float span = max(params.roughness_cutoff - VKR_SSR_MIRROR_ROUGHNESS,
                     VKR_SSR_EPSILON);
    return vkr_ssr_saturate((roughness - VKR_SSR_MIRROR_ROUGHNESS) / span);
}

// Composite coverage scale of the receiver's packed roughness. A valid hit
// replaces the environment term fully up to VKR_SSR_ROUGHNESS_FADE_SPAN below
// the cutoff; the scale then falls linearly to zero at the cutoff, matching
// the ineligible receivers beyond it.
float vkr_ssr_roughness_confidence(float roughness, VkrSsrParams params)
{
    float begin = max(params.roughness_cutoff - VKR_SSR_ROUGHNESS_FADE_SPAN,
                      VKR_SSR_MIRROR_ROUGHNESS);
    float span = max(params.roughness_cutoff - begin, VKR_SSR_EPSILON);
    return vkr_ssr_saturate((params.roughness_cutoff - roughness) / span);
}

// Coverage of one valid hit: the screen-edge fade at the hit and the
// hierarchy's depth confidence. Roughness fades at the receiver (composite).
float vkr_ssr_trace_confidence(float2 hit_uv, float depth_confidence,
                               VkrSsrParams params)
{
    return vkr_ssr_edge_confidence(hit_uv, params) *
           vkr_ssr_saturate(depth_confidence);
}

// Share of reflected-hit parallax in the reprojected point: one follows the
// virtual image of a glossy reflection, zero the receiver surface of a rough
// one, whose lobe blurs the image over more than its parallax.
float vkr_ssr_reflection_parallax(float roughness)
{
    float blend = vkr_ssr_saturate(
        (roughness - VKR_SSR_PARALLAX_ROUGHNESS_BEGIN) /
        (VKR_SSR_PARALLAX_ROUGHNESS_END - VKR_SSR_PARALLAX_ROUGHNESS_BEGIN));
    return 1.0f - blend * blend * (3.0f - 2.0f * blend);
}

float vkr_ssr_reuse_radius(float roughness, VkrSsrParams params)
{
    return vkr_ssr_lerp(VKR_SSR_REUSE_RADIUS_MIN_PIXELS,
                        VKR_SSR_REUSE_RADIUS_MAX_PIXELS,
                        vkr_ssr_normalized_roughness(roughness, params));
}

// Source-pixel offset of reuse tap `tap` below VKR_SSR_REUSE_TAP_COUNT: a
// Vogel spiral of `radius` turned by `rotation` turns. Every tap lies at least
// one pixel from the centre, so none rounds back onto the receiver's own ray.
int2 vkr_ssr_reuse_offset(uint tap, float radius, float rotation)
{
    float distance = max(
        radius * sqrt((float(tap) + 0.5f) / float(VKR_SSR_REUSE_TAP_COUNT)),
        1.0f);
    float angle = rotation * (2.0f * VKR_SSR_PI) +
                  float(tap) * VKR_SSR_GOLDEN_ANGLE;
    return int2(round(distance * float2(cos(angle), sin(angle))));
}

float vkr_ssr_reuse_spatial_weight(float2 offset, float radius)
{
    float2 scaled = offset / max(radius, 1.0f);
    return 1.0f / (1.0f + dot(scaled, scaled));
}

// Separation from `center_position` that the centre's tangent plane predicts
// at the neighbour's pixel: the distance to where the camera ray through
// `neighbor_position` meets that plane, which is the centre's own pixel
// footprint on the plane times the pixel offset. View-space positions with the
// camera at the origin; SSR and SSGI run only with perspective projections.
// The measured separation caps it, so a neighbour on the plane, including a
// far one on a grazing floor, keeps its own separation. A neighbour on another
// surface behind or in front gets the plane's short prediction instead: its
// distance from the plane can no longer widen its own tolerance. A ray that
// meets the plane behind the camera or not at all keeps the measured value.
float vkr_ssr_plane_separation(float3 center_position, float3 center_normal,
                               float3 neighbor_position)
{
    float measured = length(neighbor_position - center_position);
    float scale = dot(center_normal, center_position) /
                  dot(center_normal, neighbor_position);
    if (!(scale > 0.0f) || !vkr_ssr_finite(scale))
        return measured;
    return min(length(neighbor_position * scale - center_position), measured);
}

// Whether a neighbouring receiver lies on the centre's surface; positions and
// normals share one space. A neighbour on the centre's tangent plane keeps its
// weight at any depth difference, so grazing floors and water still reuse
// rays and history. One further off that plane than the tolerance, or facing
// more than 60 degrees away, is another surface. The slope tolerance scales
// the plane's predicted separation (vkr_ssr_plane_separation), never the
// measured one.
float vkr_ssr_receiver_plane_weight(float3 center_position,
                                    float3 center_normal,
                                    float3 neighbor_position,
                                    float3 neighbor_normal)
{
    float3 separation = neighbor_position - center_position;
    float plane_distance = abs(dot(center_normal, separation));
    float tolerance = max(VKR_SSR_RECEIVER_DEPTH_ABSOLUTE,
                          VKR_SSR_PLANE_SLOPE *
                              vkr_ssr_plane_separation(center_position,
                                                       center_normal,
                                                       neighbor_position));
    float plane_weight = vkr_ssr_saturate(1.0f - plane_distance / tolerance);
    float normal_weight = vkr_ssr_saturate(
        (dot(center_normal, neighbor_normal) - 0.5f) * 2.0f);
    float weight = plane_weight * normal_weight;
    return vkr_ssr_finite(weight) ? weight : 0.0f;
}

// `normal` and `view` are unit view-space vectors, `view` toward the camera.
// `axis` is the anisotropy direction, or zero for an isotropic lobe, whose
// tangent frame is then arbitrary. Widths follow the renderer's GGX: alpha is
// the squared perceptual roughness, stretched along `axis` by anisotropy.
VkrSsrLobe vkr_ssr_lobe(float3 normal, float3 view, float3 axis, float2 alpha)
{
    VkrSsrLobe lobe;
    lobe.normal = normal;
    lobe.view = view;
    lobe.alpha = max(alpha, float2(1e-4f));
    float3 tangent = axis - normal * dot(normal, axis);
    float length_squared = dot(tangent, tangent);
    if (!(length_squared > 1e-12f))
    {
        float3 up = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f)
                                           : float3(1.0f, 0.0f, 0.0f);
        tangent = cross(up, normal);
        length_squared = dot(tangent, tangent);
    }
    lobe.tangent = tangent * rsqrt(length_squared);
    lobe.bitangent = cross(normal, lobe.tangent);
    lobe.no_v = dot(normal, view);
    float2 projected = float2(dot(view, lobe.tangent),
                              dot(view, lobe.bitangent)) * lobe.alpha;
    lobe.view_root = sqrt(dot(projected, projected) + lobe.no_v * lobe.no_v);
    lobe.valid = lobe.no_v > 0.0f && vkr_ssr_finite(lobe.view_root) &&
                         vkr_ssr_finite3(lobe.tangent)
                     ? 1u
                     : 0u;
    return lobe;
}

// Anisotropic GGX normal distribution D(h) in the lobe's tangent frame.
float vkr_ssr_lobe_distribution(VkrSsrLobe lobe, float3 half_vector)
{
    float no_h = dot(lobe.normal, half_vector);
    if (!(no_h > 0.0f))
        return 0.0f;
    float3 stretched = float3(dot(lobe.tangent, half_vector) / lobe.alpha.x,
                              dot(lobe.bitangent, half_vector) / lobe.alpha.y,
                              no_h);
    float denominator = dot(stretched, stretched);
    return 1.0f / (VKR_SSR_PI * lobe.alpha.x * lobe.alpha.y * denominator *
                   denominator);
}

float3 vkr_ssr_half_vector(float3 view, float3 light)
{
    float3 half_vector = view + light;
    float length_squared = dot(half_vector, half_vector);
    return length_squared > 1e-12f ? half_vector * rsqrt(length_squared)
                                   : float3(0.0f);
}

// Reflected direction of one GGX visible-normal sample (Heitz 2018,
// "Sampling the GGX Distribution of Visible Normals"); `u` is uniform in
// [0, 1)^2. A rough lobe at a grazing view can return a direction below the
// surface; its lobe value is zero.
float3 vkr_ssr_lobe_sample(VkrSsrLobe lobe, float2 u)
{
    float3 view_local = float3(dot(lobe.view, lobe.tangent),
                               dot(lobe.view, lobe.bitangent), lobe.no_v);
    float3 stretched = normalize(float3(lobe.alpha.x * view_local.x,
                                        lobe.alpha.y * view_local.y,
                                        view_local.z));
    float length_squared = stretched.x * stretched.x + stretched.y * stretched.y;
    float3 first_axis = length_squared > 1e-12f
                            ? float3(-stretched.y, stretched.x, 0.0f) *
                                  rsqrt(length_squared)
                            : float3(1.0f, 0.0f, 0.0f);
    float3 second_axis = cross(stretched, first_axis);
    float radius = sqrt(u.x);
    float angle = 2.0f * VKR_SSR_PI * u.y;
    float p1 = radius * cos(angle);
    float p2 = radius * sin(angle);
    float visible = 0.5f * (1.0f + stretched.z);
    p2 = (1.0f - visible) * sqrt(max(1.0f - p1 * p1, 0.0f)) + visible * p2;
    float3 hemisphere = p1 * first_axis + p2 * second_axis +
                        sqrt(max(1.0f - p1 * p1 - p2 * p2, 0.0f)) * stretched;
    float3 local = normalize(float3(lobe.alpha.x * hemisphere.x,
                                    lobe.alpha.y * hemisphere.y,
                                    max(hemisphere.z, 0.0f)));
    float3 half_vector = local.x * lobe.tangent + local.y * lobe.bitangent +
                         local.z * lobe.normal;
    return 2.0f * dot(lobe.view, half_vector) * half_vector - lobe.view;
}

// Solid-angle pdf of vkr_ssr_lobe_sample's direction `light`:
// D(h) G1(v) / (4 N.V) = D(h) / (2 (N.V + view_root)).
float vkr_ssr_lobe_pdf(VkrSsrLobe lobe, float3 light)
{
    if (lobe.valid == 0u)
        return 0.0f;
    float pdf = vkr_ssr_lobe_distribution(
                    lobe, vkr_ssr_half_vector(lobe.view, light)) /
                (2.0f * (lobe.no_v + lobe.view_root));
    return vkr_ssr_finite(pdf) ? pdf : 0.0f;
}

// The lobe times N.L, D G2 / (4 N.V) with the renderer's height-correlated
// Smith G2, without the Fresnel and energy terms that the composite's
// receiver weight applies once to SSR and environment light alike.
float vkr_ssr_lobe_value(VkrSsrLobe lobe, float3 light)
{
    float no_l = dot(lobe.normal, light);
    if (lobe.valid == 0u || !(no_l > 0.0f))
        return 0.0f;
    float2 projected = float2(dot(light, lobe.tangent),
                              dot(light, lobe.bitangent)) * lobe.alpha;
    float light_root = sqrt(dot(projected, projected) + no_l * no_l);
    float value = vkr_ssr_lobe_distribution(
                      lobe, vkr_ssr_half_vector(lobe.view, light)) *
                  no_l /
                  (2.0f * (no_l * lobe.view_root + lobe.no_v * light_root));
    return vkr_ssr_finite(value) ? value : 0.0f;
}

// Ratio-estimator weight of a ray traced with `pdf` toward `light` from this
// receiver: its own sample weighs G2/G1(v), a neighbour's sample weighs this
// lobe against the neighbour's pdf. Zero pdf marks a deterministic mirror
// ray, which samples no lobe.
float vkr_ssr_reuse_weight(VkrSsrLobe lobe, float3 light, float pdf)
{
    if (!(pdf > 0.0f))
        return 0.0f;
    float weight = vkr_ssr_lobe_value(lobe, light) / pdf;
    return vkr_ssr_finite(weight) ? min(weight, VKR_SSR_REUSE_WEIGHT_MAX)
                                  : 0.0f;
}

VkrSsrResolve vkr_ssr_resolve_empty()
{
    VkrSsrResolve result;
    result.radiance = 0.0f;
    result.covered = 0.0f;
    result.known = 0.0f;
    result.total = 0.0f;
    result.known_rays = 0u;
    return result;
}

// RGB is incoming radiance and alpha coverage of one hit sample; misses carry
// no radiance and unknown rays neither radiance nor coverage.
VkrSsrResolve vkr_ssr_resolve_add(VkrSsrResolve sum, uint state,
                                  float4 hit_sample, float weight)
{
    if (state == VKR_SSR_RAY_NONE || !(weight > 0.0f))
        return sum;
    sum.total += weight;
    if (state == VKR_SSR_RAY_UNKNOWN)
        return sum;
    sum.known += weight;
    ++sum.known_rays;
    if (state == VKR_SSR_RAY_HIT)
    {
        float covered = weight * vkr_ssr_saturate(hit_sample.w);
        sum.radiance += hit_sample.xyz * covered;
        sum.covered += covered;
    }
    return sum;
}

// Share of the reused ray weight whose outcome is known; zero without rays.
float vkr_ssr_resolve_known_share(VkrSsrResolve sum)
{
    return sum.total > 0.0f ? vkr_ssr_saturate(sum.known / sum.total) : 0.0f;
}

// RGB is incoming radiance in both raw and reflection history,
// while alpha is hit coverage. A miss carries no radiance sample: include it in coverage support, never in the radiance
// denominator. Otherwise sparse hits become darker as their coverage changes.
float4 vkr_ssr_spatial_sample(float4 reflection, float receiver_weight)
{
    float covered_weight = receiver_weight * vkr_ssr_saturate(reflection.w);
    return float4(reflection.xyz * covered_weight, covered_weight);
}

// Geometry must identify the sample contributing the most incoming light to
// the filtered RGB. Coverage alone can select a dark sample while a neighboring
// lamp supplies nearly all of that RGB. Maximum RGB preserves saturated lights;
// coverage breaks equal-energy ties, including an entirely black neighborhood.
bool vkr_ssr_reprojection_sample_dominates(float4 contribution,
                                          float4 dominant_contribution)
{
    float radiance = max(contribution.x, max(contribution.y, contribution.z));
    float dominant_radiance = max(dominant_contribution.x,
        max(dominant_contribution.y, dominant_contribution.z));
    return radiance > dominant_radiance ||
           (radiance == dominant_radiance &&
            contribution.w > dominant_contribution.w);
}

float4 vkr_ssr_spatial_resolve(float4 weighted_reflection, float support_weight)
{
    if (weighted_reflection.w <= 0.0f || support_weight <= 0.0f)
        return 0.0f;
    return float4(weighted_reflection.xyz / weighted_reflection.w,
                  vkr_ssr_saturate(weighted_reflection.w / support_weight));
}

// Incoming radiance over covered weight; coverage over the known weight, so
// rays of unknown outcome neither darken nor thin the current estimate.
float4 vkr_ssr_resolve_reflection(VkrSsrResolve sum)
{
    return vkr_ssr_spatial_resolve(float4(sum.radiance, sum.covered),
                                   sum.known);
}

// Coverage-weighted Catmull-Rom history over a 4x4 footprint whose inner 2x2
// taps were all accepted. `cubic` and `bilinear` are the coverage-weighted
// sums (vkr_ssr_spatial_sample) over the 4x4 and the inner 2x2 footprints;
// `inner_min` and `inner_max` bound the inner taps' radiance (taps with
// coverage only) in xyz and their coverage in w. Negative outer lobes can
// cancel coverage at a coverage edge and divide the small remainder into
// radiance far above every tap. Below half the bilinear coverage the result
// is zero, and the bilinear resolve stands in; otherwise it stays inside the
// inner taps' range, as a bilinear result does, so ringing cannot brighten
// the rough residual or a held reflection.
float4 vkr_ssr_history_cubic(float4 cubic, float4 bilinear, float4 inner_min,
                             float4 inner_max)
{
    if (!(cubic.w > 1e-3f) || cubic.w < 0.5f * bilinear.w ||
        !(inner_max.w > 0.0f))
        return float4(0.0f);
    return float4(clamp(cubic.xyz / cubic.w, inner_min.xyz, inner_max.xyz),
                  clamp(cubic.w, inner_min.w, inner_max.w));
}

// Variance clip of current hit radiance for a fallback history: the mean plus
// or minus one standard deviation, inside the min/max box.
void vkr_ssr_tight_bounds(float3 mean, float3 mean_squared,
                          inout float3 neighborhood_min,
                          inout float3 neighborhood_max)
{
    float3 deviation = sqrt(max(mean_squared - mean * mean, float3(0.0f)));
    neighborhood_min = max(neighborhood_min, mean - deviation);
    neighborhood_max = min(neighborhood_max, mean + deviation);
}

// Motion excludes raster jitter, while SSR history remains on the raster grid.
float2 vkr_ssr_previous_uv(VkrSsrParams params, float2 current_uv, float2 motion)
{
    return current_uv + motion +
           float2(params.history_jitter_uv_x, params.history_jitter_uv_y);
}

float vkr_ssr_history_tap_weight(float2 coordinate, int2 pixel)
{
    float2 weight = max(1.0f - abs(float2(pixel) - coordinate), 0.0f);
    return weight.x * weight.y;
}

VkrSsrHistoryDecision vkr_ssr_temporal_accept(
    VkrSsrParams params, uint2 current_identity, uint2 history_identity,
    float history_depth, float previous_device_depth, float2 previous_uv,
    float motion_validity, uint2 history_extent)
{
    VkrSsrHistoryDecision result;
    result.accepted = 0u;
    result.weight = 0.0f;
    result.expected_previous_depth = 0.0f;
    result.support = 0.0f;
    result.tight = 0u;
    result.expected_previous_depth =
        vkr_ssr_linearize_previous_depth(params, previous_device_depth);
    float2 half_texel = 0.5f / float2(history_extent);
    bool in_bounds = all(previous_uv >= half_texel) &&
                     all(previous_uv <= 1.0f - half_texel);
    float allowed_depth_error =
        max(params.temporal_depth_absolute,
            params.temporal_depth_relative * result.expected_previous_depth);
    bool depth_matches = vkr_ssr_valid_depth(history_depth) &&
                         vkr_ssr_valid_depth(result.expected_previous_depth) &&
                         abs(history_depth - result.expected_previous_depth) <=
                             allowed_depth_error;
    result.accepted = params.history_valid != 0u && current_identity.x != 0u &&
                              all(current_identity == history_identity) && in_bounds &&
                              motion_validity > 0.5f && depth_matches
                          ? 1u
                          : 0u;
    result.weight = result.accepted != 0u ? params.temporal_weight : 0.0f;
    result.support = float(result.accepted);
    return result;
}

// A hit stores positive view depth rather than device depth. Interpolate the
// inverse-projected line so this also preserves orthographic projection. Both
// line points lie on the near side of the depth range (forward or reversed).
float3 vkr_ssr_view_from_positive_depth(VkrSsrParams params, float2 uv,
                                         float positive_depth)
{
    float3 a = vkr_ssr_reconstruct_view_position(
        params, uv, VKR_SSR_RAY_DEVICE_DEPTH_A);
    float3 b = vkr_ssr_reconstruct_view_position(
        params, uv, VKR_SSR_RAY_DEVICE_DEPTH_B);
    return a + (b - a) * ((-positive_depth - a.z) / (b.z - a.z));
}

// `point` and `normal` define the plane in view space; `normal` need not be
// unit length. Rays parallel to the plane within one part in 10^4 of their
// span, and intersections behind the camera, give depth zero.
VkrSsrPlaneDepth vkr_ssr_plane_depth_prepare(VkrSsrParams params, float3 point,
                                             float3 normal)
{
    float3 first_origin = vkr_ssr_reconstruct_view_position(
        params, float2(0.5f, 0.5f), VKR_SSR_RAY_DEVICE_DEPTH_A);
    float3 first_u = vkr_ssr_reconstruct_view_position(
        params, float2(1.5f, 0.5f), VKR_SSR_RAY_DEVICE_DEPTH_A) - first_origin;
    float3 first_v = vkr_ssr_reconstruct_view_position(
        params, float2(0.5f, 1.5f), VKR_SSR_RAY_DEVICE_DEPTH_A) - first_origin;
    float3 second_origin = vkr_ssr_reconstruct_view_position(
        params, float2(0.5f, 0.5f), VKR_SSR_RAY_DEVICE_DEPTH_B);
    float3 second_u = vkr_ssr_reconstruct_view_position(
        params, float2(1.5f, 0.5f), VKR_SSR_RAY_DEVICE_DEPTH_B) - second_origin;
    float3 second_v = vkr_ssr_reconstruct_view_position(
        params, float2(0.5f, 1.5f), VKR_SSR_RAY_DEVICE_DEPTH_B) - second_origin;
    float3 span_origin = second_origin - first_origin;
    float3 span_u = second_u - first_u;
    float3 span_v = second_v - first_v;
    VkrSsrPlaneDepth result;
    result.numerator = float3(dot(normal, point - first_origin),
                              -dot(normal, first_u), -dot(normal, first_v));
    result.denominator = float3(dot(normal, span_origin), dot(normal, span_u),
                                dot(normal, span_v));
    result.first_depth = float3(-first_origin.z, -first_u.z, -first_v.z);
    result.depth_span = float3(-span_origin.z, -span_u.z, -span_v.z);
    result.grazing = 1e-4f * length(span_origin) * length(normal);
    result.valid = vkr_ssr_finite3(result.numerator) &&
                           vkr_ssr_finite3(result.denominator) &&
                           vkr_ssr_finite3(result.first_depth) &&
                           vkr_ssr_finite3(result.depth_span) &&
                           result.grazing > 0.0f
                       ? 1u
                       : 0u;
    return result;
}

// Positive depth of the plane on the camera ray through projection `uv`.
float vkr_ssr_plane_depth_at(VkrSsrPlaneDepth plane, float2 uv)
{
    float3 basis = float3(1.0f, uv - 0.5f);
    float denominator = dot(plane.denominator, basis);
    if (plane.valid == 0u || !(abs(denominator) > plane.grazing))
        return 0.0f;
    float distance = dot(plane.numerator, basis) / denominator;
    float depth = dot(plane.first_depth, basis) +
                  dot(plane.depth_span, basis) * distance;
    return vkr_ssr_valid_depth(depth) ? depth : 0.0f;
}

// Current and retained models are affine. Cofactors avoid a general 4x4 inverse
// in this per-pixel path and also support nonuniform scale and mirrored models.
float4 vkr_ssr_transport_point(float3 position, float4x4 current_model,
                                float4x4 previous_model)
{
    float3 a = vkr_ssr_matrix_vector(current_model, float4(1, 0, 0, 0)).xyz;
    float3 b = vkr_ssr_matrix_vector(current_model, float4(0, 1, 0, 0)).xyz;
    float3 c = vkr_ssr_matrix_vector(current_model, float4(0, 0, 1, 0)).xyz;
    float3 t = vkr_ssr_matrix_vector(current_model, float4(0, 0, 0, 1)).xyz;
    float determinant = dot(a, cross(b, c));
    if (!vkr_ssr_finite(determinant) || abs(determinant) <= 1e-12f)
        return 0.0f;
    float3 delta = position - t;
    float3 local = float3(dot(delta, cross(b, c)), dot(delta, cross(c, a)),
                           dot(delta, cross(a, b))) / determinant;
    float3 previous = vkr_ssr_matrix_vector(previous_model, float4(local, 1)).xyz;
    bool finite = all(previous == previous) &&
                  all(abs(previous) < 3.402823466e+38f);
    return float4(previous, finite ? 1.0f : 0.0f);
}

VkrSsrSurface vkr_ssr_transport_surface(float3 position, float3 normal,
                                         float4x4 current_model,
                                         float4x4 previous_model)
{
    VkrSsrSurface result;
    float4 point = vkr_ssr_transport_point(position, current_model, previous_model);
    result.position = point.xyz;
    result.normal = 0.0f;
    result.valid = 0u;
    float3 a = vkr_ssr_matrix_vector(current_model, float4(1, 0, 0, 0)).xyz;
    float3 b = vkr_ssr_matrix_vector(current_model, float4(0, 1, 0, 0)).xyz;
    float3 c = vkr_ssr_matrix_vector(current_model, float4(0, 0, 1, 0)).xyz;
    float3 local_normal = float3(dot(a, normal), dot(b, normal), dot(c, normal));
    a = vkr_ssr_matrix_vector(previous_model, float4(1, 0, 0, 0)).xyz;
    b = vkr_ssr_matrix_vector(previous_model, float4(0, 1, 0, 0)).xyz;
    c = vkr_ssr_matrix_vector(previous_model, float4(0, 0, 1, 0)).xyz;
    float determinant = dot(a, cross(b, c));
    if (point.w == 0.0f || !vkr_ssr_finite(determinant) ||
        abs(determinant) <= 1e-12f)
        return result;
    float3 previous_normal = (cross(b, c) * local_normal.x +
                              cross(c, a) * local_normal.y +
                              cross(a, b) * local_normal.z) / determinant;
    float squared_length = dot(previous_normal, previous_normal);
    if (!vkr_ssr_finite(squared_length) || squared_length <= 1e-12f)
        return result;
    result.normal = previous_normal / sqrt(squared_length);
    result.valid = 1u;
    return result;
}

float2 vkr_ssr_encode_normal(float3 normal)
{
    normal /= abs(normal.x) + abs(normal.y) + abs(normal.z);
    float2 encoded = normal.xy;
    if (normal.z < 0.0f)
        encoded = (1.0f - abs(encoded.yx)) *
                    float2(encoded.x >= 0.0f ? 1.0f : -1.0f,
                            encoded.y >= 0.0f ? 1.0f : -1.0f);
    return encoded;
}

float3 vkr_ssr_decode_normal(float2 encoded)
{
    float3 normal = float3(encoded, 1.0f - abs(encoded.x) - abs(encoded.y));
    float correction = max(-normal.z, 0.0f);
    normal.x += normal.x >= 0.0f ? -correction : correction;
    normal.y += normal.y >= 0.0f ? -correction : correction;
    return normalize(normal);
}

uint vkr_ssr_pack_unorm2(float2 value)
{
    uint2 bits = uint2(round(clamp(value, 0.0f, 1.0f) * 65535.0f));
    return bits.x | (bits.y << 16u);
}

float2 vkr_ssr_unpack_unorm2(uint bits)
{
    return float2(float(bits & 0xffffu), float(bits >> 16u)) / 65535.0f;
}

uint vkr_ssr_pack_snorm2(float2 value)
{
    int2 bits = int2(round(clamp(value, -1.0f, 1.0f) * 32767.0f));
    return (uint(bits.x) & 0xffffu) | (uint(bits.y) << 16u);
}

float2 vkr_ssr_unpack_snorm2(uint bits)
{
    int2 signed_bits = int2(int(bits << 16u) >> 16, int(bits) >> 16);
    return max(float2(signed_bits) / 32767.0f, -1.0f);
}

// A hit record: hit UV as two 16-bit unorms (1/65535 of the image), the hit's
// positive view depth, the ray's pdf and the hit's visible row (never zero).
uint4 vkr_ssr_pack_hit(float2 hit_uv, float hit_depth, float pdf,
                       uint hit_visible)
{
    return uint4(vkr_ssr_pack_unorm2(hit_uv), asuint(hit_depth), asuint(pdf),
                 hit_visible);
}

// A miss or unknown record: the view-space direction, octahedral in two
// 16-bit snorms, the state and the ray's pdf; the visible row stays zero.
uint4 vkr_ssr_pack_ray(uint state, float3 direction, float pdf)
{
    return uint4(vkr_ssr_pack_snorm2(vkr_ssr_encode_normal(direction)), state,
                 asuint(pdf), 0u);
}

VkrSsrRay vkr_ssr_unpack_ray(uint4 record)
{
    VkrSsrRay ray;
    ray.state = VKR_SSR_RAY_NONE;
    ray.pdf = asfloat(record.z);
    ray.hit_uv = 0.0f;
    ray.hit_depth = 0.0f;
    ray.hit_visible = 0u;
    ray.direction = 0.0f;
    if (!vkr_ssr_finite(ray.pdf) || ray.pdf < 0.0f)
        ray.pdf = 0.0f;
    if (record.w != 0u)
    {
        ray.hit_depth = asfloat(record.y);
        if (!vkr_ssr_valid_depth(ray.hit_depth))
            return ray;
        ray.state = VKR_SSR_RAY_HIT;
        ray.hit_uv = vkr_ssr_unpack_unorm2(record.x);
        ray.hit_visible = record.w;
        return ray;
    }
    if (record.y == VKR_SSR_RAY_MISS || record.y == VKR_SSR_RAY_UNKNOWN)
    {
        ray.state = record.y;
        ray.direction = vkr_ssr_decode_normal(vkr_ssr_unpack_snorm2(record.x));
    }
    return ray;
}

// The reflected image of `hit` in the plane through `receiver` with unit
// `normal`, moved toward the receiver by 1 - parallax.
float3 vkr_ssr_virtual_point(float3 receiver, float3 normal, float3 hit,
                             float parallax)
{
    float3 virtual_hit = hit - 2.0f * normal * dot(normal, hit - receiver);
    return receiver + (virtual_hit - receiver) * parallax;
}

// History location of the current pixel when a point it shows moves from
// `point` to `previous_point` (both view space of their frames). The pixel
// keeps its offset from the point's projection, so raster jitter alone does
// not move it. `previous_receiver_plane`, the transported receiver plane
// (vkr_ssr_plane_depth_prepare), gives the expected receiver depth there, the
// plane intersection rather than the surface-motion depth.
VkrSsrReflectedHit vkr_ssr_reproject_point(
    VkrSsrParams params, float2 current_uv, float3 point, float3 previous_point,
    VkrSsrPlaneDepth previous_receiver_plane)
{
    VkrSsrReflectedHit result;
    result.previous_uv = current_uv;
    result.expected_receiver_depth = 0.0f;
    result.expected_virtual_depth = 0.0f;
    result.current_virtual_depth = 0.0f;
    result.valid = 0u;
    VkrSsrProjectedPoint current = vkr_ssr_project_view_position(params, point);
    VkrSsrProjectedPoint previous =
        vkr_ssr_project_view_position(params, previous_point);
    result.current_virtual_depth = current.positive_depth;
    result.expected_virtual_depth = previous.positive_depth;
    if (current.valid == 0u || previous.valid == 0u)
        return result;
    float2 previous_projection_uv = current_uv + previous.uv - current.uv;
    result.previous_uv = previous_projection_uv +
        float2(params.history_jitter_uv_x, params.history_jitter_uv_y);
    result.expected_receiver_depth = vkr_ssr_plane_depth_at(
        previous_receiver_plane, previous_projection_uv);
    result.valid = vkr_ssr_valid_depth(result.expected_receiver_depth) ? 1u : 0u;
    return result;
}

// Reflected-hit reprojection. The gathered hit belongs to its traced receiver;
// its virtual point's motion, scaled toward the receiver's by 1 - parallax,
// moves the output pixel.
VkrSsrReflectedHit vkr_ssr_reproject_hit(
    VkrSsrParams params, float2 current_uv,
    float3 traced_receiver, float3 traced_normal, float3 hit,
    float3 previous_traced_receiver, float3 previous_traced_normal,
    float3 previous_hit, VkrSsrPlaneDepth previous_receiver_plane,
    float parallax)
{
    return vkr_ssr_reproject_point(
        params, current_uv,
        vkr_ssr_virtual_point(traced_receiver, traced_normal, hit, parallax),
        vkr_ssr_virtual_point(previous_traced_receiver, previous_traced_normal,
                              previous_hit, parallax),
        previous_receiver_plane);
}

// One history tap of a reprojected candidate. `expected_receiver_depth` is the
// transported receiver plane's depth at this tap's centre, so a grazing
// surface compares each tap with its own depth. `match` names what the tap
// must also prove (VKR_SSR_MATCH_*): static instances need only geometry.
VkrSsrHistoryDecision vkr_ssr_reflected_history_accept(
    VkrSsrParams params, VkrSsrReflectedHit hit, uint match,
    uint4 current_identity, uint4 history_identity, float4 history_geometry,
    float expected_receiver_depth, float3 previous_receiver_normal,
    uint2 history_extent)
{
    VkrSsrHistoryDecision result;
    result.accepted = 0u;
    result.weight = 0.0f;
    result.expected_previous_depth = expected_receiver_depth;
    result.support = 0.0f;
    result.tight = 0u;
    float2 half_texel = 0.5f / float2(history_extent);
    bool in_bounds = all(hit.previous_uv >= half_texel) &&
                     all(hit.previous_uv <= 1.0f - half_texel);
    float receiver_error = max(params.temporal_depth_absolute,
        params.temporal_depth_relative * expected_receiver_depth);
    bool depth_matches = vkr_ssr_valid_depth(history_geometry.x) &&
        vkr_ssr_valid_depth(expected_receiver_depth) &&
        abs(history_geometry.x - expected_receiver_depth) <= receiver_error;
    if ((match & VKR_SSR_MATCH_VIRTUAL_DEPTH) != 0u)
    {
        float virtual_error = max(params.temporal_depth_absolute,
            params.temporal_depth_relative * hit.expected_virtual_depth);
        depth_matches = depth_matches && vkr_ssr_valid_depth(history_geometry.y) &&
            abs(history_geometry.y - hit.expected_virtual_depth) <= virtual_error;
    }
    bool normal_matches = dot(vkr_ssr_decode_normal(history_geometry.zw),
                                previous_receiver_normal) >= 0.9f;
    bool identity_matches = true;
    if ((match & VKR_SSR_MATCH_RECEIVER_IDENTITY) != 0u)
        identity_matches = current_identity.x != 0u &&
                           all(current_identity.xy == history_identity.xy);
    if ((match & VKR_SSR_MATCH_HIT_IDENTITY) != 0u)
        identity_matches = identity_matches && current_identity.z != 0u &&
                           all(current_identity.zw == history_identity.zw);
    result.accepted = params.history_valid != 0u && hit.valid != 0u &&
        in_bounds && depth_matches && normal_matches && identity_matches
            ? 1u : 0u;
    result.weight = result.accepted != 0u ? params.temporal_weight : 0.0f;
    result.support = float(result.accepted);
    return result;
}

float3 vkr_ssr_history_clamp(float3 history_color, float3 neighborhood_min,
                             float3 neighborhood_max)
{
    return clamp(history_color, neighborhood_min, neighborhood_max);
}

float vkr_ssr_temporal_stability(float roughness)
{
    float blend = vkr_ssr_saturate((roughness - VKR_SSR_MIRROR_ROUGHNESS) /
                                  (0.25f - VKR_SSR_MIRROR_ROUGHNESS));
    return blend * blend * (3.0f - 2.0f * blend);
}

float vkr_ssr_temporal_weight(float configured_weight, float roughness,
                               float2 motion_pixels)
{
    if (configured_weight <= 0.0f)
        return 0.0f;
    float stationary = 1.0f - vkr_ssr_saturate(length(motion_pixels));
    return configured_weight + (1.0f - configured_weight) * (2.0f / 3.0f) *
                                   vkr_ssr_temporal_stability(roughness) * stationary;
}

// Whether `known_rays` rough-lobe rays that all missed still fit a history of
// `coverage`: one up to VKR_SSR_DECISIVE_EXPECTED_HITS expected hits, then
// exp(threshold - expected), the Poisson probability that every ray misses
// relative to its value at the threshold. A sparse lobe hit, such as a small
// lamp, misses with all rays on some frames; a reflection that covered the
// lobe cannot.
float vkr_ssr_miss_plausibility(float coverage, uint known_rays)
{
    float expected_hits = float(known_rays) * vkr_ssr_saturate(coverage);
    return exp(min(VKR_SSR_DECISIVE_EXPECTED_HITS - expected_hits, 0.0f));
}

// `known_share` is the current resolve's share of ray weight whose outcome is
// known (vkr_ssr_resolve_known_share), from `known_rays` rays. Accepted
// history fills the unknown rest in proportion to its support instead of the
// estimate dropping toward the environment term.
float4 vkr_ssr_temporal_filter(float roughness, uint neighborhood_hits, float4 raw,
                               float known_share, uint known_rays, float4 history,
                               float3 neighborhood_min, float3 neighborhood_max,
                               VkrSsrHistoryDecision decision)
{
    float unknown = decision.accepted != 0u
                        ? (1.0f - vkr_ssr_saturate(known_share)) *
                              vkr_ssr_saturate(decision.support)
                        : 0.0f;
    // No current hit bounds the old reflection. A mirror's own ray is exact,
    // so its known miss refutes the history and only an unknown outcome holds
    // it, briefly. A glossy lobe's rays cluster around the mirror direction
    // and see an image of the scene, so all of them missing is evidence that
    // the reflected object left (ADR-055's moving-emitter rule): the brief
    // hold. A rough lobe's rays scatter, and a sparse hit, such as a small
    // lamp or a rough wall's scattered surroundings, misses with every ray on
    // some frames: that frame is one more sample of zero coverage at the
    // ordinary retention, so coverage converges to the lobe's hit share
    // instead of collapsing between hits. All rays missing refutes the
    // history only when its coverage made hits likely; refuted coverage also
    // ends at the floor. Rays that ran out of hierarchy decisions refute
    // nothing.
    if (neighborhood_hits == 0u)
    {
        float coverage = vkr_ssr_saturate(history.w);
        bool brief = true;
        if (roughness <= VKR_SSR_MIRROR_ROUGHNESS)
        {
            coverage *= unknown * VKR_SSR_HOLD_RETENTION;
        }
        else if (decision.accepted == 0u)
        {
            coverage = 0.0f;
        }
        else
        {
            float plausibility = vkr_ssr_miss_plausibility(coverage, known_rays);
            if (vkr_ssr_reflection_parallax(roughness) > 0.0f)
            {
                coverage *= vkr_ssr_saturate(decision.support) * plausibility *
                            VKR_SSR_HOLD_RETENTION;
            }
            else
            {
                brief = plausibility < 1.0f;
                coverage *= plausibility * decision.weight;
            }
        }
        float minimum = brief ? VKR_SSR_HOLD_COVERAGE_MIN : 0.0f;
        return coverage > minimum ? float4(history.xyz, coverage)
                                  : float4(0.0f);
    }
    // History keeps its retention and also stands in for the unknown share
    // of the current estimate; with every outcome known this is the weight.
    float retained = decision.weight + (1.0f - decision.weight) * unknown;
    float3 clamped_history =
        vkr_ssr_history_clamp(history.xyz, neighborhood_min, neighborhood_max);
    float history_coverage = retained * vkr_ssr_saturate(history.w);
    float coverage = (1.0f - retained) * vkr_ssr_saturate(raw.w) +
                     history_coverage;
    if (coverage <= 0.0f)
        return float4(0.0f);
    // Sparse current coverage must not normalize old radiance retention above
    // the temporal weight. Coverage still follows the original weighted mean.
    float history_weight = min(history_coverage / coverage, retained);
    // A surface-motion fallback for a glossy reflection is not the same
    // reflected feature; it keeps nothing outside the current bounds.
    float residual_weight =
        decision.tight != 0u
            ? 0.0f
            : min(history_weight * vkr_ssr_temporal_stability(roughness), 0.5f);
    float3 color = vkr_ssr_lerp(raw.xyz, clamped_history, history_weight) +
                   residual_weight * (history.xyz - clamped_history);
    return float4(color, coverage);
}

// Composite shades filtered incoming radiance at the current receiver. Coverage
// remains independent of the material response.
float4 vkr_ssr_shade_reflection(float4 incoming, float3 receiver_weight)
{
    return float4(incoming.xyz * receiver_weight, incoming.w);
}

// Remove the exact current probe term, then add the filtered shaded reflection.
// The current receiver response is applied once before this replacement.
float3 vkr_ssr_replace_environment_specular(float3 opaque_hdr,
                                             float3 old_environment_specular,
                                             float3 shaded_reflection,
                                             float confidence)
{
    return opaque_hdr + vkr_ssr_saturate(confidence) *
                            (shaded_reflection - old_environment_specular);
}

#endif
