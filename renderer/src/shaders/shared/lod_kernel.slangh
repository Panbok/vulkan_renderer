// Shared level-of-detail selection and visible-row LOD state (ADR-085).
// Culling projects each level's model-space error onto the view: a level is
// acceptable while its projected error stays at or below one (the view scale
// already divides by the threshold). Classification picks the coarsest
// acceptable level of the monotonic chain, and a morphing view also derives
// how far the range has morphed toward the next level now and one frame
// earlier. Encoding stores that state above the visible row's candidate
// flags, where raster, resolve and picking read it. The host mirror is
// renderer/src/vkr_gpu_abi.h.
#ifndef VKR_LOD_KERNEL_SLANGH
#define VKR_LOD_KERNEL_SLANGH

#define VKR_GPU_LOD_VIEW_CONSTANT 1u
#define VKR_GPU_LOD_VIEW_MORPH 2u
// A local-shadow or cascade view draws only the candidates below the static
// count, or only those at or above it; without either bit every caster.
#define VKR_GPU_LOD_VIEW_STATIC_CASTERS_ONLY 4u
#define VKR_GPU_LOD_VIEW_DYNAMIC_CASTERS_ONLY 8u
#define VKR_GPU_LOD_MORPH_START 0.75f
#define VKR_GPU_GEOMETRY_LOD_TERRAIN_GRID 1u
#define VKR_GPU_DRAW_CANDIDATE_FLAG_MASK 15u
// Bits of a classification word below the LOD state: the bucket (Metal stores
// bucket + 1, zero rejecting) or Vulkan's rejection sentinel.
#define VKR_GPU_DRAW_STATE_BUCKET_WORD_MASK 15u
#define VKR_GPU_DRAW_GEOMORPH_BIT 128u
#define VKR_GPU_DRAW_LOD_SHIFT 8u
#define VKR_GPU_DRAW_LOD_MASK 7u
#define VKR_GPU_DRAW_MORPH_SHIFT 11u
#define VKR_GPU_DRAW_PREVIOUS_MORPH_SHIFT 19u
// The tiled pipeline's reflection probe for a camera-view draw, as frame probe
// index + 1 above the morph bits; zero takes the global environment.
#define VKR_GPU_DRAW_PROBE_SHIFT 27u
#define VKR_GPU_DRAW_PROBE_MASK 31u
// A draw that straddles a probe boundary picks its probe per pixel.
#define VKR_GPU_DRAW_PROBE_PER_PIXEL 31u
// Nearest distance a view measures, so a camera inside a bound stays finite.
#define VKR_GPU_LOD_DISTANCE_MIN 1e-3f

// Distance from `position` to the nearest point of a world-space sphere.
float vkr_lod_distance(float3 position, float3 center, float radius)
{
    return max(length(center - position) - radius, VKR_GPU_LOD_DISTANCE_MIN);
}

// A world-space error's projected size for a view of `scale` and `flags`.
float vkr_lod_projected(float error, float scale, uint flags, float distance)
{
    return (flags & VKR_GPU_LOD_VIEW_CONSTANT) != 0u
               ? error * scale
               : error * scale / distance;
}

// Smallest bounding-sphere diameter, in texels, that a caster spans in an
// orthographic shadow view and still draws. A smaller caster covers at most
// the one texel the receiver's PCF footprint already spreads over several.
#define VKR_GPU_CASCADE_CASTER_MIN_TEXELS 1.0f

// Whether a shadow view with LOD `scale` and `flags` skips a caster whose
// world bounding sphere has `radius`. Only orthographic views (directional
// cascades) have a constant texel size; their scale is texels per metre over
// the LOD threshold of one. The camera view must not call this, since an
// orthographic camera is also constant.
bool vkr_gpu_cascade_caster_too_small(float scale, uint flags, float radius)
{
    return (flags & VKR_GPU_LOD_VIEW_CONSTANT) != 0u && scale > 0.0f &&
           2.0f * radius * scale < VKR_GPU_CASCADE_CASTER_MIN_TEXELS;
}

// A candidate's draw-distance word, in its state flags above the bucket and
// the candidate flags: the camera's draw distance code in bits 0 to 7, the
// smallest diameter the camera draws in half pixels in bits 8 to 11, the
// shadow distance code in bits 12 to 19, bit 20 when its rooms are hidden
// from the camera this frame and bit 21 when they are sealed from the sun
// (no cascade draws it). A code c above zero stands for
// 2^((c - 1) / 16) metres, 1 m to about 60 km in steps of 4.4%; zero is no
// limit. The host packs it in renderer/src/vkr_gpu_abi.h.
#define VKR_GPU_DRAW_CULL_SHIFT 7u
#define VKR_GPU_DRAW_CULL_CODE_MASK 255u
#define VKR_GPU_DRAW_CULL_PIXELS_SHIFT 8u
#define VKR_GPU_DRAW_CULL_PIXELS_MASK 15u
#define VKR_GPU_DRAW_CULL_SHADOW_SHIFT 12u
#define VKR_GPU_DRAW_CULL_CODES_PER_OCTAVE 16.0f
#define VKR_GPU_DRAW_CULL_HIDDEN_BIT (1u << 20u)
#define VKR_GPU_DRAW_CULL_SEALED_BIT (1u << 21u)
// The candidate state bits a visible row keeps: the bucket and the flags.
#define VKR_GPU_DRAW_CANDIDATE_STATE_MASK 127u

uint vkr_gpu_draw_cull_word(uint state_flags)
{
    return state_flags >> VKR_GPU_DRAW_CULL_SHIFT;
}

float vkr_gpu_draw_cull_metres(uint code)
{
    return exp2(float(code - 1u) / VKR_GPU_DRAW_CULL_CODES_PER_OCTAVE);
}

// Whether the camera skips a candidate of cull word `cull` whose bounding
// sphere of `radius` lies `distance` metres away at its nearest point: its
// rooms are hidden, it lies past its draw distance times `distance_scale`,
// or its projected diameter times `distance_scale` is below its smallest
// drawn diameter. `scale` and `flags` are the view's LOD scale, pixels per
// metre at unit distance under the threshold of one, and its flags. A zero
// `distance_scale` turns off both distance tests.
bool vkr_gpu_draw_distance_culled(uint cull, float scale, uint flags,
                                  float distance_scale, float distance,
                                  float radius)
{
    if ((cull & VKR_GPU_DRAW_CULL_HIDDEN_BIT) != 0u)
    {
        return true;
    }
    if (!(distance_scale > 0.0f))
    {
        return false;
    }
    uint far_code = cull & VKR_GPU_DRAW_CULL_CODE_MASK;
    if (far_code != 0u &&
        distance > vkr_gpu_draw_cull_metres(far_code) * distance_scale)
    {
        return true;
    }
    uint half_pixels =
        (cull >> VKR_GPU_DRAW_CULL_PIXELS_SHIFT) & VKR_GPU_DRAW_CULL_PIXELS_MASK;
    return half_pixels != 0u && scale > 0.0f &&
           vkr_lod_projected(2.0f * radius, scale, flags, distance) *
                   distance_scale <
               0.5f * float(half_pixels);
}

// How many times farther than now the camera would still draw a candidate,
// for the editor's Draw reach view: the tighter of its draw distance and its
// smallest drawn size, under `distance_scale` or the far setting's 1 when
// the editor draws every object. As a 5-bit code: 1 already past a limit
// (drawn only because the editor draws everything), 2 plus 4 per octave of
// headroom up to 30, and 31 without a limit; 0 is left to draws the camera
// view did not classify. A constant-size view has no size limit by
// distance.
uint vkr_gpu_draw_reach_code(uint cull, float scale, uint flags,
                             float distance_scale, float distance,
                             float radius)
{
    float game_scale = distance_scale > 0.0f ? distance_scale : 1.0f;
    float reach = -1.0f;
    uint far_code = cull & VKR_GPU_DRAW_CULL_CODE_MASK;
    if (far_code != 0u)
    {
        reach = vkr_gpu_draw_cull_metres(far_code) * game_scale / distance;
    }
    uint half_pixels =
        (cull >> VKR_GPU_DRAW_CULL_PIXELS_SHIFT) & VKR_GPU_DRAW_CULL_PIXELS_MASK;
    if (half_pixels != 0u && scale > 0.0f)
    {
        float size = vkr_lod_projected(2.0f * radius, scale, flags, distance) *
                     game_scale / (0.5f * float(half_pixels));
        bool constant_size = (flags & VKR_GPU_LOD_VIEW_CONSTANT) != 0u;
        if (!constant_size || size < 1.0f)
        {
            reach = reach < 0.0f ? size : min(reach, size);
        }
    }
    if (reach < 0.0f)
    {
        return 31u;
    }
    if (reach < 1.0f)
    {
        return 1u;
    }
    return min(2u + uint(log2(reach) * 4.0f), 30u);
}

// Whether a cascade whose slice begins `shadow_near` metres from the camera
// skips a caster of cull word `cull`: its rooms are sealed, or its shadow
// distance ends before the slice. The test reads no camera position, so a
// cascade's casters change only when the preset's splits or the sealed
// rooms do, and retained layers stay valid. Other views have no slice
// start and keep every caster.
bool vkr_gpu_draw_shadow_culled(uint cull, float shadow_near)
{
    if (!(shadow_near > 0.0f))
    {
        return false;
    }
    if ((cull & VKR_GPU_DRAW_CULL_SEALED_BIT) != 0u)
    {
        return true;
    }
    uint code =
        (cull >> VKR_GPU_DRAW_CULL_SHADOW_SHIFT) & VKR_GPU_DRAW_CULL_CODE_MASK;
    return code != 0u && vkr_gpu_draw_cull_metres(code) < shadow_near;
}

// How far a level has morphed toward the next one, from the next level's
// projected error: zero until the view reaches VKR_GPU_LOD_MORPH_START of
// the distance at which the next level is acceptable, one there.
float vkr_lod_morph(float next_projected)
{
    if (!(next_projected > 0.0f))
    {
        return 1.0f;
    }
    float share = 1.0f / next_projected;
    return saturate((share - VKR_GPU_LOD_MORPH_START) /
                    (1.0f - VKR_GPU_LOD_MORPH_START));
}

uint vkr_gpu_draw_lod_state(uint level, float morph, float previous_morph,
                            bool geomorph)
{
    uint state = (level & VKR_GPU_DRAW_LOD_MASK) << VKR_GPU_DRAW_LOD_SHIFT;
    state |= uint(saturate(morph) * 255.0f + 0.5f) << VKR_GPU_DRAW_MORPH_SHIFT;
    state |= uint(saturate(previous_morph) * 255.0f + 0.5f)
             << VKR_GPU_DRAW_PREVIOUS_MORPH_SHIFT;
    return geomorph ? state | VKR_GPU_DRAW_GEOMORPH_BIT : state;
}

uint vkr_gpu_draw_lod_level(uint state_flags)
{
    return (state_flags >> VKR_GPU_DRAW_LOD_SHIFT) & VKR_GPU_DRAW_LOD_MASK;
}

bool vkr_gpu_draw_geomorph(uint state_flags)
{
    return (state_flags & VKR_GPU_DRAW_GEOMORPH_BIT) != 0u;
}

float vkr_gpu_draw_morph(uint state_flags)
{
    return float((state_flags >> VKR_GPU_DRAW_MORPH_SHIFT) & 255u) / 255.0f;
}

float vkr_gpu_draw_previous_morph(uint state_flags)
{
    return float((state_flags >> VKR_GPU_DRAW_PREVIOUS_MORPH_SHIFT) & 255u) /
           255.0f;
}

#endif
