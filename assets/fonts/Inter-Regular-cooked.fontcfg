# Editor UI face (SIL OFL 1.1, see Inter-OFL.txt). Reproducible cooked MTSDF
# configuration; runtime loading consumes only the generated .vkfa artifact.
# The charset lists every Inter codepoint in Basic Latin, Latin-1, Latin
# Extended-A/B, Greek and Cyrillic plus the editor's symbols, so user-authored
# names render; the SemiBold heading face stays Latin-1.
type=cooked_mtsdf
source=Inter-Regular.ttf
file=Inter-Regular-cooked.vkfa
face=Inter/Regular
face_index=0
size=32
charset_file=Inter-Regular-editor.charset
fallback=U+003F
fallback_policy=reject
atlas_width=2048
atlas_height=2048
atlas_px_per_em=64
field=mtsdf
distance_range=16
inner_padding_px=0
outer_padding_px=0
edge_coloring=inktrap
edge_angle_degrees=3
edge_seed=1
pixel_format=rgba8_unorm
miter_limit=1
scanline=true
threads=1
