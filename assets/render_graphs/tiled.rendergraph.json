{
  "version": 1,
  "name": "tiled",
  "resources": [
    {
      "name": "swapchain",
      "type": "image",
      "import": "swapchain",
      "flags": [
        "EXTERNAL",
        "PER_IMAGE"
      ]
    },
    {
      "name": "shadow_map",
      "condition": "scene_rendering",
      "type": "image",
      "extent": {
        "mode": "square",
        "size_source": "shadow_map_size"
      },
      "layers_source": "shadow_map_layer_count",
      "format": "SHADOW_DEPTH",
      "usage": [
        "DEPTH_STENCIL_ATTACHMENT",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "RETAINED",
        "PER_IMAGE",
        "RESIZABLE"
      ]
    },
    {
      "name": "shadow_moments",
      "condition": "scene_rendering && shadow_evsm_active",
      "type": "image",
      "extent": {
        "mode": "square",
        "size_source": "shadow_moments_size"
      },
      "layers_source": "shadow_moments_layer_count",
      "format": "R32G32B32A32_SFLOAT",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "RETAINED",
        "PER_IMAGE",
        "RESIZABLE"
      ]
    },
    {
      "name": "local_shadow_map",
      "condition": "scene_rendering && local_shadows_active",
      "type": "image",
      "extent": {
        "mode": "square",
        "size_source": "local_shadow_atlas_size"
      },
      "layers_source": "local_shadow_atlas_layer_count",
      "format": "D16_UNORM",
      "usage": [
        "DEPTH_STENCIL_ATTACHMENT",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "RETAINED",
        "RESIZABLE"
      ]
    },
    {
      "name": "hdr_scene_color",
      "type": "image",
      "condition": "scene_rendering",
      "extent": {
        "mode": "viewport"
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "COLOR_ATTACHMENT",
        "SAMPLED",
        "STORAGE",
        "TRANSFER_SRC",
        "TRANSFER_DST"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE",
        "PER_IMAGE"
      ]
    },
    {
      "name": "gpu_draw_candidates",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "gpu_draw_candidate_capacity",
        "bytes_per_element": 48
      },
      "usage": [
        "STORAGE",
        "TRANSFER_DST"
      ],
      "flags": [
        "PER_FRAME_SLOT",
        "RESIZABLE",
        "GROW_ONLY"
      ]
    },
    {
      "name": "gpu_draw_instances",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "gpu_draw_candidate_capacity",
        "bytes_per_element": 144
      },
      "usage": [
        "STORAGE",
        "TRANSFER_DST"
      ],
      "flags": [
        "PER_FRAME_SLOT",
        "RESIZABLE",
        "GROW_ONLY"
      ]
    },
    {
      "name": "gpu_visible_draws",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "gpu_draw_view_rows",
        "bytes_per_element": 32
      },
      "usage": [
        "STORAGE"
      ],
      "flags": [
        "PER_FRAME_SLOT",
        "RESIZABLE",
        "GROW_ONLY"
      ]
    },
    {
      "name": "gpu_draw_classifications",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "gpu_draw_view_rows",
        "bytes_per_element": 4
      },
      "usage": [
        "STORAGE"
      ],
      "flags": [
        "PER_FRAME_SLOT",
        "RESIZABLE",
        "GROW_ONLY"
      ]
    },
    {
      "name": "gpu_draw_compaction_state",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "gpu_draw_view_count",
        "bytes_per_element": 144
      },
      "usage": [
        "STORAGE",
        "INDIRECT",
        "TRANSFER_SRC",
        "TRANSFER_DST"
      ],
      "flags": [
        "PER_FRAME_SLOT",
        "RESIZABLE",
        "GROW_ONLY"
      ]
    },
    {
      "name": "gpu_draw_arguments",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "gpu_draw_view_rows",
        "bytes_per_element": 20
      },
      "usage": [
        "STORAGE",
        "INDIRECT"
      ],
      "flags": [
        "PER_FRAME_SLOT",
        "RESIZABLE",
        "GROW_ONLY"
      ]
    },
    {
      "name": "sdsm_reduce_state",
      "condition": "scene_rendering",
      "type": "buffer",
      "size": 16,
      "usage": [
        "STORAGE",
        "TRANSFER_SRC",
        "TRANSFER_DST"
      ],
      "flags": [
        "PER_FRAME_SLOT"
      ]
    },
    {
      "name": "opaque_vbuffer_depth",
      "condition": "scene_rendering",
      "type": "image",
      "extent": {
        "mode": "viewport"
      },
      "format": "SWAPCHAIN_DEPTH",
      "usage": [
        "DEPTH_STENCIL_ATTACHMENT",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE",
        "PER_IMAGE"
      ]
    },
    {
      "name": "hzb_history",
      "condition": "scene_rendering",
      "type": "image",
      "extent": {
        "mode": "viewport"
      },
      "format": "R32_SFLOAT",
      "mip_levels": "full_chain",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "HISTORY",
        "RESIZABLE"
      ]
    },
    {
      "name": "exposure_histogram",
      "type": "buffer",
      "condition": "scene_rendering && exposure_automatic",
      "size": 1024,
      "usage": [
        "STORAGE",
        "TRANSFER_SRC"
      ],
      "flags": [
        "PER_FRAME_SLOT"
      ]
    },
    {
      "name": "exposure_state",
      "type": "buffer",
      "condition": "scene_rendering && exposure_automatic",
      "size": 32,
      "usage": [
        "STORAGE",
        "TRANSFER_SRC"
      ],
      "flags": [
        "HISTORY"
      ]
    },
    {
      "name": "bloom_chain",
      "type": "image",
      "condition": "scene_rendering && bloom_enabled && !fsr31_enabled",
      "extent": {
        "mode": "viewport",
        "divisor": 2
      },
      "format": "R16G16B16A16_SFLOAT",
      "mip_levels": "full_chain",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE",
        "PER_IMAGE"
      ]
    },
    {
      "name": "bloom_accum",
      "type": "image",
      "condition": "scene_rendering && bloom_enabled && !fsr31_enabled",
      "extent": {
        "mode": "viewport",
        "divisor": 2
      },
      "format": "R16G16B16A16_SFLOAT",
      "mip_levels": "full_chain",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE",
        "PER_IMAGE"
      ]
    },
    {
      "name": "bloom_combined",
      "type": "image",
      "condition": "scene_rendering && bloom_enabled && !metalfx_enabled && !fsr31_enabled",
      "extent": {
        "mode": "viewport"
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE",
        "PER_IMAGE"
      ]
    },
    {
      "name": "sky_view_lut",
      "type": "image",
      "condition": "scene_rendering && atmosphere_enabled",
      "extent": {
        "mode": "fixed",
        "width": 384,
        "height": 108
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT"
      ]
    },
    {
      "name": "aerial_perspective",
      "type": "image",
      "condition": "scene_rendering && aerial_perspective_enabled",
      "dimension": "3d",
      "depth": 32,
      "extent": {
        "mode": "fixed",
        "width": 32,
        "height": 32
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT"
      ]
    },
    {
      "name": "cloud_shadow",
      "type": "image",
      "condition": "scene_rendering && clouds_enabled",
      "extent": {
        "mode": "fixed",
        "width": 512,
        "height": 512
      },
      "format": "R16_SFLOAT",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT",
        "PER_FRAME_SLOT"
      ]
    },
    {
      "name": "cloud_history",
      "type": "image",
      "condition": "scene_rendering && clouds_enabled",
      "extent": {
        "mode": "viewport",
        "divisor": 2
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "STORAGE",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "HISTORY",
        "RESIZABLE"
      ]
    },
    {
      "name": "post_display_linear_fullscreen",
      "type": "image",
      "condition": "scene_rendering && post_transform_cache_enabled && !editor_enabled",
      "extent": {
        "mode": "window"
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "COLOR_ATTACHMENT",
        "SAMPLED"
      ],
      "flags": [
        "TRANSIENT",
        "PER_IMAGE",
        "RESIZABLE"
      ]
    },
    {
      "name": "skinning_output",
      "condition": "skinning_enabled",
      "type": "buffer",
      "size": {
        "mode": "draw_elements",
        "count_source": "skinning_vertex_capacity",
        "bytes_per_element": 32
      },
      "usage": [
        "STORAGE"
      ],
      "flags": [
        "HISTORY",
        "RESIZABLE"
      ]
    },
    {
      "name": "animation_preview_color",
      "type": "image",
      "condition": "animation_preview_enabled",
      "extent": {
        "mode": "fixed",
        "width": 512,
        "height": 512
      },
      "format": "R8G8B8A8_UNORM",
      "usage": [
        "COLOR_ATTACHMENT",
        "SAMPLED"
      ],
      "flags": [
        "PER_IMAGE"
      ]
    },
    {
      "name": "animation_preview_depth",
      "type": "image",
      "condition": "animation_preview_enabled",
      "extent": {
        "mode": "fixed",
        "width": 512,
        "height": 512
      },
      "format": "D32_SFLOAT",
      "usage": [
        "DEPTH_STENCIL_ATTACHMENT"
      ],
      "flags": [
        "PER_IMAGE"
      ]
    },
    {
      "name": "editor_scene_image",
      "type": "image",
      "condition": "editor_enabled && editor_image_available",
      "extent": {
        "mode": "editor_image"
      },
      "format": "SWAPCHAIN",
      "usage": [
        "COLOR_ATTACHMENT",
        "SAMPLED",
        "TRANSFER_SRC"
      ],
      "flags": [
        "RETAINED",
        "RESIZABLE"
      ]
    },
    {
      "name": "editor_selection_mask",
      "type": "image",
      "condition": "editor_enabled && editor_image_available",
      "extent": {
        "mode": "editor_image"
      },
      "format": "R8_UNORM",
      "usage": [
        "COLOR_ATTACHMENT",
        "SAMPLED"
      ],
      "flags": [
        "RESIZABLE"
      ]
    },
    {
      "name": "post_display_linear_editor",
      "type": "image",
      "condition": "scene_rendering && post_transform_cache_enabled && editor_enabled",
      "extent": {
        "mode": "editor_image"
      },
      "format": "R16G16B16A16_SFLOAT",
      "usage": [
        "COLOR_ATTACHMENT",
        "SAMPLED"
      ],
      "flags": [
        "TRANSIENT",
        "PER_IMAGE",
        "RESIZABLE"
      ]
    },
    {
      "name": "picking_color",
      "type": "image",
      "condition": "scene_rendering && picking_pending",
      "extent": {
        "mode": "viewport"
      },
      "format": "R32_UINT",
      "usage": [
        "COLOR_ATTACHMENT",
        "STORAGE",
        "TRANSFER_SRC"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE"
      ]
    },
    {
      "name": "picking_depth",
      "type": "image",
      "condition": "scene_rendering && picking_pending",
      "extent": {
        "mode": "viewport"
      },
      "format": "SWAPCHAIN_DEPTH",
      "usage": [
        "DEPTH_STENCIL_ATTACHMENT",
        "TRANSFER_DST"
      ],
      "flags": [
        "TRANSIENT",
        "RESIZABLE"
      ]
    }
  ],
  "passes": [
    {
      "name": "IBL.Bake",
      "type": "compute",
      "flags": [
        "NO_CULL"
      ],
      "execute": "pass.ibl_bake"
    },
    {
      "name": "Cull.Upload",
      "condition": "scene_rendering",
      "type": "transfer",
      "flags": [
        "NO_CULL"
      ],
      "writes": [
        {
          "buffer": "gpu_draw_candidates",
          "access": "TRANSFER_DST",
          "binding": 0
        },
        {
          "buffer": "gpu_draw_compaction_state",
          "access": "TRANSFER_DST",
          "binding": 1
        },
        {
          "buffer": "sdsm_reduce_state",
          "access": "TRANSFER_DST",
          "binding": 2
        },
        {
          "buffer": "gpu_draw_instances",
          "access": "TRANSFER_DST",
          "binding": 3
        }
      ],
      "execute": "pass.gpu_draw_upload"
    },
    {
      "name": "Animation.Skinning",
      "condition": "skinning_enabled",
      "type": "compute",
      "flags": [
        "NO_CULL"
      ],
      "writes": [
        {
          "buffer": "skinning_output",
          "access": "STORAGE_WRITE",
          "binding": 0
        }
      ],
      "execute": "pass.animation.skinning"
    },
    {
      "name": "Cull.Classify",
      "condition": "scene_rendering",
      "type": "compute",
      "flags": [
        "NO_CULL"
      ],
      "reads": [
        {
          "buffer": "gpu_draw_candidates",
          "access": "STORAGE_READ",
          "binding": 0
        },
        {
          "buffer": "gpu_draw_instances",
          "access": "STORAGE_READ",
          "binding": 9
        },
        {
          "image": "hzb_history",
          "access": "STORAGE_READ",
          "binding": 3,
          "when": "hzb_build_enabled"
        }
      ],
      "writes": [
        {
          "buffer": "gpu_draw_classifications",
          "access": "STORAGE_WRITE",
          "binding": 1
        },
        {
          "buffer": "gpu_draw_compaction_state",
          "access": "STORAGE_WRITE",
          "binding": 2
        }
      ],
      "execute": "pass.gpu_draw_classify"
    },
    {
      "name": "Cull.Prefix",
      "condition": "scene_rendering",
      "type": "compute",
      "flags": [
        "NO_CULL"
      ],
      "writes": [
        {
          "buffer": "gpu_draw_compaction_state",
          "access": "STORAGE_READ_WRITE",
          "binding": 0
        }
      ],
      "execute": "pass.gpu_draw_prefix"
    },
    {
      "name": "Cull.Encode",
      "condition": "scene_rendering",
      "type": "compute",
      "flags": [
        "NO_CULL"
      ],
      "reads": [
        {
          "buffer": "gpu_draw_candidates",
          "access": "STORAGE_READ",
          "binding": 0
        },
        {
          "buffer": "gpu_draw_classifications",
          "access": "STORAGE_READ",
          "binding": 1
        }
      ],
      "writes": [
        {
          "buffer": "gpu_visible_draws",
          "access": "STORAGE_WRITE",
          "binding": 2
        },
        {
          "buffer": "gpu_draw_compaction_state",
          "access": "STORAGE_READ_WRITE",
          "binding": 3
        },
        {
          "buffer": "gpu_draw_arguments",
          "access": "STORAGE_WRITE",
          "binding": 4
        }
      ],
      "execute": "pass.gpu_draw_encode"
    },
    {
      "name": "Shadow.Cascade.${i}",
      "condition": "scene_rendering",
      "type": "graphics",
      "domain": "SHADOW",
      "repeat": {
        "count_source": "shadow_cascade_count",
        "condition_mask_source": "shadow_cascade_render_mask"
      },
      "reads": [
        {
          "buffer": "gpu_visible_draws",
          "access": "STORAGE_READ",
          "binding": 1
        },
        {
          "buffer": "gpu_draw_instances",
          "access": "STORAGE_READ",
          "binding": 9
        },
        {
          "buffer": "gpu_draw_compaction_state",
          "access": "INDIRECT_READ",
          "binding": 2
        },
        {
          "buffer": "gpu_draw_arguments",
          "access": "INDIRECT_READ",
          "binding": 3
        },
        {
          "buffer": "skinning_output",
          "access": "STORAGE_READ",
          "binding": 31,
          "when": "skinning_enabled"
        }
      ],
      "attachments": {
        "depth": {
          "image": "shadow_map",
          "load": "CLEAR",
          "store": "STORE",
          "clear": {
            "depth": 1.0,
            "stencil": 0
          },
          "slice": {
            "base_layer": "${i}",
            "layer_count": 1
          }
        }
      },
      "execute": "pass.shadow.cascade"
    },
    {
      "name": "Shadow.Moments.${i}",
      "condition": "scene_rendering && shadow_evsm_active",
      "type": "compute",
      "flags": [
        "NO_CULL"
      ],
      "repeat": {
        "count_source": "shadow_moments_layer_count",
        "condition_mask_source": "shadow_moments_render_mask"
      },
      "reads": [
        {
          "image": "shadow_map",
          "access": "SAMPLED",
          "binding": 0
        }
      ],
      "writes": [
        {
          "image": "shadow_moments",
          "access": "STORAGE_WRITE",
          "binding": 1,
          "subresource": {
            "base_layer": "${i}",
            "layer_count": 1
          }
        }
      ],
      "execute": "pass.shadow.moments"
    },
    {
      "name": "Shadow.Local.Clear.${i}",
      "condition": "scene_rendering && local_shadow_atlas_clear",
      "type": "graphics",
      "domain": "SHADOW",
      "repeat": {
        "count_source": "local_shadow_atlas_layer_count",
        "condition_mask_source": "local_shadow_atlas_clear_mask"
      },
      "attachments": {
        "depth": {
          "image": "local_shadow_map",
          "load": "CLEAR",
          "store": "STORE",
          "clear": {
            "depth": 1.0,
            "stencil": 0
          },
          "slice": {
            "base_layer": "${i}",
            "layer_count": 1
          }
        }
      },
      "execute": "pass.clear"
    },
    {
      "name": "Shadow.Local.${i}",
      "condition": "scene_rendering && local_shadows_active",
      "type": "graphics",
      "domain": "SHADOW",
      "repeat": {
        "count_source": "local_shadow_render_count"
      },
      "reads": [
        {
          "buffer": "gpu_visible_draws",
          "access": "STORAGE_READ",
          "binding": 1
        },
        {
          "buffer": "gpu_draw_instances",
          "access": "STORAGE_READ",
          "binding": 9
        },
        {
          "buffer": "gpu_draw_compaction_state",
          "access": "INDIRECT_READ",
          "binding": 2
        },
        {
          "buffer": "gpu_draw_arguments",
          "access": "INDIRECT_READ",
          "binding": 3
        },
        {
          "buffer": "skinning_output",
          "access": "STORAGE_READ",
          "binding": 31,
          "when": "skinning_enabled"
        }
      ],
      "attachments": {
        "depth": {
          "image": "local_shadow_map",
          "load": "LOAD",
          "store": "STORE",
          "slice": {
            "base_layer": "${local_shadow_render_atlas_layer}",
            "layer_count": 1
          }
        }
      },
      "execute": "pass.local_shadow"
    },
    {
      "name": "Sky.ViewLut",
      "type": "compute",
      "condition": "scene_rendering && atmosphere_enabled",
      "writes": [
        {
          "image": "sky_view_lut",
          "access": "STORAGE_WRITE",
          "binding": 0
        }
      ],
      "execute": "pass.sky.view_lut"
    },
    {
      "name": "Sky.AerialPerspective",
      "type": "compute",
      "condition": "scene_rendering && aerial_perspective_enabled",
      "writes": [
        {
          "image": "aerial_perspective",
          "access": "STORAGE_WRITE",
          "binding": 0
        }
      ],
      "execute": "pass.sky.aerial_perspective"
    },
    {
      "name": "Clouds.Shadow",
      "type": "compute",
      "condition": "scene_rendering && clouds_enabled",
      "writes": [
        {
          "image": "cloud_shadow",
          "access": "STORAGE_WRITE",
          "binding": 0
        }
      ],
      "execute": "pass.clouds.shadow"
    },
    {
      "name": "Clouds.SkyLight",
      "type": "compute",
      "condition": "scene_rendering && clouds_enabled",
      "flags": [
        "NO_CULL"
      ],
      "execute": "pass.clouds.sky_light"
    },
    {
      "name": "Tiled.Opaque",
      "condition": "scene_rendering",
      "type": "graphics",
      "domain": "WORLD",
      "reads": [
        {
          "buffer": "gpu_visible_draws",
          "access": "STORAGE_READ",
          "binding": 1
        },
        {
          "buffer": "gpu_draw_instances",
          "access": "STORAGE_READ",
          "binding": 9
        },
        {
          "buffer": "gpu_draw_compaction_state",
