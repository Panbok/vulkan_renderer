{
  "version": 1,
  "name": "main",
  "resources": [
    {
      "name": "swapchain",
      "type": "image",
      "import": "swapchain",
      "flags": ["EXTERNAL", "PER_IMAGE"]
    },
    {
      "name": "swapchain_depth",
      "type": "image",
      "import": "swapchain_depth",
      "flags": ["EXTERNAL", "PER_IMAGE"]
    },
    {
      "name": "shadow_map",
      "type": "image",
      "extent": { "mode": "square", "size_source": "shadow_map_size" },
      "layers_source": "shadow_cascade_count",
      "format": "SHADOW_DEPTH",
      "usage": ["DEPTH_STENCIL_ATTACHMENT", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "PER_IMAGE"]
    },
    {
      "name": "scene_color",
      "type": "image",
      "condition": "editor_enabled",
      "extent": { "mode": "viewport" },
      "format": "R16G16B16A16_SFLOAT",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED", "TRANSFER_SRC", "TRANSFER_DST"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "hdr_scene_color",
      "type": "image",
      "condition": "!editor_enabled",
      "extent": { "mode": "window" },
      "format": "R16G16B16A16_SFLOAT",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED", "TRANSFER_SRC", "TRANSFER_DST"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "scene_pre_transmission",
      "type": "image",
      "condition": "editor_enabled",
      "extent": { "mode": "viewport" },
      "format": "R16G16B16A16_SFLOAT",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "hdr_pre_transmission",
      "type": "image",
      "condition": "!editor_enabled",
      "extent": { "mode": "window" },
      "format": "R16G16B16A16_SFLOAT",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "scene_depth",
      "type": "image",
      "condition": "editor_enabled",
      "extent": { "mode": "viewport" },
      "format": "SWAPCHAIN_DEPTH",
      "usage": ["DEPTH_STENCIL_ATTACHMENT", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "picking_color",
      "type": "image",
      "condition": "picking_pending",
      "extent": { "mode": "viewport" },
      "format": "R32_UINT",
      "usage": ["COLOR_ATTACHMENT", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE"]
    },
    {
      "name": "picking_depth",
      "type": "image",
      "condition": "picking_pending",
      "extent": { "mode": "viewport" },
      "format": "SWAPCHAIN_DEPTH",
      "usage": ["DEPTH_STENCIL_ATTACHMENT"],
      "flags": ["TRANSIENT", "RESIZABLE"]
    },
    {
      "name": "gpu_draw_candidates",
      "type": "buffer",
      "condition": "deferred_enabled",
      "size": 12582912,
      "usage": ["STORAGE", "TRANSFER_DST"],
      "flags": ["PER_FRAME_SLOT"]
    },
    {
      "name": "gpu_visible_draws",
      "type": "buffer",
      "condition": "deferred_enabled",
      "size": 8388608,
      "usage": ["STORAGE"],
      "flags": ["PER_FRAME_SLOT"]
    },
    {
      "name": "gpu_draw_classifications",
      "type": "buffer",
      "condition": "deferred_enabled",
      "size": 1048576,
      "usage": ["STORAGE"],
      "flags": ["PER_FRAME_SLOT"]
    },
    {
      "name": "gpu_draw_compaction_state",
      "type": "buffer",
      "condition": "deferred_enabled",
      "size": 80,
      "usage": ["STORAGE", "INDIRECT", "TRANSFER_DST"],
      "flags": ["PER_FRAME_SLOT"]
    },
    {
      "name": "opaque_vbuffer",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "R32G32_UINT",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED", "STORAGE", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "opaque_vbuffer_depth",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "SWAPCHAIN_DEPTH",
      "usage": ["DEPTH_STENCIL_ATTACHMENT", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "gbuffer_albedo",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "R8G8B8A8_UNORM",
      "usage": ["STORAGE", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "gbuffer_specular",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "R8G8B8A8_UNORM",
      "usage": ["STORAGE", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "gbuffer_normal",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "R16G16_SNORM",
      "usage": ["STORAGE", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "deferred_emissive_seed",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "R16G16B16A16_SFLOAT",
      "usage": ["STORAGE", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    },
    {
      "name": "deferred_resolve_debug",
      "type": "image",
      "condition": "deferred_enabled",
      "extent": { "mode": "viewport" },
      "format": "R16G16B16A16_SFLOAT",
      "usage": ["STORAGE", "SAMPLED", "TRANSFER_SRC"],
      "flags": ["TRANSIENT", "RESIZABLE", "PER_IMAGE"]
    }
  ],
  "passes": [
    {
      "name": "Shadow.Cascade.${i}",
      "type": "graphics",
      "domain": "SHADOW",
      "repeat": { "count_source": "shadow_cascade_count" },
      "attachments": {
        "depth": {
          "image": "shadow_map",
          "load": "CLEAR",
          "store": "STORE",
          "clear": { "depth": 1.0, "stencil": 0 },
          "slice": { "base_layer": "${i}", "layer_count": 1 }
        }
      },
      "execute": "pass.shadow.cascade"
    },
    {
      "name": "Picking.Request",
      "type": "graphics",
      "domain": "PICKING",
      "condition": "picking_pending",
      "flags": ["NO_CULL"],
      "attachments": {
        "color": [
          {
            "image": "picking_color",
            "load": "CLEAR",
            "store": "STORE",
            "clear": { "color": [0, 0, 0, 0] }
          }
        ],
        "depth": {
          "image": "picking_depth",
          "load": "CLEAR",
          "store": "DONT_CARE",
          "clear": { "depth": 1.0, "stencil": 0 }
        }
      },
      "execute": "pass.picking"
    },
    {
      "name": "Picking.Readback",
      "type": "compute",
      "condition": "picking_pending",
      "flags": ["NO_CULL"],
      "reads": [
        {
          "image": "picking_color",
          "access": "TRANSFER_SRC",
          "binding": 0
        }
      ],
      "execute": "pass.picking.readback"
    },
    {
      "name": "IBL.Bake",
      "type": "compute",
      "flags": ["NO_CULL"],
      "execute": "pass.ibl_bake"
    },
    {
      "name": "Cull.Upload",
      "type": "transfer",
      "condition": "deferred_enabled",
      "flags": ["NO_CULL"],
      "writes": [
        { "buffer": "gpu_draw_candidates", "access": "TRANSFER_DST", "binding": 0 },
        { "buffer": "gpu_draw_compaction_state", "access": "TRANSFER_DST", "binding": 1 }
      ],
      "execute": "pass.gpu_draw_upload"
    },
    {
      "name": "Cull.Classify",
      "type": "compute",
      "condition": "deferred_enabled",
      "flags": ["NO_CULL"],
      "reads": [
        { "buffer": "gpu_draw_candidates", "access": "STORAGE_READ", "binding": 0 }
      ],
      "writes": [
        { "buffer": "gpu_draw_classifications", "access": "STORAGE_WRITE", "binding": 1 },
        { "buffer": "gpu_draw_compaction_state", "access": "STORAGE_WRITE", "binding": 2 }
      ],
      "execute": "pass.gpu_draw_classify"
    },
    {
      "name": "Cull.Prefix",
      "type": "compute",
      "condition": "deferred_enabled",
      "flags": ["NO_CULL"],
      "writes": [
        { "buffer": "gpu_draw_compaction_state", "access": "STORAGE_READ_WRITE", "binding": 0 }
      ],
      "execute": "pass.gpu_draw_prefix"
    },
    {
      "name": "Cull.Encode",
      "type": "compute",
      "condition": "deferred_enabled",
      "flags": ["NO_CULL"],
      "reads": [
        { "buffer": "gpu_draw_candidates", "access": "STORAGE_READ", "binding": 0 },
        { "buffer": "gpu_draw_classifications", "access": "STORAGE_READ", "binding": 1 }
      ],
      "writes": [
        { "buffer": "gpu_visible_draws", "access": "STORAGE_WRITE", "binding": 2 },
        { "buffer": "gpu_draw_compaction_state", "access": "STORAGE_READ_WRITE", "binding": 3 }
      ],
      "execute": "pass.gpu_draw_encode"
    },
    {
      "name": "VBuffer.Opaque",
      "type": "graphics",
      "domain": "WORLD",
      "condition": "deferred_enabled",
      "reads": [
        { "buffer": "gpu_visible_draws", "access": "STORAGE_READ", "binding": 1 },
        { "buffer": "gpu_draw_compaction_state", "access": "INDIRECT_READ", "binding": 2 }
      ],
      "attachments": {
        "color": [
          {
            "image": "opaque_vbuffer",
            "load": "CLEAR",
            "store": "STORE",
            "clear": { "color": [0, 0, 0, 0] }
          }
        ],
        "depth": {
          "image": "opaque_vbuffer_depth",
          "load": "CLEAR",
          "store": "STORE",
          "clear": { "depth": 1.0, "stencil": 0 }
        }
      },
      "execute": "pass.vbuffer.opaque"
    },
    {
      "name": "GBuffer.Resolve",
      "type": "compute",
      "condition": "deferred_enabled",
      "flags": ["NO_CULL"],
      "reads": [
        { "image": "opaque_vbuffer", "access": "STORAGE_READ", "binding": 0 },
        { "buffer": "gpu_visible_draws", "access": "STORAGE_READ", "binding": 1 }
      ],
      "writes": [
        { "image": "gbuffer_albedo", "access": "STORAGE_WRITE", "binding": 2 },
        { "image": "gbuffer_specular", "access": "STORAGE_WRITE", "binding": 3 },
        { "image": "gbuffer_normal", "access": "STORAGE_WRITE", "binding": 4 },
        { "image": "deferred_emissive_seed", "access": "STORAGE_WRITE", "binding": 5 },
        { "image": "deferred_resolve_debug", "access": "STORAGE_WRITE", "binding": 6 },
        { "buffer": "gpu_draw_compaction_state", "access": "STORAGE_READ_WRITE", "binding": 7 }
      ],
      "execute": "pass.gbuffer.resolve"
    },
    {
      "name": "Skybox.Fullscreen",
      "type": "graphics",
      "domain": "SKYBOX",
      "condition": "!editor_enabled",
      "attachments": {
        "color": [
          {
            "image": "hdr_pre_transmission",
            "load": "CLEAR",
            "store": "STORE",
            "clear": { "color": [0.02, 0.02, 0.03, 1.0] }
          }
        ],
        "depth": {
          "image": "swapchain_depth",
          "load": "CLEAR",
          "store": "STORE",
          "clear": { "depth": 1.0, "stencil": 0 }
        }
      },
      "execute": "pass.skybox"
    },
    {
      "name": "Skybox.Editor",
      "type": "graphics",
      "domain": "SKYBOX",
      "condition": "editor_enabled",
      "attachments": {
        "color": [
          {
            "image": "scene_pre_transmission",
            "load": "CLEAR",
            "store": "STORE",
            "clear": { "color": [0.02, 0.02, 0.03, 1.0] }
          }
        ],
        "depth": {
          "image": "scene_depth",
          "load": "CLEAR",
          "store": "STORE",
          "clear": { "depth": 1.0, "stencil": 0 }
        }
      },
      "execute": "pass.skybox"
    },
    {
      "name": "World.Opaque.Fullscreen",
      "type": "graphics",
      "domain": "WORLD",
      "condition": "!editor_enabled && !deferred_enabled",
      "reads": [
        {
          "image": "shadow_map",
          "access": "SAMPLED",
          "binding": 0
        }
      ],
      "attachments": {
        "color": [
          { "image": "hdr_pre_transmission", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "swapchain_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.opaque"
    },
    {
      "name": "World.Opaque.Editor",
      "type": "graphics",
      "domain": "WORLD",
      "condition": "editor_enabled && !deferred_enabled",
      "reads": [
        {
          "image": "shadow_map",
          "access": "SAMPLED",
          "binding": 0
        }
      ],
      "attachments": {
        "color": [
          { "image": "scene_pre_transmission", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "scene_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.opaque"
    },
    {
      "name": "World.GpuOpaque.Fullscreen",
      "type": "graphics",
      "domain": "WORLD",
      "condition": "!editor_enabled && deferred_enabled",
      "reads": [
        { "image": "shadow_map", "access": "SAMPLED", "binding": 0 },
        { "buffer": "gpu_visible_draws", "access": "STORAGE_READ", "binding": 1 },
        { "buffer": "gpu_draw_compaction_state", "access": "INDIRECT_READ", "binding": 2 }
      ],
      "attachments": {
        "color": [
          { "image": "hdr_pre_transmission", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "swapchain_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.gpu_opaque"
    },
    {
      "name": "World.GpuOpaque.Editor",
      "type": "graphics",
      "domain": "WORLD",
      "condition": "editor_enabled && deferred_enabled",
      "reads": [
        { "image": "shadow_map", "access": "SAMPLED", "binding": 0 },
        { "buffer": "gpu_visible_draws", "access": "STORAGE_READ", "binding": 1 },
        { "buffer": "gpu_draw_compaction_state", "access": "INDIRECT_READ", "binding": 2 }
      ],
      "attachments": {
        "color": [
          { "image": "scene_pre_transmission", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "scene_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.gpu_opaque"
    },
    {
      "name": "World.FeedbackCopy.Fullscreen",
      "type": "transfer",
      "condition": "!editor_enabled",
      "reads": [
        { "image": "hdr_pre_transmission", "access": "TRANSFER_SRC", "binding": 0 }
      ],
      "writes": [
        { "image": "hdr_scene_color", "access": "TRANSFER_DST", "binding": 1 }
      ],
      "execute": "pass.copy.pre_transmission.fullscreen"
    },
    {
      "name": "World.FeedbackCopy.Editor",
      "type": "transfer",
      "condition": "editor_enabled",
      "reads": [
        { "image": "scene_pre_transmission", "access": "TRANSFER_SRC", "binding": 0 }
      ],
      "writes": [
        { "image": "scene_color", "access": "TRANSFER_DST", "binding": 1 }
      ],
      "execute": "pass.copy.pre_transmission.editor"
    },
    {
      "name": "World.Transmission.Fullscreen",
      "type": "graphics",
      "domain": "WORLD_TRANSPARENT",
      "condition": "!editor_enabled",
      "reads": [
        { "image": "shadow_map", "access": "SAMPLED", "binding": 0 },
        { "image": "hdr_pre_transmission", "access": "SAMPLED", "binding": 1 }
      ],
      "attachments": {
        "color": [
          { "image": "hdr_scene_color", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "swapchain_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.transmission"
    },
    {
      "name": "World.Transmission.Editor",
      "type": "graphics",
      "domain": "WORLD_TRANSPARENT",
      "condition": "editor_enabled",
      "reads": [
        { "image": "shadow_map", "access": "SAMPLED", "binding": 0 },
        { "image": "scene_pre_transmission", "access": "SAMPLED", "binding": 1 }
      ],
      "attachments": {
        "color": [
          { "image": "scene_color", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "scene_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.transmission"
    },
    {
      "name": "World.Blend.Fullscreen",
      "type": "graphics",
      "domain": "WORLD_TRANSPARENT",
      "condition": "!editor_enabled",
      "reads": [
        { "image": "shadow_map", "access": "SAMPLED", "binding": 0 }
      ],
      "attachments": {
        "color": [
          { "image": "hdr_scene_color", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "swapchain_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.blend"
    },
    {
      "name": "World.Blend.Editor",
      "type": "graphics",
      "domain": "WORLD_TRANSPARENT",
      "condition": "editor_enabled",
      "reads": [
        { "image": "shadow_map", "access": "SAMPLED", "binding": 0 }
      ],
      "attachments": {
        "color": [
          { "image": "scene_color", "load": "LOAD", "store": "STORE" }
        ],
        "depth": {
          "image": "scene_depth",
          "load": "LOAD",
          "store": "STORE"
        }
      },
      "execute": "pass.world.blend"
    },
    {
      "name": "Post.Tonemap.Fullscreen",
      "type": "graphics",
      "domain": "POST",
      "condition": "!editor_enabled",
      "reads": [
        {
          "image": "hdr_scene_color",
          "access": "SAMPLED",
          "binding": 0,
          "array_index": 0
        }
      ],
      "attachments": {
        "color": [
          {
            "image": "swapchain",
            "load": "CLEAR",
            "store": "STORE",
            "clear": { "color": [0, 0, 0, 1] }
          }
        ]
      },
      "execute": "pass.tonemap"
    },
    {
      "name": "Editor.Composite",
      "type": "graphics",
      "domain": "UI",
      "condition": "editor_enabled",
      "reads": [
        {
          "image": "scene_color",
          "access": "SAMPLED",
          "binding": 0,
          "array_index": 0
        }
      ],
      "attachments": {
        "color": [
          {
            "image": "swapchain",
            "load": "CLEAR",
            "store": "STORE",
            "clear": { "color": [0, 0, 0, 1] }
          }
        ]
      },
      "execute": "pass.editor"
    },
    {
      "name": "UI.Fullscreen",
      "type": "graphics",
      "domain": "UI",
      "condition": "!editor_enabled",
      "attachments": {
        "color": [
          { "image": "swapchain", "load": "LOAD", "store": "STORE" }
        ]
      },
      "execute": "pass.ui"
    },
    {
      "name": "UI.Editor",
      "type": "graphics",
      "domain": "UI",
      "condition": "editor_enabled",
      "attachments": {
        "color": [
          { "image": "swapchain", "load": "LOAD", "store": "STORE" }
        ]
      },
      "execute": "pass.ui"
    }
  ],
  "outputs": {
    "present": "swapchain"
  }
}
