#ifndef VKR_SHADER_INSTANCE_SLANGH
#define VKR_SHADER_INSTANCE_SLANGH

// Matches the CPU instance buffer layout; keep in sync with renderer instance data.
struct InstanceData
{
    column_major float4x4 model;
    uint object_id;
    // Three scalars preserve the CPU ABI at offsets 68/72/76 and an 80-byte
    // stride. A uint3 is 16-byte aligned in std430 and would inflate this
    // StructuredBuffer element to 96 bytes.
    uint reserved_0;
    uint reserved_1;
    uint reserved_2;
};

#endif
