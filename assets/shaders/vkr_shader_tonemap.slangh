#ifndef VKR_SHADER_TONEMAP_SLANGH
#define VKR_SHADER_TONEMAP_SLANGH

float3 vkr_aces_fitted(float3 color) {
  const float a = 2.51f;
  const float b = 0.03f;
  const float c = 2.43f;
  const float d = 0.59f;
  const float e = 0.14f;
  return saturate((color * (a * color + b)) /
                  (color * (c * color + d) + e));
}

#endif
