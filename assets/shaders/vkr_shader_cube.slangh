#ifndef VKR_SHADER_CUBE_SLANGH
#define VKR_SHADER_CUBE_SLANGH

// Vulkan cubemap layer order and face-coordinate convention. face_uv uses
// image coordinates: (0,0) is the top-left texel of the destination layer.
float3 vkr_cube_face_uv_to_direction(uint face, float2 face_uv)
{
    float2 st = face_uv * 2.0f - 1.0f;
    switch (face)
    {
    case 0u: return float3( 1.0f, -st.y, -st.x); // +X
    case 1u: return float3(-1.0f, -st.y,  st.x); // -X
    case 2u: return float3( st.x,  1.0f,  st.y); // +Y
    case 3u: return float3( st.x, -1.0f, -st.y); // -Y
    case 4u: return float3( st.x, -st.y,  1.0f); // +Z
    case 5u: return float3(-st.x, -st.y, -1.0f); // -Z
    default: return float3(0.0f, 0.0f, 0.0f);
    }
}

#endif
