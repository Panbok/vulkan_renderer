{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vkr.local/schemas/harness-report-v1.schema.json",
  "title": "Vulkan Renderer Harness Report",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "tool",
    "tool_version",
    "run_id",
    "status",
    "exit_code",
    "authoritative",
    "authority_reasons",
    "case",
    "profile",
    "provenance",
    "comparison",
    "effective_config",
    "execution",
    "runs",
    "auxiliary_runs",
    "aggregate",
    "events",
    "captures",
    "assertions",
    "diagnostics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "vkr.harness.report"
    },
    "tool": {
      "enum": [
        "profile",
        "snapshot",
        "autotest",
        "compare"
      ]
    },
    "tool_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "invalid",
        "unavailable",
        "missing_baseline",
        "error",
        "cancelled",
        "incomplete"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "authoritative": {
      "type": "boolean"
    },
    "authority_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "case": {
      "$ref": "#/definitions/case_identity"
    },
    "profile": {
      "$ref": "#/definitions/profile_identity"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "comparison": {
      "type": "object",
      "required": [
        "environment_fingerprint",
        "workload_fingerprint",
        "policy_fingerprint"
      ],
      "properties": {
        "environment_fingerprint": {
          "$ref": "#/definitions/digest"
        },
        "workload_fingerprint": {
          "$ref": "#/definitions/digest"
        },
        "policy_fingerprint": {
          "$ref": "#/definitions/digest"
        }
      },
      "additionalProperties": false
    },
    "effective_config": {
      "$ref": "#/definitions/effective_config"
    },
    "execution": {
      "$ref": "#/definitions/execution"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/run"
      }
    },
    "auxiliary_runs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/run"
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "metrics",
        "passes"
      ],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/statistics"
          }
        },
        "passes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pass"
          }
        }
      },
      "additionalProperties": false
    },
    "events": {
      "$ref": "#/definitions/events"
    },
    "captures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/capture"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/assertion"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "authoritative": {
            "const": true
          }
        },
        "required": [
          "authoritative"
        ]
      },
      "then": {
        "properties": {
          "authority_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "authority_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest_or_empty": {
      "description": "A digest, or the empty string when the artifact it would cover was never produced.",
      "oneOf": [
        {
          "$ref": "#/definitions/digest"
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ]
    },
    "safe_path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "case_identity": {
      "type": "object",
      "required": [
        "id",
        "suite",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/definitions/digest"
        }
      },
      "additionalProperties": false
    },
    "profile_identity": {
      "type": "object",
      "required": [
        "id",
        "manifest_sha256",
        "compatible",
        "incompatibility_reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/definitions/digest"
        },
        "compatible": {
          "type": "boolean"
        },
        "incompatibility_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "started_at",
        "ended_at",
        "git_sha",
        "dirty",
        "binary_sha256",
        "build_type",
        "compiler",
        "os",
        "cpu",
        "gpu",
        "gpu_vendor_id",
        "gpu_device_id",
        "driver",
        "power_mode",
        "thermal_state_start",
        "thermal_state_end",
        "process_priority"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "ended_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "git_sha": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "binary_sha256": {
          "$ref": "#/definitions/digest_or_empty"
        },
        "build_type": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "gpu_vendor_id": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_device_id": {
          "type": "integer",
          "minimum": 0
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "power_mode": {
          "type": "string",
          "minLength": 1
        },
        "thermal_state_start": {
          "type": "string",
          "minLength": 1
        },
        "thermal_state_end": {
          "type": "string",
          "minLength": 1
        },
        "process_priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "effective_config": {
      "type": "object",
      "required": [
        "resolution",
        "scene",
        "target",
        "target_image_count",
        "color_format",
        "depth_format",
        "color_space",
        "present_mode",
        "boot_profile",
        "subsystem_mask",
        "editor",
        "text_fixture",
        "renderer_backend",
        "cascades",
        "cache",
        "camera_script_version",
        "gpu_timing",
        "metrics_compile_enabled",
        "events_enabled"
      ],
      "properties": {
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "scene": {
          "$ref": "#/definitions/safe_path"
        },
        "target": {
          "enum": [
            "windowed_visible",
            "windowed_hidden",
            "offscreen"
          ]
        },
        "target_image_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Actual image count of the selected target; 0 when no repetition reported one."
        },
        "color_format": {
          "type": "string",
          "minLength": 1,
          "description": "Actual target color format, or unknown when no repetition opened a target."
        },
        "depth_format": {
          "type": "string",
          "minLength": 1,
          "description": "Actual target depth format, or unknown when no repetition opened a target."
        },
        "color_space": {
          "type": "string",
          "minLength": 1,
          "description": "Actual WSI color space; unknown for an ordinary-image offscreen target."
        },
        "present_mode": {
          "enum": [
            "immediate",
            "fifo",
            "mailbox",
            "none",
            "unknown"
          ]
        },
        "boot_profile": {
          "enum": [
            "full",
            "automation"
          ]
        },
        "subsystem_mask": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        },
        "editor": {
          "type": "boolean"
        },
        "text_fixture": {
          "type": "boolean"
        },
        "renderer_backend": {
          "enum": ["external", "vulkan", "metal"]
        },
        "cascades": {
          "type": "integer",
          "minimum": 1
        },
        "cache": {
          "enum": [
            "isolated_cold",
            "isolated_warm",
            "shared"
          ]
        },
        "camera_script_version": {
          "const": 1
        },
        "gpu_timing": {
          "type": "boolean"
        },
        "metrics_compile_enabled": {
          "type": "boolean"
        },
        "events_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "requested_repetitions",
        "completed_repetitions",
        "warmup_frames",
        "measured_frames",
        "warmup_stability_metric",
        "warmup_stable",
        "gpu_lane_lock_acquired"
      ],
      "properties": {
        "requested_repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "completed_repetitions": {
          "type": "integer",
          "minimum": 0
        },
        "warmup_frames": {
          "type": "integer",
          "minimum": 0
        },
        "measured_frames": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_stability_metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "warmup_stable": {
          "type": "boolean"
        },
        "gpu_lane_lock_acquired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "index",
        "status",
        "report",
        "sha256",
        "environment_fingerprint",
        "workload_fingerprint",
        "policy_fingerprint"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "$ref": "#/definitions/safe_path"
        },
        "sha256": {
          "$ref": "#/definitions/digest_or_empty"
        },
        "environment_fingerprint": {
          "$ref": "#/definitions/digest_or_empty"
        },
        "workload_fingerprint": {
          "$ref": "#/definitions/digest_or_empty"
        },
        "policy_fingerprint": {
          "$ref": "#/definitions/digest_or_empty"
        }
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "required": [
        "unit",
        "sample_count",
        "invalid_count",
        "mean",
        "p50",
        "p95",
        "min",
        "max",
        "stddev",
        "total"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "stddev": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": [
        "checkpoint_frame",
        "capture_version",
        "channel",
        "producer_resource",
        "source_format",
        "canonical_encoding",
        "value_kind",
        "color_space",
        "origin",
        "width",
        "height",
        "source_row_pitch",
        "mip",
        "layer",
        "source_frame_index",
        "submit_serial",
        "data_path",
        "data_sha256",
        "preview_path",
        "preview_sha256",
        "metadata_path",
        "metadata_sha256",
        "comparison_status",
        "baseline_data_path",
        "baseline_data_sha256",
        "diff_path",
        "diff_sha256",
        "thresholds",
        "comparison"
      ],
      "properties": {
        "checkpoint_frame": {
          "type": "integer",
          "minimum": 0
        },
        "capture_version": {
          "type": "integer",
          "minimum": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "producer_resource": {
          "type": "string",
          "minLength": 1
        },
        "source_format": {
          "type": "string",
          "minLength": 1
        },
        "canonical_encoding": {
          "type": "string",
          "minLength": 1
        },
        "value_kind": {
          "enum": [
            "color",
            "depth",
            "uint"
          ]
        },
        "color_space": {
          "enum": [
            "srgb",
            "none"
          ]
        },
        "origin": {
          "const": "top_left"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "source_row_pitch": {
          "type": "integer",
          "minimum": 1
        },
        "mip": {
          "type": "integer",
          "minimum": 0
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "source_frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "submit_serial": {
          "type": "integer",
          "minimum": 0
        },
        "data_path": {
          "$ref": "#/definitions/safe_path"
        },
        "data_sha256": {
          "$ref": "#/definitions/digest"
        },
        "preview_path": {
          "$ref": "#/definitions/safe_path"
        },
        "preview_sha256": {
          "$ref": "#/definitions/digest"
        },
        "metadata_path": {
          "$ref": "#/definitions/safe_path"
        },
        "metadata_sha256": {
          "$ref": "#/definitions/digest"
        },
        "comparison_status": {
          "enum": ["not_run", "pass", "fail", "incompatible"]
        },
        "baseline_data_path": {
          "oneOf": [
            { "$ref": "#/definitions/safe_path" },
            { "type": "string", "maxLength": 0 }
          ]
        },
        "baseline_data_sha256": {
          "$ref": "#/definitions/digest_or_empty"
        },
        "diff_path": {
          "oneOf": [
            { "$ref": "#/definitions/safe_path" },
            { "type": "string", "maxLength": 0 }
          ]
        },
        "diff_sha256": {
          "$ref": "#/definitions/digest_or_empty"
        },
        "thresholds": {
          "$ref": "#/definitions/comparison_thresholds"
        },
        "comparison": {
          "$ref": "#/definitions/comparison_result"
        }
      },
      "additionalProperties": false
    },
    "comparison_thresholds": {
      "type": "object",
      "required": [
        "max_pixel_delta",
        "max_mean_absolute_error",
        "max_failed_pixel_ratio",
        "emit_diff"
      ],
      "properties": {
        "max_pixel_delta": { "type": "number", "minimum": 0 },
        "max_mean_absolute_error": { "type": "number", "minimum": 0 },
        "max_failed_pixel_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emit_diff": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "comparison_result": {
      "type": "object",
      "required": [
        "mean_absolute_error",
        "max_absolute_error",
        "failing_value_count",
        "failing_pixel_count",
        "value_count",
        "pixel_count",
        "failed_pixel_ratio"
      ],
      "properties": {
        "mean_absolute_error": { "type": "number", "minimum": 0 },
        "max_absolute_error": { "type": "number", "minimum": 0 },
        "failing_value_count": { "type": "integer", "minimum": 0 },
        "failing_pixel_count": { "type": "integer", "minimum": 0 },
        "value_count": { "type": "integer", "minimum": 0 },
        "pixel_count": { "type": "integer", "minimum": 0 },
        "failed_pixel_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "required": [
        "name",
        "cpu_ms",
        "gpu_ms",
        "culled_count",
        "disabled_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cpu_ms": {
          "$ref": "#/definitions/statistics"
        },
        "gpu_ms": {
          "$ref": "#/definitions/statistics"
        },
        "culled_count": {
          "type": "integer",
          "minimum": 0
        },
        "disabled_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "required": [
        "items",
        "dropped",
        "subjects_truncated"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/event"
          }
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        },
        "subjects_truncated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "source",
        "subject",
        "start_ns",
        "duration_ns",
        "bytes",
        "thread_id",
        "repetition",
        "status",
        "subject_truncated"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string"
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "thread_id": {
          "type": "integer",
          "minimum": 0
        },
        "repetition": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "subject_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": [
        "metric",
        "stat",
        "operator",
        "status",
        "actual",
        "limit"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "stat": {
          "enum": [
            "mean",
            "p50",
            "p95",
            "min",
            "max",
            "stddev",
            "total"
          ]
        },
        "operator": {
          "enum": [
            "max",
            "min",
            "equals"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "incomplete"
          ]
        },
        "actual": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "role",
        "path",
        "media_type",
        "sha256",
        "status"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/definitions/safe_path"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/digest"
        },
        "status": {
          "const": "complete"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
