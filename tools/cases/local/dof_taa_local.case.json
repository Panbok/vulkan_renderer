{
  "schema_version": 1,
  "id": "local.dof.taa",
  "suite": "local",
  "description": "Depth-of-field output with temporal reconstruction and camera jitter enabled.",
  "scene": "assets/scenes/fixtures/dof_focus_local.scene.json",
  "seed": 1,
  "resolution": [512, 384],
  "boot": "full",
  "target": "offscreen",
  "present": "none",
  "target_image_count": 3,
  "cache": "isolated_cold",
  "fixed_delta": 0.016666667,
  "repetitions": 1,
  "repetition_timeout_ms": 120000,
  "asset_ready_timeout_ms": 60000,
  "frames": {"warmup": 8, "measure": 2},
  "renderer": {
    "editor": false,
    "skybox": false,
    "taa_enabled": true,
    "exposure_mode": "manual",
    "manual_exposure": 1,
    "shadow_preset": "balanced",
    "shadow_cascades": 3,
    "render_mode": "default",
    "display_transform": "aces_fitted",
    "gtao_enabled": false,
    "ssr_enabled": false,
    "ssgi_enabled": false,
    "bloom_enabled": false,
    "image_sharpness": 0,
    "dof_enabled": true,
    "dof_focus_distance": 0.5,
    "dof_f_stop": 1.0
  },
  "camera": {
    "mode": "static",
    "position": [0, 1.5, 1.2],
    "yaw": -90,
    "pitch": 0,
    "vertical_fov_degrees": 45,
    "near_plane": 0.05,
    "far_plane": 10
  },
  "captures": [
    {"at_frame": 0, "channels": ["dof_color", "dof_coc"]},
    {"at_frame": 1, "channels": ["dof_color", "dof_coc"]}
  ],
  "assertions": [
    {"metric": "visibility.gbuffer.resolve_invalid", "stat": "max", "max": 0}
  ]
}
