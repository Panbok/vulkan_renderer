{
  "schema_version": 1,
  "id": "local.p2.candidate_residency_validation",
  "suite": "local",
  "description": "Focused Vulkan synchronization-validation witness for per-slot static residency and per-frame dynamic candidate copies.",
  "scene": "assets/scenes/fixtures/candidate_residency.scene.json",
  "seed": 2,
  "resolution": [320, 240],
  "boot": "full",
  "target": "windowed_hidden",
  "present": "fifo",
  "cache": "isolated_warm",
  "fixed_delta": 0.016666667,
  "repetitions": 2,
  "repetition_timeout_ms": 180000,
  "asset_ready_timeout_ms": 60000,
  "frames": { "warmup": 256, "measure": 8 },
  "renderer": {
    "editor": false,
    "skybox": false,
    "backend": "vulkan",
    "shadow_preset": "balanced",
    "shadow_cascades": 4,
    "render_mode": "default"
  },
  "camera": {
    "mode": "static",
    "position": [0, 1.2, 4.0],
    "yaw": -90,
    "pitch": 0,
    "vertical_fov_degrees": 58,
    "near_plane": 0.1,
    "far_plane": 100
  },
  "assertions": [
    { "metric": "visibility.gpu_candidates.static_count", "stat": "min", "min": 1 },
    { "metric": "packet.static_candidate_row_bytes", "stat": "max", "max": 0 },
    { "metric": "packet.dynamic_candidate_row_bytes", "stat": "min", "min": 48 },
    { "metric": "packet.publication_omitted_candidates", "stat": "max", "max": 0 },
    { "metric": "visibility.gpu_visible.overflow", "stat": "max", "max": 0 },
    { "metric": "visibility.gbuffer.resolve_invalid", "stat": "max", "max": 0 }
  ]
}
