    "bloom_enabled": false,
    "gtao_enabled": false,
    "shadow_preset": "default",
    "shadow_cascades": 4,
    "render_mode": "default"
  },
  "camera": {
    "mode": "static",
    "position": [
      -5.19214678,
      2.89391732,
      11.0450354
    ],
    "yaw": 364.375854,
    "pitch": -12.6190548,
    "vertical_fov_degrees": 70,
    "near_plane": 0.100000001,
    "far_plane": 500
  },
  "assertions": [
    {
      "metric": "lighting.point.selected",
      "stat": "min",
      "min": 72
    },
    {
      "metric": "visibility.gbuffer.resolve_invalid",
