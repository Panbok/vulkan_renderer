{
  "schema_version": 1,
  "id": "local.bistro.local_shadow_cache.metal_validation",
  "suite": "local",
  "description": "Single-process Metal API-validation witness for the shared local-shadow cache: Bistro's indoor camera through the cache fill, where every frame redraws faces of the atlas earlier frames in flight sample, then reuse.",
