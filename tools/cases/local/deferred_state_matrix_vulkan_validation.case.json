{
  "schema_version": 1,
  "id": "local.deferred.state_matrix.vulkan_validation",
  "suite": "local",
  "description": "Focused Windows Vulkan validation replay of deferred visibility, temporal history, and four-layer compact transmission.",
  "scene": "assets/scenes/fixtures/deferred_state_matrix.scene.json",
  "seed": 20,
  "resolution": [320, 240],
  "boot": "full",
  "target": "windowed_hidden",
  "present": "fifo",
  "cache": "isolated_cold",
  "fixed_delta": 0.016666667,
  "repetitions": 2,
  "repetition_timeout_ms": 300000,
  "asset_ready_timeout_ms": 60000,
  "frames": { "warmup": 256, "measure": 8 },
  "renderer": {
    "editor": false,
    "skybox": false,
    "taa_enabled": true,
    "backend": "vulkan",
    "exposure_mode": "manual",
    "manual_exposure": 0.3,
    "shadow_preset": "balanced",
    "shadow_cascades": 4,
    "render_mode": "default"
  },
  "camera": {
    "mode": "static",
    "position": [0, 1.4, 6.0],
    "yaw": -90,
    "pitch": 0,
    "vertical_fov_degrees": 58,
    "near_plane": 0.1,
    "far_plane": 100
  },
  "assertions": [
    { "metric": "visibility.gpu_visible.bucket.opaque_single", "stat": "min", "min": 1 },
    { "metric": "visibility.gpu_visible.bucket.opaque_double", "stat": "min", "min": 1 },
    { "metric": "visibility.gpu_visible.bucket.cutout_single", "stat": "min", "min": 1 },
    { "metric": "visibility.gpu_visible.bucket.cutout_double", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.gpu_visible.bucket.opaque_single", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.gpu_visible.bucket.opaque_double", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.gpu_visible.bucket.cutout_single", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.gpu_visible.bucket.cutout_double", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.covered_pixels.layer_0", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.covered_pixels.layer_1", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.covered_pixels.layer_2", "stat": "min", "min": 1 },
    { "metric": "visibility.transmission.covered_pixels.layer_3", "stat": "min", "min": 1 },
    { "metric": "visibility.gpu_visible.overflow", "stat": "max", "max": 0 },
    { "metric": "visibility.transmission.gpu_visible.overflow", "stat": "max", "max": 0 },
    { "metric": "visibility.transmission.compact_pixels.overflow", "stat": "max", "max": 0 },
    { "metric": "visibility.gbuffer.resolve_invalid", "stat": "max", "max": 0 },
    { "metric": "geometry.megabuffer.rejected_publications_total", "stat": "max", "max": 0 }
  ]
}
