{
  "schema_version": 1,
  "id": "local.recording.overhead_bistro_cpu",
  "suite": "local",
  "description": "Bistro orbit with little GPU work (640x360, half render scale, two balanced cascades) so the frame-loop thread bounds the frame: the recording overhead gate on a CPU-bound workload (ADR-122).",
  "scene": "assets/scenes/bistro.scene.json",
  "seed": 1,
  "resolution": [
    640,
    360
  ],
  "boot": "full",
  "target": "windowed_hidden",
  "present": "immediate",
  "cache": "isolated_warm",
  "fixed_delta": 0.016666667,
  "repetitions": 1,
  "repetition_timeout_ms": 1200000,
  "asset_ready_timeout_ms": 900000,
  "frames": {
    "warmup": 120,
    "measure": 300
  },
  "renderer": {
    "editor": false,
    "skybox": true,
    "shadow_preset": "balanced",
    "shadow_cascades": 2,
    "render_mode": "default",
    "render_scale": 0.5
  },
  "camera": {
    "mode": "orbit",
    "speed": "medium",
    "center": [
      -20,
      6,
      6
    ],
    "radius": 18,
    "height": 7,
    "revolutions": 1.4,
    "duration_seconds": 7,
    "start_angle_degrees": 0,
    "vertical_fov_degrees": 70,
    "near_plane": 0.1,
    "far_plane": 500
  },
  "assertions": [
    {
      "metric": "draw.world.calls_issued",
      "stat": "min",
      "min": 1
    },
    {
      "metric": "draw.shadow.cascade0.indirect_commands",
      "stat": "min",
      "min": 1
    }
  ]
}
