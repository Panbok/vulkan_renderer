{
  "schema_version": 1,
  "id": "local.win.bistro.cafe.gtao.on",
  "suite": "local",
  "description": "Windows Vulkan Bistro cafe interior at the indoor owner camera with the indoor capture case renderer settings (automatic exposure, bloom, GTAO, no TAA); captures the AO chain and final color for spatial GTAO evidence.",
