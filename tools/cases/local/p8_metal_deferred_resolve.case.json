{
  "schema_version": 1,
  "id": "local.p8.metal.deferred_resolve",
  "suite": "local",
  "description": "Focused Metal visibility-buffer and material-resolve witness.",
  "scene": "assets/scenes/sponza.scene.json",
  "seed": 1,
  "resolution": [640, 480],
  "boot": "full",
  "target": "offscreen",
  "present": "none",
  "target_image_count": 3,
  "cache": "isolated_cold",
  "fixed_delta": 0.016666667,
  "repetitions": 1,
  "repetition_timeout_ms": 120000,
  "asset_ready_timeout_ms": 60000,
  "frames": { "warmup": 2, "measure": 3 },
  "renderer": {
    "editor": false,
    "skybox": true,
    "backend": "metal",
    "shadow_preset": "balanced",
    "shadow_cascades": 4,
    "render_mode": "default"
  },
  "camera": {
    "mode": "static",
    "position": [-1.5, 0, 17],
    "yaw": -90,
    "pitch": 0,
    "vertical_fov_degrees": 70,
    "near_plane": 0.1,
    "far_plane": 500
  },
  "captures": [
    {
      "at_frame": 1,
      "channels": [
        "final_color",
        "visibility_ids",
        "visibility_primitives",
        "gbuffer_diffuse",
        "gbuffer_specular",
        "gbuffer_normal",
        "deferred_emissive",
        "resolve_barycentric_lod"
      ]
    }
  ],
  "assertions": [
    { "metric": "visibility.gpu_candidates.count", "stat": "min", "min": 1 },
    { "metric": "visibility.gpu_candidates.overflow_fallbacks", "stat": "max", "max": 0 }
  ]
}
