{
  "schema_version": 1,
  "id": "local.win.bistro.gtao.on",
  "suite": "local",
  "description": "Windows Vulkan Bistro plaza view with production exposure, bloom and GTAO enabled; captures the AO chain and final color for cross-backend comparison.",
  "scene": "assets/scenes/bistro.scene.json",
  "seed": 20,
  "resolution": [800, 600],
  "boot": "full",
  "target": "offscreen",
  "present": "none",
  "target_image_count": 3,
  "cache": "isolated_warm",
  "fixed_delta": 0.016666667,
  "repetitions": 1,
  "repetition_timeout_ms": 900000,
  "asset_ready_timeout_ms": 600000,
  "frames": { "warmup": 120, "measure": 60 },
  "renderer": {
    "editor": false,
    "skybox": true,
    "text_fixture": false,
    "backend": "vulkan",
    "taa_enabled": false,
    "shadow_preset": "balanced",
    "shadow_cascades": 4,
    "render_mode": "default",
    "exposure_mode": "manual",
    "manual_exposure": 0.3,
    "exposure_compensation_ev": 0.0,
    "bloom_enabled": false,
    "gtao_enabled": true,
    "gtao_radius": 0.5,
    "gtao_power": 2.2
  },
  "camera": {
    "mode": "static",
    "position": [10.0205421, 4.17517662, 27.8467007],
    "yaw": 19.2320728,
    "pitch": -3.26702642,
    "vertical_fov_degrees": 70,
    "near_plane": 0.100000001,
    "far_plane": 500
  },
  "captures": [
    { "at_frame": 40, "channels": ["gtao_view_depth", "gbuffer_normal", "gtao_raw", "gtao_visibility", "final_color"] }
  ],
  "assertions": [
    { "metric": "draw.world.opaque_draws", "stat": "min", "min": 1 },
    { "metric": "packet.publication_omitted_candidates", "stat": "max", "max": 0 }
  ]
}
