{
  "schema_version": 1,
  "id": "smoke.bloom.static",
  "suite": "smoke",
  "description": "Odd-extent fixed-step bloom fixture with explicit scene-linear controls, temporal passthrough, manual exposure, and independent prefilter, resolved bloom, pre-bloom HDR, combined HDR, and final-color captures.",
  "scene": "assets/scenes/fixtures/local_ibl_broad_mesh.scene.json",
  "seed": 11,
  "resolution": [801, 601],
  "boot": "full",
