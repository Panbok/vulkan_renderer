    "yaw": -90,
    "pitch": 0,
    "vertical_fov_degrees": 55,
    "near_plane": 0.1,
    "far_plane": 100
  },
  "captures": [
    {
      "at_frame": 12,
      "channels": [
        "hdr_pre_bloom",
        "bloom_prefilter",
        "bloom_result",
        "hdr_combined",
