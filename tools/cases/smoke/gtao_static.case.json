{
  "schema_version": 1,
  "id": "smoke.gtao.static",
  "suite": "smoke",
  "description": "Odd-extent fixed-step GTAO fixture with explicit radius and power, temporal passthrough, manual exposure, bloom disabled, and direct view-depth, normal, raw AO, visibility, and final-color captures.",
  "scene": "assets/scenes/fixtures/local_ibl_broad_mesh.scene.json",
  "seed": 11,
  "resolution": [801, 601],
  "boot": "full",
  "target": "offscreen",
  "present": "none",
  "target_image_count": 3,
  "cache": "isolated_cold",
  "fixed_delta": 0.016666667,
  "repetitions": 1,
  "repetition_timeout_ms": 120000,
  "asset_ready_timeout_ms": 60000,
  "frames": { "warmup": 24, "measure": 16 },
  "renderer": {
    "editor": false,
    "skybox": true,
    "taa_enabled": false,
    "shadow_preset": "balanced",
    "shadow_cascades": 3,
    "render_mode": "default",
    "exposure_mode": "manual",
    "manual_exposure": 0.3,
    "exposure_compensation_ev": 0.0,
    "bloom_enabled": false,
    "gtao_enabled": true,
    "gtao_radius": 0.5,
    "gtao_power": 2.2
  },
  "camera": {
    "mode": "static",
    "position": [0, 1.2, 6.0],
    "yaw": -90,
    "pitch": 0,
    "vertical_fov_degrees": 55,
    "near_plane": 0.1,
    "far_plane": 100
  },
  "captures": [
    {
      "at_frame": 12,
      "channels": [
        "gtao_view_depth",
        "gbuffer_normal",
        "gtao_raw",
        "gtao_visibility",
        "final_color"
      ]
    }
  ],
  "assertions": [
    { "metric": "draw.world.opaque_draws", "stat": "min", "min": 1 },
    { "metric": "packet.publication_omitted_candidates", "stat": "max", "max": 0 }
  ]
}
