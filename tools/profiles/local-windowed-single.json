{
  "schema_version": 1,
  "id": "local.windowed.single_observation",
  "description": "Non-authoritative single-process timestamp-off observation for a host-safety-bounded Metal run.",
  "authoritative": false,
  "dirty_policy": "allow",
  "environment": {
    "target": "windowed_hidden",
    "required_present": "immediate",
    "require_actual_present": true
  },
  "instrumentation": {
    "gpu_timing": false,
    "event_subjects": false
  },
  "execution": {
    "minimum_repetitions": 1,
    "warmup_stability_window": 4,
    "warmup_max_drift_ratio": 1.0,
    "require_warmup_stability": false,
    "exclusive_gpu_lane": false
  },
  "required_metrics": [
    "frame.wall",
    "cpu.render_prepare",
    "cpu.render_submit",
    "draw.world.calls_issued"
  ]
}
