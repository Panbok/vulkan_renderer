{
  "schema_version": 1,
  "id": "local.windowed.boot",
  "description": "Non-authoritative local boot-time, residency, and work-volume evidence.",
  "authoritative": false,
  "dirty_policy": "allow",
  "environment": {
    "target": "windowed_hidden",
    "required_present": "immediate",
    "require_actual_present": true
  },
  "instrumentation": {
    "gpu_timing": false,
    "event_subjects": false
  },
  "execution": {
    "minimum_repetitions": 5,
    "warmup_stability_window": 20,
    "warmup_max_drift_ratio": 0.15,
    "require_warmup_stability": false,
    "exclusive_gpu_lane": false
  },
  "required_metrics": [
    "boot.instance",
    "boot.device",
    "boot.target",
    "boot.systems",
    "boot.graph",
    "boot.scene",
    "memory.cpu.bytes.live",
    "memory.gpu.bytes.live",
    "memory.gpu.live_totals_exact",
    "draw.world.calls_issued",
    "visibility.objects_tested"
  ]
}
