{
  "schema_version": 1,
  "id": "local.renderer_api.windowed_validation_serial",
  "description": "One serial native resize and teardown check.",
  "authoritative": false,
  "dirty_policy": "allow",
  "environment": {
    "target": "windowed_hidden",
    "required_present": "fifo",
    "require_actual_present": true
  },
  "instrumentation": {
    "gpu_timing": false,
    "event_subjects": false
  },
  "execution": {
    "minimum_repetitions": 1,
    "warmup_stability_window": 20,
    "warmup_max_drift_ratio": 0.15,
    "require_warmup_stability": false,
    "exclusive_gpu_lane": true
  },
  "required_metrics": [
    "cpu.render_submit"
  ]
}
